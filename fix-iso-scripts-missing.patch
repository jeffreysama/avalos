diff --git a/.github/workflows/build-iso.yml b/.github/workflows/build-iso.yml
index d5a9978..a9152f6 100644
--- a/.github/workflows/build-iso.yml
+++ b/.github/workflows/build-iso.yml
@@ -143,6 +143,28 @@ jobs:
           mkdir -p "$AIROOTFS/usr/share/avalos/configs"
           cp -r configs/. "$AIROOTFS/usr/share/avalos/configs/"
 
+          # BUG FIX: skill_instalar_usb.py (_leer_config) busca avalos-settings,
+          # avalos-wallpaper y avalos-about en usr/share/avalos/configs/scripts/,
+          # pero ese directorio nunca se poblaba — "cp -r configs/." de arriba
+          # solo trae configs/, y scripts/ vive en la raíz del repo, aparte.
+          # Sin este paso, el instalador loguea "script missing" para los 3 y
+          # ninguno queda en /usr/local/bin del sistema instalado.
+          mkdir -p "$AIROOTFS/usr/share/avalos/configs/scripts"
+          for _s in avalos-settings avalos-wallpaper avalos-about; do
+            if [[ -f "scripts/$_s" ]]; then
+              cp "scripts/$_s" "$AIROOTFS/usr/share/avalos/configs/scripts/$_s"
+            else
+              echo "::warning::scripts/$_s no encontrado en el repo — no se incluirá en el ISO"
+            fi
+          done
+          # Mismo problema: avalos-settings.desktop vive en configs/ (ya copiado
+          # arriba a usr/share/avalos/configs/avalos-settings.desktop), pero
+          # _leer_config("scripts/avalos-settings.desktop") lo busca dentro de
+          # scripts/ — se deja también ahí para que lo encuentre.
+          if [[ -f "configs/avalos-settings.desktop" ]]; then
+            cp "configs/avalos-settings.desktop" "$AIROOTFS/usr/share/avalos/configs/scripts/avalos-settings.desktop"
+          fi
+
           printf '%s' "" | base64 -d > /tmp/pycfgpyeof.py
           python3 /tmp/pycfgpyeof.py "$AIROOTFS"
 
