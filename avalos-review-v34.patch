+        "t-doctor": "システムの健康状態", "d-doctor": "ディスク、起動、ドライバー、ネットワークの詳細レポート。",
+        "t-about": "このシステムについて", "d-about": "バージョン、カーネル、ハードウェア情報。",
+        "t-store": "ストア", "d-store": "pacman、Flatpak、AUR のアプリ、ゲーム、ユーティリティ。",
+        "t-wallpaper": "壁紙", "d-wallpaper": "デスクトップの画像を選びます。",
+        "t-appearance": "テーマとフォント", "d-appearance": "GTK テーマ、アイコン、カーソル、フォント。",
+        "t-displays": "ディスプレイ", "d-displays": "解像度、リフレッシュレート、レイアウト。",
+        "t-audio": "サウンド", "d-audio": "音量とオーディオデバイス。",
+        "t-network": "ネットワーク", "d-network": "接続、Wi-Fi、VPN。",
+        "t-bluetooth": "Bluetooth", "d-bluetooth": "ワイヤレスデバイス。",
+        "t-files": "ファイル", "d-files": "フォルダーとドライブを表示します。",
+        "t-account": "パスワード", "d-account": "ターミナルでアカウントのパスワードを変更します。",
+        "t-welcome": "ようこそ", "d-welcome": "はじめにとショートカット。",
+        "open": "開く",
+        "unavailable": "このシステムにはまだインストールされていません。",
+        "b-close": "閉じる",
+        "note": "ショートカット: Super + Alt + C",
+    },
+}
+
+
+# ── Resumen del equipo (solo lectura, sin subprocesos) ─────────────────────
+NA = "—"
+
+
+def _read(path: Path) -> str:
+    try:
+        return path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return ""
+
+
+def _gib(kib: float) -> float:
+    return kib / (1024 * 1024)
+
+
+def _os_name() -> str:
+    for line in _read(OS_RELEASE).splitlines():
+        key, _, value = line.partition("=")
+        if key == "PRETTY_NAME":
+            return value.strip().strip('"\'') or "AvalOS"
+    return "AvalOS"
+
+
+def _cpu_model() -> str:
+    for line in _read(PROC / "cpuinfo").splitlines():
+        key, _, value = line.partition(":")
+        if key.strip() == "model name":
+            return " ".join(value.split()) or NA
+    return NA
+
+
+def _memory() -> str:
+    values = {}
+    for line in _read(PROC / "meminfo").splitlines():
+        key, _, rest = line.partition(":")
+        parts = rest.split()
+        if key in ("MemTotal", "MemAvailable") and parts and parts[0].isdigit():
+            values[key] = int(parts[0])
+    total, avail = values.get("MemTotal"), values.get("MemAvailable")
+    if not total or avail is None:
+        return NA
+    return f"{_gib(total - avail):.1f} / {_gib(total):.1f} GiB"
+
+
+def _disk() -> str:
+    try:
+        usage = shutil.disk_usage(ROOT_FS)
+    except OSError:
+        return NA
+    if not usage.total:
+        return NA
+    gib = 1024 ** 3
+    return f"{usage.used / gib:.0f} / {usage.total / gib:.0f} GiB ({usage.used * 100 // usage.total}%)"
+
+
+def _uptime() -> str:
+    try:
+        seconds = int(float(_read(PROC / "uptime").split()[0]))
+    except (IndexError, ValueError):
+        return NA
+    days, rest = divmod(seconds, 86400)
+    hours, rest = divmod(rest, 3600)
+    minutes = rest // 60
+    if days:
+        return f"{days}d {hours}h"
+    if hours:
+        return f"{hours}h {minutes}m"
+    return f"{minutes}m"
+
+
+def system_info() -> dict:
+    """Los datos de la tarjeta «de un vistazo». Nunca lanza: lo que no se pueda leer sale «—»."""
+    return {
+        "os": _os_name(),
+        "kernel": platform.release() or NA,
+        "cpu": _cpu_model(),
+        "memory": _memory(),
+        "disk": _disk(),
+        "uptime": _uptime(),
+    }
+
+
+# ── Salud (la calcula avalos-doctor) ───────────────────────────────────────
+def health_summary() -> dict:
+    """Corre `avalos-doctor --json` (solo lectura) y lo reduce a lo que muestra la tarjeta:
+    {"state": "missing"|"error"|"done", "ok", "warn", "fail", "issues": [{"title", "status"}]}."""
+    exe = shutil.which("avalos-doctor")
+    if not exe:
+        return {"state": "missing"}
+    try:
+        res = subprocess.run([exe, "--json", "--no-network", "--lang", LANG], capture_output=True,
+                             text=True, timeout=DOCTOR_TIMEOUT, stdin=subprocess.DEVNULL)
+        data = json.loads(res.stdout)
+        summary = data["summary"]
+        findings = data.get("findings") or []
+    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
+        return {"state": "error"}
+    if not isinstance(summary, dict) or not isinstance(findings, list):
+        return {"state": "error"}
+    order = {"fail": 0, "warn": 1}
+    problems = sorted((f for f in findings if isinstance(f, dict) and f.get("status") in order),
+                      key=lambda f: order[f["status"]])
+    return {
+        "state": "done",
+        "ok": int(summary.get("ok", 0)),
+        "warn": int(summary.get("warn", 0)),
+        "fail": int(summary.get("fail", 0)),
+        "issues": [{"title": str(f.get("title", "")), "status": f["status"]} for f in problems[:MAX_ISSUES]],
+    }
+
+
+# ── Lanzar apps ────────────────────────────────────────────────────────────
+def _spawn(cmd) -> bool:
+    try:
+        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
+                         stderr=subprocess.DEVNULL, start_new_session=True)
+        return True
+    except OSError:
+        return False
+
+
+def _has_display() -> bool:
+    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
+
+
+def available_tiles() -> dict:
+    """Qué lanzadores existen en este sistema (los viejos no tienen todo hasta la próxima sync)."""
+    return {tid: bool(shutil.which(argv[0])) for tid, argv in TILE_ARGV.items()}
+
+
+# ── API expuesta a la ventana ──────────────────────────────────────────────
+class ControlAPI:
+    window = None
+
+    def info(self):
+        return system_info()
+
+    def available(self):
+        return available_tiles()
+
+    def open_tile(self, tile_id):
+        argv = TILE_ARGV.get(tile_id) if isinstance(tile_id, str) else None
+        if not argv or not shutil.which(argv[0]):
+            return False
+        return _spawn(list(argv))
+
+    def health(self):
+        return health_summary()
+
+    def close(self):
+        if self.window:
+            self.window.destroy()
+
+
+def _build_html():
+    return r"""<!DOCTYPE html>
+<html lang="LANG_PLACEHOLDER">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>AvalOS</title>
+<style>
+  :root {
+    --bg: #1a1b26; --bg-alt: #16161e; --surface: #1f2335; --surface-hi: #292e42;
+    --border: #414868; --text: #c0caf5; --text-mid: #9aa5ce; --text-dim: #565f89;
+    --blue: #7aa2f7; --purple: #bb9af7; --yellow: #e0af68; --red: #f7768e; --green: #9ece6a;
+  }
+  * { box-sizing: border-box; }
+  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
+    font-family: "JetBrainsMono Nerd Font", ui-monospace, "Cascadia Code", monospace;
+    overflow: hidden; height: 100%; font-size: 13px; }
+  .app { display: flex; flex-direction: column; height: 100vh; }
+  .hidden { display: none !important; }
+
+  header { padding: 20px 26px 14px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
+  .top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
+  header h1 { font-size: 20px; margin: 0 0 5px; font-weight: 600; letter-spacing: .2px; }
+  .accent { background: linear-gradient(135deg, var(--blue), var(--purple));
+    -webkit-background-clip: text; background-clip: text; color: transparent; }
+  header .sub { font-size: 12.5px; color: var(--text-mid); line-height: 1.5; }
+  .search { flex: 0 1 280px; font: inherit; font-size: 12.5px; color: var(--text);
+    background: var(--bg-alt); border: 1px solid var(--border); border-radius: 8px;
