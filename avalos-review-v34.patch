+  .search::placeholder { color: var(--text-dim); }
+
+  .body { flex: 1; overflow-y: auto; padding: 4px 26px 14px; }
+  h2 { font-size: 13px; font-weight: 600; margin: 18px 0 9px; }
+
+  .glance { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
+  .fact { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
+    padding: 9px 12px; min-width: 0; }
+  .fact .k { color: var(--text-dim); font-size: 11px; }
+  .fact .v { margin-top: 3px; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis;
+    white-space: nowrap; }
+
+  .health { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
+    padding: 12px 14px; }
+  .health .row { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
+  .health .d { color: var(--text-mid); font-size: 12px; line-height: 1.45; }
+  .health .res { margin-top: 10px; font-size: 12.5px; line-height: 1.5; }
+  .health .res .sum b { font-weight: 600; }
+  .health .res .clean { color: var(--green); }
+  .health .issues { margin: 8px 0 0; padding: 0; list-style: none; }
+  .health .issues li { padding: 3px 0; color: var(--text-mid); }
+  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; }
+  .dot.fail { background: var(--red); } .dot.warn { background: var(--yellow); }
+  .health .acts { margin-top: 10px; }
+
+  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
+  .tile { font: inherit; text-align: left; color: var(--text); background: var(--surface);
+    border: 1px solid var(--border); border-radius: 10px; padding: 11px 13px; cursor: pointer;
+    display: flex; align-items: flex-start; gap: 11px; min-width: 0; }
+  .tile:hover:not(:disabled), .tile:focus-visible { border-color: var(--blue); outline: none;
+    background: var(--surface-hi); }
+  .tile:disabled { cursor: default; opacity: .55; }
+  .tile .ic { font-size: 20px; line-height: 1.2; flex-shrink: 0; }
+  .tile .t { font-weight: 600; font-size: 13px; }
+  .tile .d { color: var(--text-mid); font-size: 11.5px; margin-top: 3px; line-height: 1.4; }
+  .empty { color: var(--text-dim); padding: 28px 0; text-align: center; }
+
+  .btn { font: inherit; font-size: 12px; color: var(--text); background: var(--surface-hi);
+    border: 1px solid var(--border); border-radius: 8px; padding: 6px 14px; cursor: pointer; flex-shrink: 0; }
+  .btn:hover:not(:disabled) { border-color: var(--blue); }
+  .btn:disabled { cursor: default; opacity: .7; }
+  .btn.primary { background: linear-gradient(135deg, var(--blue), var(--purple));
+    color: #1a1b26; border-color: transparent; font-weight: 600; }
+  .btn:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
+
+  footer { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;
+    gap: 14px; padding: 12px 26px; border-top: 1px solid var(--border); }
+  footer .note { color: var(--text-dim); font-size: 11.5px; }
+
+  .toast { position: fixed; left: 50%; bottom: 64px; transform: translateX(-50%); max-width: 86%;
+    background: var(--surface-hi); border: 1px solid var(--yellow); color: var(--yellow);
+    border-radius: 8px; padding: 8px 14px; font-size: 12px; }
+
+  @media (max-width: 660px) {
+    .top { flex-direction: column; }
+    .search { flex-basis: auto; width: 100%; }
+    .health .row { flex-direction: column; align-items: stretch; }
+  }
+</style>
+</head>
+<body>
+<div class="app">
+  <header>
+    <div class="top">
+      <div>
+        <h1 id="title"></h1>
+        <div class="sub" id="subtitle"></div>
+      </div>
+      <input type="search" id="search" class="search" autocomplete="off" spellcheck="false">
+    </div>
+  </header>
+  <main class="body" id="main">
+    <div id="overview">
+      <h2 id="h-glance"></h2>
+      <div id="glance" class="glance"></div>
+      <h2 id="h-health"></h2>
+      <div class="health">
+        <div class="row">
+          <div class="d" id="health-desc"></div>
+          <button type="button" class="btn" id="health-btn"></button>
+        </div>
+        <div class="res hidden" id="health-res"></div>
+      </div>
+    </div>
+    <div id="groups"></div>
+    <div id="empty" class="empty hidden"></div>
+  </main>
+  <footer>
+    <div class="note" id="note"></div>
+    <button type="button" class="btn primary" id="b-close"></button>
+  </footer>
+  <div id="toast" class="toast hidden" role="status"></div>
+</div>
+<script>
+const S = STRINGS_PLACEHOLDER;
+const TILES = TILES_PLACEHOLDER;
+const GROUPS = GROUPS_PLACEHOLDER;
+const FACTS = FACTS_PLACEHOLDER;
+const $ = (id) => document.getElementById(id);
+
+let avail = {};
+let query = '';
+
+function mk(tag, cls, text) {
+  const e = document.createElement(tag);
+  if (cls) e.className = cls;
+  if (text !== undefined) e.textContent = text;
+  return e;
+}
+function api() { return (window.pywebview && window.pywebview.api) || null; }
+
+function toast(msg) {
+  const t = $('toast');
+  t.textContent = msg;
+  t.classList.remove('hidden');
+  clearTimeout(toast._t);
+  toast._t = setTimeout(() => t.classList.add('hidden'), 4500);
+}
+
+// «AvalOS» lleva el degradado de marca, igual que en las demás apps.
+function setTitle(text) {
+  const h = $('title');
+  h.textContent = '';
+  const i = text.indexOf('AvalOS');
+  if (i < 0) { h.textContent = text; return; }
+  h.appendChild(document.createTextNode(text.slice(0, i)));
+  h.appendChild(mk('span', 'accent', 'AvalOS'));
+  h.appendChild(document.createTextNode(text.slice(i + 'AvalOS'.length)));
+}
+
+function renderGlance(info) {
+  const box = $('glance');
+  box.textContent = '';
+  FACTS.forEach((key) => {
+    const f = mk('div', 'fact');
+    f.appendChild(mk('div', 'k', S['f-' + key]));
+    const v = mk('div', 'v', (info && info[key]) || '—');
+    v.title = v.textContent;
+    f.appendChild(v);
+    box.appendChild(f);
+  });
+}
+
+function matches(tile, q) {
+  if (!q) return true;
+  const id = tile[1];
+  const hay = (S['t-' + id] + ' ' + S['d-' + id] + ' ' + tile[2][0]).toLowerCase();
+  return hay.indexOf(q) !== -1;
+}
+
+function visibleTiles() {
+  const q = query.trim().toLowerCase();
+  return TILES.filter((t) => matches(t, q));
+}
+
+async function openTile(id) {
+  const a = api();
+  if (!a) return;
+  let ok = false;
+  try { ok = await a.open_tile(id); } catch (e) { ok = false; }
+  if (!ok) toast(S.unavailable);
+}
+
+function renderTiles() {
+  const box = $('groups');
+  box.textContent = '';
+  const shown = visibleTiles();
+  GROUPS.forEach((g) => {
+    const items = shown.filter((t) => t[0] === g);
+    if (!items.length) return;
+    box.appendChild(mk('h2', '', S['grp-' + g]));
+    const grid = mk('div', 'grid');
+    items.forEach(([_g, id, argv, icon]) => {
+      const on = avail[id] !== false;               // sin dato: se asume instalada
+      const b = mk('button', 'tile');
+      b.type = 'button';
+      b.disabled = !on;
+      b.dataset.tile = id;
+      b.appendChild(mk('span', 'ic', icon));
+      const info = mk('span', 'info');
+      info.appendChild(mk('div', 't', S['t-' + id]));
+      info.appendChild(mk('div', 'd', on ? S['d-' + id] : S.unavailable));
+      b.appendChild(info);
+      b.addEventListener('click', () => openTile(id));
+      grid.appendChild(b);
+    });
+    box.appendChild(grid);
+  });
+  const empty = $('empty');
+  empty.textContent = shown.length ? '' : S['no-results'].replace('{q}', query.trim());
+  empty.classList.toggle('hidden', shown.length > 0);
+  $('overview').classList.toggle('hidden', query.trim() !== '');
+}
+
+function renderHealth(r) {
+  const res = $('health-res');
+  res.textContent = '';
+  res.classList.remove('hidden');
+  const btn = $('health-btn');
+  btn.disabled = false;
+  btn.textContent = S['health-again'];
+  if (r.state === 'missing') { res.textContent = S['health-na']; btn.disabled = true; return; }
+  if (r.state !== 'done') { res.textContent = S['health-err']; return; }
+  const sum = mk('div', 'sum');
+  sum.appendChild(mk('b', '', S['health-summary']
+    .replace('{ok}', r.ok).replace('{warn}', r.warn).replace('{fail}', r.fail)));
+  res.appendChild(sum);
+  if (!r.issues.length) {
+    res.appendChild(mk('div', 'clean', S['health-clean']));
+  } else {
+    res.appendChild(mk('div', 'd', S['health-issues']));
+    const ul = mk('ul', 'issues');
+    r.issues.forEach((i) => {
+      const li = mk('li');
+      li.appendChild(mk('span', 'dot ' + i.status));
+      li.appendChild(document.createTextNode(i.title));
+      ul.appendChild(li);
+    });
+    res.appendChild(ul);
+  }
+  const acts = mk('div', 'acts');
+  const open = mk('button', 'btn', S['health-open']);
+  open.type = 'button';
+  open.addEventListener('click', () => openTile('doctor'));
+  acts.appendChild(open);
+  res.appendChild(acts);
+}
+
+async function runHealth() {
+  const a = api();
+  const btn = $('health-btn');
+  btn.disabled = true;
+  btn.textContent = S['health-running'];
+  let r = { state: 'error' };
+  if (a) { try { r = await a.health(); } catch (e) { r = { state: 'error' }; } }
+  renderHealth(r);
+}
+
+function closeWin() { const a = api(); if (a) a.close(); }
+
+setTitle(S.title);
+$('subtitle').textContent = S.subtitle;
+$('search').placeholder = S.search;
+$('h-glance').textContent = S['h-glance'];
+$('h-health').textContent = S['h-health'];
+$('health-desc').textContent = S['health-desc'];
+$('health-btn').textContent = S['health-run'];
+$('note').textContent = S.note;
+$('b-close').textContent = S['b-close'];
+renderGlance(null);
+renderTiles();
+$('health-btn').addEventListener('click', runHealth);
+$('b-close').addEventListener('click', closeWin);
+$('search').addEventListener('input', (ev) => { query = ev.target.value; renderTiles(); });
+$('search').addEventListener('keydown', (ev) => {
+  if (ev.key !== 'Enter') return;
+  const first = visibleTiles().find((t) => avail[t[1]] !== false);
+  if (first) openTile(first[1]);
+});
+document.addEventListener('keydown', (ev) => {
+  if (ev.key === 'Escape') {
+    if (query) { query = ''; $('search').value = ''; renderTiles(); } else { closeWin(); }
+  } else if (ev.key === '/' && document.activeElement !== $('search')) {
+    ev.preventDefault();
+    $('search').focus();
+  }
+});
+
+// Con la ventana ya dibujada: datos del equipo y qué apps tiene este sistema.
+async function ready() {
+  const a = api();
+  if (!a) return;
+  try { renderGlance(await a.info()); } catch (e) { /* se quedan los «—» */ }
+  try { avail = await a.available(); renderTiles(); } catch (e) { /* todas activas */ }
+}
+window.addEventListener('pywebviewready', ready);
+</script>
+</body>
+</html>"""
+
+
+def _js(obj) -> str:
+    # Va dentro de un <script>: que un "</" nunca cierre la etiqueta antes de tiempo.
+    return json.dumps(obj, ensure_ascii=False).replace("</", "<\\/")
+
+
+def _render_html(lang: str) -> str:
+    return (_build_html()
+            .replace("LANG_PLACEHOLDER", _HTML_LANG.get(lang, lang))
+            .replace("STRINGS_PLACEHOLDER", _js(STRINGS[lang]))
+            .replace("TILES_PLACEHOLDER", _js(TILES))
+            .replace("GROUPS_PLACEHOLDER", _js(GROUPS))
+            .replace("FACTS_PLACEHOLDER", _js(FACTS)))
+
+
+def _gui():
+    import webview  # solo la ventana lo necesita
+    T = STRINGS[LANG]
+    html = _render_html(LANG)
+
+    # Mismo fix que las demás apps: sin esto GTK usa "python3" como app_id en Wayland y
+    # la window rule (class = "avalos-control") nunca matchea.
+    try:
+        from gi.repository import GLib
+        GLib.set_prgname("avalos-control")
+    except Exception:
+        pass
+
+    api = ControlAPI()
+    win = webview.create_window(
+        title            = T["title"],
+        html             = html,
+        js_api           = api,
+        width            = 880,
+        height           = 660,
+        min_size         = (620, 480),
+        resizable        = True,
+        background_color = "#1a1b26",
+    )
+    api.window = win
+    try:
+        webview.start(debug=False)
+    except Exception as e:  # noqa: BLE001
+        print(f"ERROR al iniciar pywebview: {e}", file=sys.stderr)
+        return 1
+    return 0
+
+
+def main(argv=None):
+    global LANG
+    ap = argparse.ArgumentParser(prog="avalos-control", description="AvalOS Control Center: system settings and AvalOS tools in one window.")
+    ap.add_argument("--json", action="store_true", help="print the system summary and available tools, then exit")
+    ap.add_argument("--lang", choices=_SUPPORTED, help="language of the window")
+    a = ap.parse_args(argv)
+    if a.lang:
+        LANG = a.lang
+    if a.json:
+        print(json.dumps({"info": system_info(), "available": available_tiles()}, ensure_ascii=False, indent=2))
+        return 0
+    if not _has_display():
+        print("avalos-control: no graphical session found (WAYLAND_DISPLAY/DISPLAY)", file=sys.stderr)
+        return 1
