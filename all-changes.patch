diff --git a/configs/fastfetch/config.jsonc b/configs/fastfetch/config.jsonc
index 89fc777..19dc015 100644
--- a/configs/fastfetch/config.jsonc
+++ b/configs/fastfetch/config.jsonc
@@ -3,8 +3,8 @@
   "logo": {
     "source": "/etc/fastfetch/avalos.txt",
     "color": {
-      "1": "38;2;165;225;90",
-      "2": "38;2;75;165;255",
+      "1": "38;2;122;162;247",
+      "2": "38;2;158;206;106",
       "3": "38;2;187;154;247",
       "4": "38;2;122;162;247"
     },
@@ -55,6 +55,13 @@
     // BUG-4 FIX: módulo "colors" con paddingLeft pero sin "symbol".
     // Sin "symbol": "circle" fastfetch usa el símbolo por defecto que
     // en algunas fuentes es un cuadro roto (□) en lugar del círculo (●).
-    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
+    { "type": "colors", "paddingLeft": 2, "symbol": "circle" },
+    "separator",
+
+    // Créditos del proyecto — módulo "custom" sin key, solo texto plano.
+    // Se muestra en ambas rutas de "About" (avalos-about y el fallback
+    // directo a fastfetch en avalos-settings), porque ambas leen este
+    // mismo config.jsonc.
+    { "type": "custom", "format": "  AvalOS — Created, Developed & Supported by Jefferson Stanley Avalos Avalos" }
   ]
 }
diff --git a/configs/hyprland/hyprland_conf_lua.template b/configs/hyprland/hyprland_conf_lua.template
index 8f91445..34a60f5 100755
--- a/configs/hyprland/hyprland_conf_lua.template
+++ b/configs/hyprland/hyprland_conf_lua.template
@@ -131,7 +131,10 @@ hl.bind(mod .. " + Return", hl.dsp.exec_cmd("kitty"))
 hl.bind(mod .. " + Space",  hl.dsp.exec_cmd("rofi -show drun"))
 hl.bind(mod .. " + E",        hl.dsp.exec_cmd("thunar"))
 hl.bind(mod .. " + B",        hl.dsp.exec_cmd("firefox"))
-hl.bind(mod .. " + SHIFT + B", hl.dsp.exec_cmd("firefox"))
+-- BUG FIX: estaba duplicado apuntando a firefox otra vez en vez de Edge
+-- (el mismo bug existía en microsoft-edge-stable.template y en el live,
+-- que sí lo tenía bien). SHIFT+B = Edge, B solo = Firefox.
+hl.bind(mod .. " + SHIFT + B", hl.dsp.exec_cmd("microsoft-edge-stable"))
 hl.bind(mod .. " + SHIFT + S",
     hl.dsp.exec_cmd('grim -g "$(slurp)" - | wl-copy'))
 hl.bind(mod .. " + V",
@@ -230,3 +233,13 @@ hl.window_rule({
     center = true,
     size   = { 1000, 700 },
 })
+hl.window_rule({
+    match  = { class = "avalos-settings" },
+    float  = true,
+    center = true,
+    size   = { 1000, 700 },
+})
+
+-- Atajos para abrir las apps de AvalOS directo, sin pasar por rofi
+hl.bind(mod .. " + CTRL + W", hl.dsp.exec_cmd("avalos-wallpaper"))
+hl.bind(mod .. " + CTRL + S", hl.dsp.exec_cmd("avalos-settings"))
diff --git a/configs/rofi/config.rasi b/configs/rofi/config.rasi
index 90491f9..e663541 100644
--- a/configs/rofi/config.rasi
+++ b/configs/rofi/config.rasi
@@ -161,3 +161,13 @@ element-icon {
    * Mismo problema que element-text — el ícono aparece descentrado. */
   vertical-align:   0.5;
 }
+
+/* Sin zebra-striping: mismo fondo transparente para todos los items,
+   sean pares o impares. */
+element normal.normal {
+  background-color: transparent;
+}
+
+element alternate.normal {
+  background-color: transparent;
+}
