+        "gm-group-no": "You're not in the gamemode group yet: log out and back in.",
+        "gm-group-na": "The gamemode group doesn't exist on this system.",
+        "gm-test": "Run GameMode test", "gm-testing": "Testing…",
+        "gm-test-ok": "GameMode test passed ({n} checks).",
