@@ -0,0 +1,1152 @@
+#!/usr/bin/env python3
+# ── AvalOS — avalos-gamecenter ──────────────────────────────────────
+# Game Center de AvalOS: todo lo de jugar en una ventana. Abre los lanzadores (Steam, Lutris,
+# Heroic, Prism, Bottles), muestra el estado de GameMode, deja elegir el perfil de MangoHud y da
+# las «opciones de lanzamiento» listas para copiar. Todo corre como el usuario: no necesita root
+# ni polkit. Lo único que escribe son los perfiles de ~/.config/MangoHud/.
+#
+#   avalos-gamecenter          abre la ventana (Super+Alt+G, o desde el Centro de control)
+#   avalos-gamecenter --json   imprime lo que ve (GameMode, MangoHud, lanzadores...) y sale (soporte)
+#
+# MangoHud solo lee ./MangoHud.conf, $XDG_CONFIG_HOME/MangoHud/ y $MANGOHUD_CONFIGFILE: por eso los
+# perfiles viven ahí y cada juego puede elegir el suyo con MANGOHUD_CONFIGFILE.
+#
+# Requiere: python 3.9+, python-pywebview, webkit2gtk-4.1 y python-gobject (ya los instala el
+# instalador). Opcionales: gamemode, mangohud, wl-clipboard (copiar), hyprctl (pantallas).
+import argparse
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+try:
+    import grp
+except ImportError:  # pragma: no cover - solo Linux
+    grp = None
+
+# ── Rutas del sistema (se pueden redirigir en las pruebas) ─────────────────
+SYSFS_CPUFREQ = Path("/sys/devices/system/cpu/cpu0/cpufreq")
+SYSFS_DRM = Path("/sys/class/drm")
+GAMEMODE_INI_SYSTEM = (Path("/usr/share/gamemode/gamemode.ini"), Path("/etc/gamemode.ini"))
+STEAM_SYSTEM_TOOLS = Path("/usr/share/steam/compatibilitytools.d")
+FLATPAK_SYSTEM_APPS = Path("/var/lib/flatpak/app")
+
+# ── i18n — mismo patrón que avalos-doctor/avalos-control ───────────────────
+_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
+_SUPPORTED = ("en", "es", "zh", "ja")
+_HTML_LANG = {"zh": "zh-CN"}
+
+
+def _detectar_idioma() -> str:
+    try:
+        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
+        if code in _SUPPORTED:
+            return code
+    except OSError:
+        pass
+    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
+    return _lang_raw if _lang_raw in _SUPPORTED else "en"
+
+
+LANG = _detectar_idioma()
+
+# Lanzadores: (id, nombre, candidatos, icono). Cada candidato es un comando exacto; se usa el
+# primero que exista (un binario en el PATH o una app de Flatpak ya instalada). Lista cerrada:
+# la página nunca puede lanzar otra cosa. Texto de la descripción: d-<id>.
+LAUNCHERS = [
+    ("steam", "Steam", (("steam",),), "🎮"),
+    ("lutris", "Lutris", (("lutris",),), "🍷"),
+    ("heroic", "Heroic Games Launcher", (("heroic",), ("flatpak", "run", "com.heroicgameslauncher.hgl")), "🦸"),
+    ("prism", "Prism Launcher", (("prismlauncher",), ("flatpak", "run", "org.prismlauncher.PrismLauncher")), "⛏️"),
+    ("bottles", "Bottles", (("flatpak", "run", "com.usebottles.bottles"),), "🍾"),
+]
+LAUNCHER_CANDIDATES = {lid: cands for lid, _n, cands, _i in LAUNCHERS}
+
+# ── Perfiles de MangoHud ───────────────────────────────────────────────────
+# Estilo (Tokyo Night) y comportamiento: lo mismo que configs/mangohud/MangoHud.conf, sin las
+# líneas de «qué mostrar». Una prueba compara esto con ese archivo para que no se separen.
+MANGO_STYLE = {
+    "legacy_layout": "0", "position": "top-left", "width": "260", "height": "0",
+    "background_alpha": "0.7", "font_size": "20", "font_size_text": "16",
+    "text_color": "c0caf5", "background_color": "1a1b26", "gpu_color": "7aa2f7",
+    "cpu_color": "9ece6a", "vram_color": "bb9af7", "ram_color": "9ece6a", "wine_color": "7dcfff",
+    "fps_color_change": "1", "fps_value": "30,60", "fps_color": "f7768e,e0af68,9ece6a",
+    "frametime_color": "9ece6a", "toggle_hud": "Shift_R+F12", "toggle_fps_limit": "Shift_R+F1",
+    "reload_cfg": "Shift_R+F4", "upload_log": "Shift_R+F3", "toggle_logging": "Shift_R+F2",
+    "output_folder": "~/.local/share/MangoHud/logs",
+}
+# Claves de «qué mostrar» (las que cambian de un perfil a otro).
+MANGO_METRIC_KEYS = frozenset({
+    "fps", "fps_limit", "frame_timing", "frametime", "cpu_stats", "cpu_temp", "gpu_stats", "gpu_temp",
+    "gpu_power", "vram", "ram", "wine", "engine_version", "cpu_mhz", "gpu_core_clock", "gpu_mem_clock",
+    "swap", "gamemode", "time", "vulkan_driver", "resolution", "no_display",
+})
+_STANDARD = ["fps", "fps_limit=0", "frame_timing=1", "frametime", "cpu_stats", "cpu_temp", "gpu_stats",
+             "gpu_temp", "gpu_power", "vram", "ram", "wine", "engine_version", "no_display=0"]
+MANGO_PROFILES = {
+    "minimal": ["fps", "fps_limit=0", "frame_timing=0", "frametime", "no_display=0"],
+    "standard": _STANDARD,
+    "full": _STANDARD + ["cpu_mhz", "gpu_core_clock", "gpu_mem_clock", "swap", "gamemode", "vulkan_driver",
+                         "resolution", "time"],
+    "hidden": ["fps", "fps_limit=0", "frame_timing=0", "frametime", "no_display=1"],
+}
+MANGO_ORDER = ("minimal", "standard", "full", "hidden")
+MANGO_CONF = "MangoHud.conf"
+MANGO_BACKUP = "MangoHud.conf.avalos-backup"
+
+# Variantes de «opciones de lanzamiento» (id -> plantilla). {cfg} es el perfil elegido.
+LAUNCH_VARIANTS = ("gamemode", "mangohud", "both", "profile")
+MAX_TOOLS = 10
+GAMEMODE_TEST_TIMEOUT = 90
+
