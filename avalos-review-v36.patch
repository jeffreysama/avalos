+        "mg-state": "In use:", "mg-none": "MangoHud's own look (no AvalOS profile yet)", "mg-custom": "Your own configuration",
+        "mp-minimal": "Minimal", "mpd-minimal": "FPS and frametime only.",
+        "mp-standard": "Standard", "mpd-standard": "AvalOS style: FPS, CPU, GPU, memory and frame graph.",
+        "mp-full": "Full", "mpd-full": "Everything in Standard plus clocks, swap, GameMode, driver and time.",
