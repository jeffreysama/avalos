+    launch_options: async (p) => { calls.push(['launch_options', p]); return OPTS(p); },
+    copy_options: async (v, p) => { calls.push(['copy_options', v, p]); return { ok: true, text: '' }; },
+    close: async () => { calls.push(['close']); },
+  };
