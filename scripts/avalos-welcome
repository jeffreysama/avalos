#!/usr/bin/env python3
# ── AvalOS — avalos-welcome ─────────────────────────────────────────
# Bienvenida del primer arranque: qué conviene hacer primero (actualizar, instalar
# apps, fondo de pantalla, salud del sistema, puntos de restauración) y los atajos de
# teclado que vale la pena saber. Solo abre otras apps de AvalOS: no necesita root ni
# polkit y no cambia nada del sistema. Lo único que escribe es la marca «ya la viste»
# en ~/.local/state/avalos/welcome-seen.
#
#   avalos-welcome              abre la ventana (menú de Settings, rofi)
#   avalos-welcome --first-run  igual, pero solo si no se mostró antes (autostart de
#                               Hyprland); no hace nada en el live ni sin pantalla
#
# La marca se escribe cuando la ventana ya cargó, no al lanzarla: si algo falla antes
# de dibujarse, el próximo inicio de sesión lo vuelve a intentar.
#
# Requiere: python 3.9+, python-pywebview, webkit2gtk-4.1 y python-gobject (ya los
# instala el instalador).
import argparse
import datetime
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# ── Rutas del sistema (se pueden redirigir en las pruebas) ─────────────────
LIVE_MARKER = Path("/run/archiso")  # solo existe en el live ISO

# ── i18n — mismo patrón que avalos-doctor/avalos-update ───────────────────
_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")
_HTML_LANG = {"zh": "zh-CN"}


def _detectar_idioma() -> str:
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

# Pasos: (id, app que abre). Los textos son a-<id>-t (título) y a-<id>-d (descripción).
STEPS = [
    ("update", "avalos-update"),
    ("store", "avalos-store"),
    ("wall", "avalos-wallpaper"),
    ("doctor", "avalos-doctor"),
    ("restore", "avalos-restore"),
]

# Lista cerrada: la página nunca puede lanzar otra cosa que estas apps.
OPEN_WHITELIST = tuple(app for _id, app in STEPS)

# Lista cerrada de enlaces (se abren con el navegador del sistema).
URLS = {
    "repo": "https://github.com/jeffreysama/avalos",
    "issues": "https://github.com/jeffreysama/avalos/issues",
}

# Atajos que se muestran: (teclas, clave de texto). Tienen que existir de verdad en
# configs/hyprland/hyprland_conf_lua.template: scripts/validate_app_consistency.py lo
# comprueba (una entrada con «…» en la última tecla, como el rango de escritorios, se
# salta porque en el template sale de un bucle). El formato de la lista es literal a
# propósito: ese validador la lee tal cual.
