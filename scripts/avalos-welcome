# ── Primer arranque ────────────────────────────────────────────────────────
def _state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME", "")
    if not base or not os.path.isabs(base):  # la spec XDG exige una ruta absoluta
        base = str(Path.home() / ".local" / "state")
    return Path(base) / "avalos"


def _seen_file() -> Path:
    return _state_dir() / "welcome-seen"


def _has_display() -> bool:
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def _should_show_first_run() -> bool:
    """Autostart: solo si no se mostró antes, no es el live ISO y hay pantalla."""
    if LIVE_MARKER.exists() or _seen_file().exists():
        return False
    return _has_display()


def _spawn(cmd) -> bool:
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


# ── API expuesta a la ventana ──────────────────────────────────────────────
class WelcomeAPI:
    window = None

    def available(self):
        """Qué apps de la lista existen en este sistema (los sistemas viejos no tienen
        todas hasta que reciben la sync)."""
        return {name: bool(shutil.which(name)) for name in OPEN_WHITELIST}

    def open_app(self, name):
        if not isinstance(name, str) or name not in OPEN_WHITELIST or not shutil.which(name):
            return False
        return _spawn([name])

    def open_url(self, key):
        url = URLS.get(key) if isinstance(key, str) else None
        if not url:
            return {"ok": False, "url": ""}
        for opener in ("xdg-open", "firefox", "microsoft-edge-stable"):
            if shutil.which(opener) and _spawn([opener, url]):
                return {"ok": True, "url": url}
        return {"ok": False, "url": url}

    def mark_seen(self):
        try:
            d = _state_dir()
            d.mkdir(parents=True, exist_ok=True)
            (d / "welcome-seen").write_text(datetime.date.today().isoformat() + "\n", encoding="utf-8")
            return True
        except OSError:
            return False

    def close(self):
        if self.window:
            self.window.destroy()


def _build_html():
    return r"""<!DOCTYPE html>
<html lang="LANG_PLACEHOLDER">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AvalOS</title>
<style>
  :root {
    --bg: #1a1b26; --bg-alt: #16161e; --surface: #1f2335; --surface-hi: #292e42;
    --border: #414868; --text: #c0caf5; --text-mid: #9aa5ce; --text-dim: #565f89;
    --blue: #7aa2f7; --purple: #bb9af7; --yellow: #e0af68;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: "JetBrainsMono Nerd Font", ui-monospace, "Cascadia Code", monospace;
    overflow: hidden; height: 100%; font-size: 13px; }
  .app { display: flex; flex-direction: column; height: 100vh; }
  .hidden { display: none !important; }

  header { padding: 22px 26px 16px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  header h1 { font-size: 20px; margin: 0 0 5px; font-weight: 600; letter-spacing: .2px; }
  .accent { background: linear-gradient(135deg, var(--blue), var(--purple));
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  header .sub { font-size: 12.5px; color: var(--text-mid); line-height: 1.5; }

  .body { flex: 1; overflow-y: auto; padding: 4px 26px 14px; }
  h2 { font-size: 13px; font-weight: 600; margin: 18px 0 9px; }

  .row { display: flex; align-items: center; justify-content: space-between; gap: 14px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 10px 12px 10px 14px; margin-bottom: 7px; }
  .row .t { font-weight: 600; font-size: 13px; }
  .row .d { color: var(--text-mid); font-size: 12px; margin-top: 2px; line-height: 1.45; max-width: 62ch; }
  .row.off { opacity: .6; }

  .btn { font: inherit; font-size: 12px; color: var(--text); background: var(--surface-hi);
    border: 1px solid var(--border); border-radius: 8px; padding: 6px 14px; cursor: pointer; flex-shrink: 0; }
  .btn:hover:not(:disabled) { border-color: var(--blue); }
  .btn:disabled { cursor: default; }
  .btn.primary { background: linear-gradient(135deg, var(--blue), var(--purple));
    color: #1a1b26; border-color: transparent; font-weight: 600; }
  .btn:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

  .keys { display: grid; grid-template-columns: 1fr 1fr; gap: 0 26px; }
  .key { display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 7px 0; border-bottom: 1px solid rgba(65,72,104,.5); }
  .key .what { font-size: 12.5px; }
  .combo { display: flex; align-items: center; gap: 4px; flex-shrink: 0; }
  .plus { color: var(--text-dim); font-size: 11px; }
  kbd { font: inherit; font-size: 11.5px; min-width: 24px; text-align: center;
    padding: 2px 7px 3px; background: var(--bg-alt); border: 1px solid var(--border);
    border-bottom-width: 2px; border-radius: 6px; color: var(--text); }

  footer { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between;
    gap: 14px; padding: 12px 26px; border-top: 1px solid var(--border); }
  footer .note { color: var(--text-dim); font-size: 11.5px; line-height: 1.4; }
  footer .btns { display: flex; gap: 8px; flex-shrink: 0; }

  .toast { position: fixed; left: 50%; bottom: 64px; transform: translateX(-50%); max-width: 86%;
    background: var(--surface-hi); border: 1px solid var(--yellow); color: var(--yellow);
    border-radius: 8px; padding: 8px 14px; font-size: 12px; word-break: break-all; }

  @media (max-width: 660px) {
    .keys { grid-template-columns: 1fr; }
    footer { flex-direction: column; align-items: stretch; }
    footer .btns { justify-content: flex-end; }
