</style>
</head>
<body>
<div class="app">
  <header>
    <h1 id="title"></h1>
    <div class="sub" id="subtitle"></div>
  </header>
  <main class="body">
    <h2 id="h-start"></h2>
    <div id="steps"></div>
    <h2 id="h-keys"></h2>
    <div id="keys" class="keys"></div>
  </main>
  <footer>
    <div class="note" id="note"></div>
    <div class="btns">
      <button type="button" class="btn" id="b-github"></button>
      <button type="button" class="btn" id="b-issues"></button>
      <button type="button" class="btn primary" id="b-close"></button>
    </div>
  </footer>
  <div id="toast" class="toast hidden" role="status"></div>
</div>
<script>
const S = STRINGS_PLACEHOLDER;
const STEPS = STEPS_PLACEHOLDER;
const KEYS = KEYS_PLACEHOLDER;
const $ = (id) => document.getElementById(id);

function mk(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}
function api() { return (window.pywebview && window.pywebview.api) || null; }

function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => t.classList.add('hidden'), 4500);
}

// «AvalOS» lleva el degradado de marca, igual que en las demás apps.
function setTitle(text) {
  const h = $('title');
  h.textContent = '';
  const i = text.indexOf('AvalOS');
  if (i < 0) { h.textContent = text; return; }
  h.appendChild(document.createTextNode(text.slice(0, i)));
  h.appendChild(mk('span', 'accent', 'AvalOS'));
  h.appendChild(document.createTextNode(text.slice(i + 'AvalOS'.length)));
}

function renderSteps(avail) {
  const box = $('steps');
  box.textContent = '';
  STEPS.forEach(([id, app]) => {
    const on = avail[app] !== false;           // sin dato: se asume instalada
    const row = mk('div', 'row' + (on ? '' : ' off'));
    const info = mk('div', 'info');
    info.appendChild(mk('div', 't', S['a-' + id + '-t']));
    info.appendChild(mk('div', 'd', on ? S['a-' + id + '-d'] : S.unavailable));
    const btn = mk('button', 'btn', S.open);
    btn.type = 'button';
    btn.disabled = !on;
    btn.dataset.app = app;
    btn.addEventListener('click', async () => {
      const a = api();
      if (!a) return;
      let ok = false;
      try { ok = await a.open_app(app); } catch (e) { ok = false; }
      if (!ok) toast(S.unavailable);
    });
    row.appendChild(info);
    row.appendChild(btn);
    box.appendChild(row);
  });
}

function renderKeys() {
  const box = $('keys');
  box.textContent = '';
  KEYS.forEach(([combo, label]) => {
    const item = mk('div', 'key');
    item.appendChild(mk('span', 'what', S[label]));
    const c = mk('span', 'combo');
    combo.forEach((k, i) => {
      if (i) c.appendChild(mk('span', 'plus', '+'));
      c.appendChild(mk('kbd', '', k));
    });
    item.appendChild(c);
    box.appendChild(item);
  });
}

async function openUrl(key) {
  const a = api();
  if (!a) return;
  let r = { ok: false, url: '' };
  try { r = await a.open_url(key); } catch (e) { r = { ok: false, url: '' }; }
  if (!r.ok) toast(S['url-fail'].replace('{url}', r.url || ''));
}
function closeWin() { const a = api(); if (a) a.close(); }

setTitle(S.title);
$('subtitle').textContent = S.subtitle;
$('h-start').textContent = S['h-start'];
$('h-keys').textContent = S['h-keys'];
$('note').textContent = S.note;
$('b-github').textContent = S['b-github'];
$('b-issues').textContent = S['b-issues'];
$('b-close').textContent = S['b-close'];
renderSteps({});
renderKeys();
$('b-github').addEventListener('click', () => openUrl('repo'));
$('b-issues').addEventListener('click', () => openUrl('issues'));
$('b-close').addEventListener('click', closeWin);
document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeWin(); });

// Con la ventana ya dibujada: marcar el primer arranque como visto y atenuar las apps
// que este sistema todavía no tiene.
async function ready() {
  const a = api();
  if (!a) return;
  try { renderSteps(await a.available()); } catch (e) { /* se queda con todas activas */ }
  try { await a.mark_seen(); } catch (e) { /* sin marca: se mostrará otra vez */ }
}
window.addEventListener('pywebviewready', ready);
</script>
</body>
</html>"""


def _js(obj) -> str:
    # Va dentro de un <script>: que un "</" nunca cierre la etiqueta antes de tiempo.
    return json.dumps(obj, ensure_ascii=False).replace("</", "<\\/")


def _render_html(lang: str) -> str:
    return (_build_html()
            .replace("LANG_PLACEHOLDER", _HTML_LANG.get(lang, lang))
            .replace("STRINGS_PLACEHOLDER", _js(STRINGS[lang]))
            .replace("STEPS_PLACEHOLDER", _js(STEPS))
            .replace("KEYS_PLACEHOLDER", _js(SHORTCUTS)))


def _gui():
    import webview  # solo la ventana lo necesita
    T = STRINGS[LANG]
    html = _render_html(LANG)

    # Mismo fix que las demás apps: sin esto GTK usa "python3" como app_id en Wayland y
    # la window rule (class = "avalos-welcome") nunca matchea.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-welcome")
    except Exception:
        pass

    api = WelcomeAPI()
    win = webview.create_window(
        title            = T["title"],
        html             = html,
        js_api           = api,
        width            = 760,
        height           = 680,
        min_size         = (560, 480),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win
    try:
        webview.start(debug=False)
    except Exception as e:  # noqa: BLE001
        print(f"ERROR al iniciar pywebview: {e}", file=sys.stderr)
        return 1
    return 0


def main(argv=None):
    global LANG
    ap = argparse.ArgumentParser(prog="avalos-welcome", description="AvalOS welcome window: first steps and key shortcuts.")
    ap.add_argument("--first-run", action="store_true",
                    help="show it only if it has not been shown before (Hyprland autostart)")
    ap.add_argument("--lang", choices=_SUPPORTED, help="language of the window")
    a = ap.parse_args(argv)
    if a.lang:
        LANG = a.lang
    if a.first_run and not _should_show_first_run():
        return 0
    if not _has_display():
        print("avalos-welcome: no graphical session found (WAYLAND_DISPLAY/DISPLAY)", file=sys.stderr)
        return 1
    return _gui()


if __name__ == "__main__":
    sys.exit(main())
