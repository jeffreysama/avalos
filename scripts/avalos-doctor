#!/usr/bin/env python3
# ── AvalOS — avalos-doctor ──────────────────────────────────────────
# Chequeo de salud del sistema en un clic: disco y btrfs, kernel y archivos de
# arranque, paquetes, GPU y drivers de juegos, red y las propias apps de AvalOS.
# SOLO LEE: no necesita root, no cambia nada y no abre pkexec. Lo único que
# puede hacer es abrir otra app de AvalOS (Actualizaciones o Restaurar) cuando
# el hallazgo se arregla ahí.
#
# Un motor, dos caras:
#   avalos-doctor            ventana (pywebview); sin pantalla cae a la consola
#   avalos-doctor --text     informe en consola
#   avalos-doctor --json     lo mismo en JSON (soporte, scripts)
# Código de salida de la consola: 0 todo bien · 1 hay avisos · 2 hay fallos.
#
# Cada chequeo corre en su propio hilo con tope de tiempo y NUNCA tira el
# informe: si falla, queda como «no se pudo comprobar». Las rutas del sistema
# son constantes de módulo a propósito (las pruebas las apuntan a un árbol falso).
#
# Requiere: python 3.9+. La ventana además python-pywebview, webkit2gtk-4.1 y
# python-gobject (ya instalados por el instalador); sin ellos --text sigue andando.
import argparse
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# ── Rutas del sistema (se pueden redirigir en las pruebas) ─────────────────
PROC = Path("/proc")
SYS = Path("/sys")
ETC = Path("/etc")
BOOT = Path("/boot")
ESP = Path("/boot/efi")
MODULES_DIR = Path("/usr/lib/modules")
PACMAN_LOCK = Path("/var/lib/pacman/db.lck")
BIN_DIR = Path("/usr/local/bin")
APPS_DIR = Path("/usr/share/applications")
ICON_DIR = Path("/usr/share/icons/hicolor/scalable/apps")

KERNEL_PKGS = ("linux", "linux-lts", "linux-zen", "linux-hardened",
               "linux-avalos", "linux-avalos-bore", "linux-avalos-compat")
AVALOS_APPS = ("avalos-settings", "avalos-wallpaper", "avalos-about", "avalos-update",
               "avalos-update-helper", "avalos-store", "avalos-restore", "avalos-doctor")
# Mismas apps que validate_app_consistency.NEEDS_DESKTOP: sin .desktop e ícono no aparecen en el menú.
NEEDS_DESKTOP = {"avalos-settings", "avalos-store", "avalos-update", "avalos-restore", "avalos-doctor"}
# Lo único que la ventana puede lanzar. Cualquier otro nombre se rechaza.
OPEN_WHITELIST = {"avalos-update": "a-update", "avalos-restore": "a-restore"}

# ── i18n — mismo patrón que avalos-update/avalos-restore ──────────────────
_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")
_HTML_LANG = {"zh": "zh-CN"}


def _detectar_idioma() -> str:
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

