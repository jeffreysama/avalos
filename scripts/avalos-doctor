# ── Utilidades ─────────────────────────────────────────────────────────────
def _run(cmd, timeout=6):
    """Corre un comando sin shell; devuelve (rc, stdout). 127 si no existe o se pasa del tiempo."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""


def _read(path) -> str:
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


_LOCK = threading.Lock()
_CACHE = {}


def _cached(key, fn):
    # Varios chequeos comparten datos (lista de paquetes, filesystem de /): se calculan una vez por corrida.
    with _LOCK:
        if key not in _CACHE:
            _CACHE[key] = fn()
        return _CACHE[key]


def _installed_pkgs():
    """Conjunto de paquetes instalados, o None si pacman no responde (los chequeos de paquetes se saltan)."""
    def go():
        rc, out = _run(["pacman", "-Qq"], timeout=10)
        return set(out.split()) if rc == 0 else None
    return _cached("pkgs", go)


def R(status, key, action=None, **args):
    """Resultado de un chequeo: (estado, clave del texto, argumentos, app a abrir)."""
    return status, key, args, action


def _gib(n) -> str:
    return f"{n / 2**30:.1f} GiB"


def _cpu_arch() -> str:
    # Misma lógica que avalos-update (_check_kernel_info): «lzcnt» se expone como «abm» en /proc/cpuinfo.
    flags = set()
    for line in _read(PROC / "cpuinfo").splitlines():
        if line.startswith("flags"):
            flags = set(line.split(":", 1)[1].lower().split())
            break
    if not flags:
        return "x86-64"
    if "lzcnt" in flags:
        flags.add("abm")
    v3 = {"avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "abm", "movbe", "xsave"}
    v4 = {"avx512f", "avx512bw", "avx512cd", "avx512dq", "avx512vl"}
    return "x86-64-v4" if v4 <= flags else "x86-64-v3" if v3 <= flags else "x86-64-v2"


def _root_fs():
    def go():
        rc, out = _run(["findmnt", "-no", "FSTYPE,UUID", "/"])
        parts = out.split()
        return (parts[0], parts[1]) if rc == 0 and len(parts) >= 2 else ("", "")
    return _cached("rootfs", go)


def _default_route() -> str:
    """Interfaz de la ruta por defecto (IPv4 o IPv6) leyendo /proc; '' si no hay."""
    for line in _read(PROC / "net" / "route").splitlines()[1:]:
        f = line.split()
        try:
            if len(f) >= 4 and f[1] == "00000000" and int(f[3], 16) & 2:
                return f[0]
        except ValueError:
            continue
    for line in _read(PROC / "net" / "ipv6_route").splitlines():
        f = line.split()
        try:
            if (len(f) >= 10 and f[0] == "0" * 32 and f[1] == "00"
                    and int(f[8], 16) & 1 and not int(f[8], 16) & 0x200):
                return f[9]
        except ValueError:
            continue
    return ""


def _probe(url, timeout=6):
    """GET de 1 byte (Range) — algunos CDN rechazan HEAD. Devuelve (ok, ms | motivo)."""
    req = urllib.request.Request(url, headers={"Range": "bytes=0-0", "User-Agent": "avalos-doctor"})
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            r.read(1)
        return True, int((time.time() - t0) * 1000)
    except Exception as e:  # noqa: BLE001 — cualquier fallo de red es un hallazgo, no un crash
        return False, str(getattr(e, "reason", e))[:80]


# ── Chequeos: cada uno devuelve R(...) ─────────────────────────────────────
def chk_kernel():
    rel = os.uname().release
    if "bore" in rel.lower() and _cpu_arch() not in ("x86-64-v3", "x86-64-v4"):
        return R("fail", "d-kernel-bore-cpu", "avalos-update", rel=rel, cpu=_cpu_arch())
    # pacman borra /usr/lib/modules/<versión>/kernel al reemplazar el paquete del kernel; el resto del
    # directorio puede sobrevivir (módulos de DKMS), por eso se mira solo «kernel».
    if not (MODULES_DIR / rel / "kernel").is_dir():
        others = list(MODULES_DIR.glob("*/kernel")) if MODULES_DIR.is_dir() else []
        if others:  # hay otro kernel instalado y el que corre ya no está: se actualizó
            return R("warn", "d-kernel-reboot", rel=rel)
        return R("info", "d-kernel-ok", rel=rel)  # nada con qué comparar (contenedor, live raro)
    return R("ok", "d-kernel-ok", rel=rel)


def chk_boot_files():
    have = _installed_pkgs()
    pkgs = [p for p in KERNEL_PKGS if have and p in have]
    if not pkgs:
        return R("skip", "d-error", err="pacman -Qq")
    missing = []
    for p in pkgs:
        for f in (BOOT / f"vmlinuz-{p}", BOOT / f"initramfs-{p}.img", ETC / "mkinitcpio.d" / f"{p}.preset"):
            try:
                good = f.stat().st_size > 0
            except OSError:
                good = False
            if not good:
                missing.append(f.name)
    if missing:
        return R("fail", "d-boot-files-fail", missing=", ".join(missing))
    return R("ok", "d-boot-files-ok", n=len(pkgs))


def chk_time_sync():
    rc, out = _run(["timedatectl", "show", "-p", "NTPSynchronized", "--value"])
    if rc != 0:
        return R("skip", "d-error", err="timedatectl")
    return R("ok", "d-time-sync-ok") if out.strip() == "yes" else R("warn", "d-time-sync-warn")


def chk_disk_root():
    du = shutil.disk_usage("/")
    free_pct = du.free * 100 / du.total if du.total else 100
    args = {"used": round(100 - free_pct), "free": _gib(du.free)}
    if free_pct < 5 or du.free < 3 * 2**30:
        return R("fail", "d-disk-root-fail", "avalos-restore", **args)
    if free_pct < 15 or du.free < 10 * 2**30:
        return R("warn", "d-disk-root-warn", "avalos-restore", **args)
    return R("ok", "d-disk-root-ok", **args)


def chk_btrfs_meta():
    fstype, uuid = _root_fs()
    if fstype != "btrfs" or not uuid:
        return R("info", "d-btrfs-na")
    base = SYS / "fs" / "btrfs" / uuid / "allocation" / "metadata"
    try:
        total = int(_read(base / "total_bytes").strip())
        used = int(_read(base / "bytes_used").strip())
    except ValueError:
        return R("skip", "d-error", err="sysfs allocation/metadata")
    pct = round(used * 100 / total) if total else 0
    return R("warn", "d-btrfs-meta-warn", pct=pct) if pct >= 90 else R("ok", "d-btrfs-meta-ok", pct=pct)


def chk_btrfs_errors():
    fstype, uuid = _root_fs()
    if fstype != "btrfs" or not uuid:
        return R("info", "d-btrfs-na")
    files = sorted((SYS / "fs" / "btrfs" / uuid / "devinfo").glob("*/error_stats"))
    if not files:
        return R("skip", "d-error", err="devinfo/*/error_stats")
    bad = []
    for f in files:
        counts = {}
        for line in _read(f).splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1].isdigit():
                counts[parts[0].replace("_errs", "")] = int(parts[1])
        nonzero = [f"{k}={v}" for k, v in counts.items() if v]
        if nonzero:
            bad.append(f"devid {f.parent.name}: " + ", ".join(nonzero))
    return R("fail", "d-btrfs-errors-fail", errs="; ".join(bad)) if bad else R("ok", "d-btrfs-errors-ok")


def chk_esp():
    if not os.path.ismount(ESP):
        return R("info", "d-esp-none")
    free = shutil.disk_usage(ESP).free // 2**20
    return R("warn", "d-esp-warn", free=free) if free < 50 else R("ok", "d-esp-ok", free=free)


def chk_snapshots():
    if not (ETC / "snapper" / "configs" / "root").exists():
        return R("warn", "d-snapshots-noconfig", "avalos-restore")
    if _run(["systemctl", "is-enabled", "snapper-cleanup.timer"])[1].strip() != "enabled":
        return R("warn", "d-snapshots-nocleanup")
    return R("ok", "d-snapshots-ok", "avalos-restore")


def chk_pacman_lock():
    if not PACMAN_LOCK.exists():
        return R("ok", "d-pacman-lock-ok")
    busy = _run(["pgrep", "-x", "pacman|yay|paru"])[0] == 0
    return R("info", "d-pacman-lock-busy") if busy else R("warn", "d-pacman-lock-stale")


def chk_pacnew():
    found = []
    for root, _dirs, files in os.walk(ETC):
        found += [os.path.join(root, f) for f in files if f.endswith((".pacnew", ".pacsave"))]
    if not found:
        return R("ok", "d-pacnew-ok")
    return R("warn", "d-pacnew-warn", n=len(found), first=sorted(found)[0])


def chk_mirrors():
    try:
        age = (time.time() - (ETC / "pacman.d" / "mirrorlist").stat().st_mtime) / 86400
    except OSError:
        return R("fail", "d-mirrors-missing")
    days = int(age)
    return R("warn", "d-mirrors-warn", days=days) if days > 120 else R("ok", "d-mirrors-ok", days=days)


def chk_units():
    names = []
    for scope in ([], ["--user"]):
        rc, out = _run(["systemctl", *scope, "--failed", "--no-legend", "--plain", "--no-pager"])
        if rc != 0 and not scope:
            return R("skip", "d-error", err="systemctl")
        names += [ln.split()[0] for ln in out.splitlines() if ln.strip()]
    if not names:
        return R("ok", "d-units-ok")
    return R("warn", "d-units-warn", n=len(names), names=", ".join(names[:5]) + (" …" if len(names) > 5 else ""))


_VENDORS = {"0x1002": "AMD", "0x8086": "Intel", "0x10de": "NVIDIA"}
_GOOD_DRIVERS = {"amdgpu", "radeon", "i915", "xe", "nvidia", "nouveau"}


def _gpus():
    found = []
    for card in sorted((SYS / "class" / "drm").glob("card[0-9]*")):
        if "-" in card.name:  # card0-DP-1 y similares son conectores, no GPUs
            continue
        vendor = _read(card / "device" / "vendor").strip().lower()
        try:
            driver = os.path.basename(os.readlink(card / "device" / "driver"))
        except OSError:
            driver = ""
        found.append((vendor, driver))
    return found


def chk_gpu():
    gpus = _gpus()
    if not gpus:
        return R("warn", "d-gpu-none")
    names = ", ".join(f"{_VENDORS.get(v, v or '?')} ({d or '—'})" for v, d in gpus)
    if not any(v in _VENDORS for v, _ in gpus):
        return R("info", "d-gpu-vm", gpus=names)
    if any(_VENDORS.get(v) == "NVIDIA" for v, _ in gpus):
        return R("warn", "d-gpu-nvidia", gpus=names)
    if any(v in _VENDORS and d not in _GOOD_DRIVERS for v, d in gpus):
        return R("warn", "d-gpu-nodriver", gpus=names)
    return R("ok", "d-gpu-ok", gpus=names)


_VULKAN = {"AMD": ("vulkan-radeon", "lib32-vulkan-radeon"), "Intel": ("vulkan-intel", "lib32-vulkan-intel")}


def chk_vulkan():
    vendors = sorted({_VENDORS.get(v) for v, _ in _gpus()} & set(_VULKAN))
    if not vendors:
        return R("info", "d-vulkan-na")
    pkgs = _installed_pkgs()
    if pkgs is None:
        return R("skip", "d-error", err="pacman -Qq")
    for v in vendors:
        p, p32 = _VULKAN[v]
        if p not in pkgs:
            return R("warn", "d-vulkan-noicd", pkg=p)
        if p32 not in pkgs:
            return R("warn", "d-vulkan-no32", pkg32=p32)
    return R("ok", "d-vulkan-ok", pkg=", ".join(_VULKAN[v][0] for v in vendors),
             pkg32=", ".join(_VULKAN[v][1] for v in vendors))


def chk_ucode():
    vendor = ""
    for line in _read(PROC / "cpuinfo").splitlines():
        if line.startswith("vendor_id"):
            vendor = line.split(":", 1)[1].strip()
            break
    pkg = {"GenuineIntel": "intel-ucode", "AuthenticAMD": "amd-ucode"}.get(vendor)
    if not pkg:
        return R("info", "d-ucode-unknown")
    have = _installed_pkgs()
    if have is None:
        return R("skip", "d-error", err="pacman -Qq")
    if pkg not in have or not (BOOT / f"{pkg}.img").exists():
        return R("warn", "d-ucode-warn", pkg=pkg)
    rev = _read(SYS / "devices" / "system" / "cpu" / "cpu0" / "microcode" / "version").strip() or "?"
    return R("ok", "d-ucode-ok", pkg=pkg, rev=rev)


def chk_gaming():
    try:
        n = int(_read(PROC / "sys" / "vm" / "max_map_count").strip())
    except ValueError:
        return R("skip", "d-error", err="vm.max_map_count")
    return R("ok", "d-gaming-ok", n=n) if n >= 1048576 else R("warn", "d-gaming-warn", n=n)


def chk_net_route():
    iface = _default_route()
    return R("ok", "d-net-route-ok", iface=iface) if iface else R("fail", "d-net-route-fail")


def chk_net_dns():
    if not _default_route():
        return R("skip", "d-skip-noroute")
    box = {}

    def go():
        t0 = time.time()
        try:
            socket.getaddrinfo("archlinux.org", 443, type=socket.SOCK_STREAM)
            box["ms"] = int((time.time() - t0) * 1000)
        except OSError as e:
            box["err"] = str(e)[:80]

    th = threading.Thread(target=go, daemon=True)  # getaddrinfo no tiene timeout propio
    th.start()
    th.join(5)
    if "ms" in box:
        return R("ok", "d-net-dns-ok", ms=box["ms"])
    return R("fail", "d-net-dns-fail", err=box.get("err", "timeout"))


def _first_mirror() -> str:
    for line in _read(ETC / "pacman.d" / "mirrorlist").splitlines():
        m = re.match(r"\s*Server\s*=\s*(\S+)", line)
        if m:
            return m.group(1).replace("$repo", "core").replace("$arch", "x86_64").rstrip("/") + "/core.db"
    return ""


def chk_net_mirror():
    url = _first_mirror()
    if not url:
        return R("skip", "d-error", err="mirrorlist")
    if not _default_route():
        return R("skip", "d-skip-noroute")
    ok, info = _probe(url)
    host = urllib.parse.urlsplit(url).hostname
    return R("ok", "d-net-mirror-ok", host=host, ms=info) if ok else R("warn", "d-net-mirror-warn", host=host, err=info)


def _avalos_repo_url() -> str:
    section = None
    for line in _read(ETC / "pacman.conf").splitlines():
        s = line.strip()
        if s.startswith("[") and s.endswith("]"):
            section = s[1:-1]
        elif section == "avalos":
            m = re.match(r"Server\s*=\s*(\S+)", s)
            if m:
                return m.group(1).replace("$repo", "avalos").replace("$arch", "x86_64").rstrip("/")
    return ""


def chk_net_avalos():
    base = _avalos_repo_url()
    if not base:
        return R("warn", "d-net-avalos-norepo")
    if not _default_route():
        return R("skip", "d-skip-noroute")
    ok, info = _probe(base + "/avalos.db")
    host = urllib.parse.urlsplit(base).hostname
    return R("ok", "d-net-avalos-ok", host=host, ms=info) if ok else R("warn", "d-net-avalos-warn", host=host, err=info)


def chk_apps():
    missing = []
    for app in AVALOS_APPS:
        p = BIN_DIR / app
        if not (p.is_file() and os.access(p, os.X_OK)):
            missing.append(app)
        if app in NEEDS_DESKTOP:
            if not (APPS_DIR / f"{app}.desktop").is_file():
                missing.append(f"{app}.desktop")
            if not (ICON_DIR / f"{app}.svg").is_file():
                missing.append(f"{app}.svg")
    if missing:
        shown = ", ".join(missing[:6]) + (f" … (+{len(missing) - 6})" if len(missing) > 6 else "")
        return R("warn", "d-apps-warn", "avalos-update", missing=shown)
    return R("ok", "d-apps-ok", n=len(AVALOS_APPS))


_PIN_RE = re.compile(r'^AVALOS_SYNC_REF\s*=\s*"([0-9a-f]{40})"', re.M)


def chk_sync():
    pins = {}
    for app in ("avalos-update-helper", "avalos-update"):
        m = _PIN_RE.search(_read(BIN_DIR / app))
        pins[app] = m.group(1)[:7] if m else ""
    if not all(pins.values()):
        return R("skip", "d-error", err="AVALOS_SYNC_REF")
    a, b = pins["avalos-update-helper"], pins["avalos-update"]
    if a != b:
        return R("warn", "d-sync-mismatch", "avalos-update", a=a, b=b)
    return R("ok", "d-sync-ok", sha=a)


# (id, grupo, función, ¿toca la red?) — el orden es el del informe
CHECKS = [
    ("kernel", "system", chk_kernel, False),
    ("boot-files", "system", chk_boot_files, False),
    ("time-sync", "system", chk_time_sync, False),
    ("disk-root", "storage", chk_disk_root, False),
    ("btrfs-meta", "storage", chk_btrfs_meta, False),
    ("btrfs-errors", "storage", chk_btrfs_errors, False),
    ("esp", "storage", chk_esp, False),
    ("snapshots", "storage", chk_snapshots, False),
    ("pacman-lock", "packages", chk_pacman_lock, False),
    ("pacnew", "packages", chk_pacnew, False),
    ("mirrors", "packages", chk_mirrors, False),
    ("units", "packages", chk_units, False),
    ("gpu", "hardware", chk_gpu, False),
    ("vulkan", "hardware", chk_vulkan, False),
    ("ucode", "hardware", chk_ucode, False),
    ("gaming", "hardware", chk_gaming, False),
    ("net-route", "network", chk_net_route, False),
    ("net-dns", "network", chk_net_dns, True),
    ("net-mirror", "network", chk_net_mirror, True),
    ("net-avalos", "network", chk_net_avalos, True),
    ("apps", "avalos", chk_apps, False),
    ("sync", "avalos", chk_sync, False),
]

# ── Motor: corre todo en paralelo y arma el informe ya traducido ───────────
_STATUS_ORDER = ("fail", "warn", "info", "skip", "ok")


def _fmt(T, key, args):
    try:
        return T[key].format(**args)
    except (KeyError, IndexError, ValueError):
        return f"{key} {args}"


def run_checks(lang=None, network=True):
    T = STRINGS.get(lang or LANG, STRINGS["en"])
    with _LOCK:
        _CACHE.clear()
    pool = ThreadPoolExecutor(max_workers=8)
    futs = [(c, pool.submit(c[2])) for c in CHECKS if network or not c[3]]
    findings = []
    for (cid, group, _fn, _net), fut in futs:
        try:
            status, key, args, action = fut.result(timeout=25)
        except Exception as e:  # noqa: BLE001 — un chequeo roto no puede tirar el informe
            status, key, args, action = "skip", "d-error", {"err": f"{type(e).__name__}: {e}"[:100]}, None
        act = None
        if action in OPEN_WHITELIST and status in ("warn", "fail"):
            act = {"app": action, "label": T[OPEN_WHITELIST[action]]}
        findings.append({"id": cid, "group": group, "gname": T["g-" + group], "status": status,
                         "title": T["t-" + cid], "detail": _fmt(T, key, args), "action": act})
    pool.shutdown(wait=False, cancel_futures=True)  # un hilo colgado no frena el informe
    summary = {s: sum(1 for f in findings if f["status"] == s) for s in _STATUS_ORDER}
    return {"findings": findings, "summary": summary, "when": time.strftime("%Y-%m-%d %H:%M"),
            "kernel": os.uname().release, "lang": lang or LANG}


_MARK = {"ok": " OK ", "info": "INFO", "skip": "SKIP", "warn": "WARN", "fail": "FAIL"}
_ANSI = {"ok": "32", "info": "34", "skip": "90", "warn": "33", "fail": "31"}


def format_report(res, lang=None, color=False):
    T = STRINGS.get(lang or res.get("lang") or LANG, STRINGS["en"])
    s = res["summary"]
    lines = [f"{T['report-title']} — {res['when']} — kernel {res['kernel']}",
             _fmt(T, "summary", {"ok": s["ok"], "warn": s["warn"], "fail": s["fail"]}), ""]
    for st in _STATUS_ORDER:
        for f in res["findings"]:
            if f["status"] != st:
                continue
            mark = f"[{_MARK[st]}]"
            if color:
                mark = f"\033[{_ANSI[st]}m{mark}\033[0m"
            lines.append(f"{mark} {f['title']} ({f['id']}): {f['detail']}")
    return "\n".join(lines)


def exit_code(res) -> int:
    s = res["summary"]
    return 2 if s["fail"] else 1 if s["warn"] else 0


# ── API expuesta a la ventana ──────────────────────────────────────────────
class DoctorAPI:
    window = None

    def __init__(self):
        self._lock = threading.Lock()
        self._last = None

    def run(self):
        with self._lock:
            self._last = run_checks(LANG)
            return self._last

    def copy_report(self):
        T = STRINGS[LANG]
        if not self._last:
            return {"ok": False, "msg": ""}
        text = format_report(self._last, LANG)
        for cmd in (["wl-copy"], ["xclip", "-selection", "clipboard"]):
            if shutil.which(cmd[0]):
                try:
                    subprocess.run(cmd, input=text, text=True, timeout=5, check=True)
                    return {"ok": True, "msg": T["copied"]}
                except (OSError, subprocess.SubprocessError):
                    continue
        path = Path.home() / "avalos-doctor-report.txt"
        try:
            path.write_text(text + "\n", encoding="utf-8")
        except OSError as e:
            return {"ok": False, "msg": str(e)}
        return {"ok": True, "msg": T["saved"].format(path=path)}

    def open_app(self, name):
        # Lista cerrada: la página nunca puede lanzar otra cosa que estas dos apps.
        if name not in OPEN_WHITELIST or not shutil.which(name):
            return False
        try:
            subprocess.Popen([name], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return True
        except OSError:
            return False

    def close(self):
        if self.window:
            self.window.destroy()


def _build_html():
    return r"""<!DOCTYPE html>
