<script>
const T = STRINGS_PLACEHOLDER;
const el = id => document.getElementById(id);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
const fmt = (s, o) => String(s).replace(/\{(\w+)\}/g, (m, k) => (k in o ? o[k] : m));
let busy = false, toastTimer = null;

function row(f) {
  const act = f.action ? `<button class="btn" data-app="${esc(f.action.app)}">${esc(f.action.label)}</button>` : '';
  return `<div class="row st-${esc(f.status)}"><span class="dot"></span><div class="info">` +
         `<div class="ttl">${esc(f.title)}<span class="grp">${esc(f.gname)}</span></div>` +
         `<div class="det">${esc(f.detail)}</div></div>${act}</div>`;
}

function render(d) {
  const bad = f => f.status === 'fail' || f.status === 'warn';
  const att = d.findings.filter(bad).sort((a, b) => (a.status === 'fail' ? 0 : 1) - (b.status === 'fail' ? 0 : 1));
  const rest = d.findings.filter(f => !bad(f));
  const s = d.summary;
  const b = el('banner');
  b.className = 'banner ' + (s.fail ? 'fail' : s.warn ? 'warn' : 'ok');
  b.innerHTML = `<span class="msg">${esc(att.length ? fmt(T['attention'], {n: att.length}) : '✓ ' + T['all-ok'])}</span>` +
                `<span class="cnt">${esc(fmt(T['summary'], s))}</span>`;
  el('attTitle').textContent = T['sec-attention'];
  el('attTitle').classList.toggle('hidden', !att.length);
  el('attList').innerHTML = att.map(row).join('');
  el('restSum').textContent = fmt(T['sec-rest'], {n: rest.length});
  el('restList').innerHTML = rest.map(row).join('');
  const det = el('rest');
  det.classList.toggle('hidden', !rest.length);
  if (att.length) det.removeAttribute('open'); else det.setAttribute('open', '');
  el('loading').classList.add('hidden');
  el('result').classList.remove('hidden');
}

async function run() {
  if (busy) return;
  busy = true;
  el('loading').textContent = T['running'];
  el('loading').classList.remove('hidden');
  el('result').classList.add('hidden');
  el('banner').classList.add('hidden');
  el('runBtn').disabled = true;
  el('copyBtn').disabled = true;
  try {
    render(await pywebview.api.run());
    el('copyBtn').disabled = false;
  } catch (e) {
    el('loading').textContent = String(e);
  }
  el('runBtn').disabled = false;
  busy = false;
}

function toast(msg) {
  const t = el('toast');
  t.textContent = msg;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { t.textContent = ''; }, 5000);
}

async function copyReport() {
  const r = await pywebview.api.copy_report();
  if (r && r.msg) toast(r.msg);
}

el('runBtn').textContent = T['run'];
el('copyBtn').textContent = T['copy'];
el('closeBtn').textContent = T['close'];
el('runBtn').addEventListener('click', run);
el('copyBtn').addEventListener('click', copyReport);
el('closeBtn').addEventListener('click', () => pywebview.api.close());
document.addEventListener('click', e => {
  const b = e.target.closest('button[data-app]');
  if (b) pywebview.api.open_app(b.dataset.app);
});
window.addEventListener('pywebviewready', run);
</script>
</body>
</html>"""


def _gui():
    import webview  # solo la ventana lo necesita: --text sigue andando sin pywebview
    T = STRINGS[LANG]
    html = (_build_html()
            .replace("LANG_PLACEHOLDER", _HTML_LANG.get(LANG, LANG))
            .replace("STR_TITLE", T["title"])
            .replace("STR_SUBTITLE", T["subtitle"])
            .replace("STRINGS_PLACEHOLDER", json.dumps(T, ensure_ascii=False)))

    # Mismo fix que avalos-update/avalos-restore: sin esto GTK usa "python3" como app_id en Wayland
    # y la window rule (class = "avalos-doctor") nunca matchea.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-doctor")
    except Exception:
        pass

    api = DoctorAPI()
    win = webview.create_window(
        title            = f"AvalOS — {T['title']}",
        html             = html,
        js_api           = api,
        width            = 700,
        height           = 720,
        min_size         = (520, 480),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win
    try:
        webview.start(debug=False)
    except Exception as e:  # noqa: BLE001
        print(f"ERROR al iniciar pywebview: {e}", file=sys.stderr)
        return 1
    return 0


def main(argv=None):
    global LANG
    ap = argparse.ArgumentParser(prog="avalos-doctor", description="AvalOS system health check (read-only).")
    ap.add_argument("--text", action="store_true", help="print the report to the console")
    ap.add_argument("--json", action="store_true", help="print the report as JSON")
    ap.add_argument("--gui", action="store_true", help="force the window")
    ap.add_argument("--no-network", action="store_true", help="skip the checks that need Internet")
    ap.add_argument("--lang", choices=_SUPPORTED, help="language of the report")
    a = ap.parse_args(argv)
    if a.lang:
        LANG = a.lang
    has_display = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    if a.gui or (not a.text and not a.json and has_display):
        return _gui()
    res = run_checks(LANG, network=not a.no_network)
    print(json.dumps(res, ensure_ascii=False, indent=2) if a.json
          else format_report(res, LANG, color=sys.stdout.isatty()))
    return exit_code(res)


if __name__ == "__main__":
    sys.exit(main())
