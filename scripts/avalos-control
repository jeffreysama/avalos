  .fact .k { color: var(--text-dim); font-size: 11px; }
  .fact .v { margin-top: 3px; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap; }

  .health { background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; }
