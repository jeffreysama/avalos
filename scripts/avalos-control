# ── Resumen del equipo (solo lectura, sin subprocesos) ─────────────────────
NA = "—"


def _read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def _gib(kib: float) -> float:
    return kib / (1024 * 1024)


def _os_name() -> str:
    for line in _read(OS_RELEASE).splitlines():
        key, _, value = line.partition("=")
        if key == "PRETTY_NAME":
            return value.strip().strip('"\'') or "AvalOS"
    return "AvalOS"


def _cpu_model() -> str:
    for line in _read(PROC / "cpuinfo").splitlines():
        key, _, value = line.partition(":")
        if key.strip() == "model name":
            return " ".join(value.split()) or NA
    return NA


def _memory() -> str:
    values = {}
    for line in _read(PROC / "meminfo").splitlines():
        key, _, rest = line.partition(":")
        parts = rest.split()
        if key in ("MemTotal", "MemAvailable") and parts and parts[0].isdigit():
            values[key] = int(parts[0])
    total, avail = values.get("MemTotal"), values.get("MemAvailable")
    if not total or avail is None:
        return NA
    return f"{_gib(total - avail):.1f} / {_gib(total):.1f} GiB"


def _disk() -> str:
    try:
        usage = shutil.disk_usage(ROOT_FS)
    except OSError:
        return NA
    if not usage.total:
        return NA
    gib = 1024 ** 3
    return f"{usage.used / gib:.0f} / {usage.total / gib:.0f} GiB ({usage.used * 100 // usage.total}%)"


def _uptime() -> str:
    try:
        seconds = int(float(_read(PROC / "uptime").split()[0]))
    except (IndexError, ValueError):
        return NA
    days, rest = divmod(seconds, 86400)
    hours, rest = divmod(rest, 3600)
    minutes = rest // 60
    if days:
        return f"{days}d {hours}h"
    if hours:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"


def system_info() -> dict:
    """Los datos de la tarjeta «de un vistazo». Nunca lanza: lo que no se pueda leer sale «—»."""
    return {
        "os": _os_name(),
        "kernel": platform.release() or NA,
        "cpu": _cpu_model(),
        "memory": _memory(),
        "disk": _disk(),
        "uptime": _uptime(),
    }


# ── Salud (la calcula avalos-doctor) ───────────────────────────────────────
def health_summary() -> dict:
    """Corre `avalos-doctor --json` (solo lectura) y lo reduce a lo que muestra la tarjeta:
    {"state": "missing"|"error"|"done", "ok", "warn", "fail", "issues": [{"title", "status"}]}."""
    exe = shutil.which("avalos-doctor")
    if not exe:
        return {"state": "missing"}
    try:
        res = subprocess.run([exe, "--json", "--no-network", "--lang", LANG], capture_output=True,
                             text=True, timeout=DOCTOR_TIMEOUT, stdin=subprocess.DEVNULL)
        data = json.loads(res.stdout)
        summary = data["summary"]
        findings = data.get("findings") or []
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        return {"state": "error"}
    if not isinstance(summary, dict) or not isinstance(findings, list):
        return {"state": "error"}
    order = {"fail": 0, "warn": 1}
    problems = sorted((f for f in findings if isinstance(f, dict) and f.get("status") in order),
                      key=lambda f: order[f["status"]])
    return {
        "state": "done",
        "ok": int(summary.get("ok", 0)),
        "warn": int(summary.get("warn", 0)),
        "fail": int(summary.get("fail", 0)),
        "issues": [{"title": str(f.get("title", "")), "status": f["status"]} for f in problems[:MAX_ISSUES]],
    }


# ── Lanzar apps ────────────────────────────────────────────────────────────
def _spawn(cmd) -> bool:
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def _has_display() -> bool:
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


def available_tiles() -> dict:
    """Qué lanzadores existen en este sistema (los viejos no tienen todo hasta la próxima sync)."""
    return {tid: bool(shutil.which(argv[0])) for tid, argv in TILE_ARGV.items()}


# ── API expuesta a la ventana ──────────────────────────────────────────────
class ControlAPI:
    window = None

    def info(self):
        return system_info()

    def available(self):
        return available_tiles()

    def open_tile(self, tile_id):
        argv = TILE_ARGV.get(tile_id) if isinstance(tile_id, str) else None
        if not argv or not shutil.which(argv[0]):
            return False
        return _spawn(list(argv))

    def health(self):
        return health_summary()

    def close(self):
        if self.window:
            self.window.destroy()


