#!/usr/bin/env python3
# ── AvalOS — avalos-control ─────────────────────────────────────────
# Centro de control de AvalOS: un solo lugar desde donde abrir los ajustes del sistema y las
# apps de AvalOS (actualizar, restaurar, salud, tienda, fondo, pantallas, audio, red...), con
# un resumen del equipo y la salud del sistema bajo demanda. Solo abre otras apps y lee datos
# del sistema: no necesita root ni polkit y no cambia nada.
#
#   avalos-control          abre la ventana (Super+Alt+C, o desde el menú de Settings)
#   avalos-control --json   imprime el resumen del equipo y qué apps hay, y sale (soporte)
#
# La salud la calcula avalos-doctor (solo lectura) cuando el usuario pulsa «Revisar ahora»: abrir
# esta ventana nunca lanza los 20 chequeos por su cuenta.
#
# Requiere: python 3.9+, python-pywebview, webkit2gtk-4.1 y python-gobject (ya los
# instala el instalador).
import argparse
import json
import os
import platform
import shutil
import subprocess
import sys
from pathlib import Path

# ── Rutas del sistema (se pueden redirigir en las pruebas) ─────────────────
PROC = Path("/proc")
OS_RELEASE = Path("/etc/os-release")
ROOT_FS = "/"

# ── i18n — mismo patrón que avalos-doctor/avalos-welcome ───────────────────
_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")
_HTML_LANG = {"zh": "zh-CN"}


def _detectar_idioma() -> str:
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

# Grupos, en el orden en que salen en pantalla. Texto del título: grp-<id>.
GROUPS = ("system", "apps", "look", "hardware", "session")

# Lanzadores: (grupo, id, comando, icono). Lista cerrada: la página nunca puede lanzar otra
# cosa que estos comandos exactos. Textos: t-<id> (nombre) y d-<id> (descripción).
# scripts/validate_app_consistency.py lee esta lista tal cual (tiene que ser un literal de
# Python) y comprueba que cada comando existe en el repo o lo trae un paquete que el
# instalador instala, y que no hay ids repetidos ni textos sin traducir.
TILES = [
    ("system", "update", ("avalos-update",), "🔄"),
    ("system", "restore", ("avalos-restore",), "⏪"),
    ("system", "doctor", ("avalos-doctor",), "🩺"),
    ("system", "about", ("avalos-about",), "ℹ️"),
    ("apps", "games", ("avalos-gamecenter",), "🎮"),
    ("apps", "store", ("avalos-store",), "🛍️"),
    ("look", "wallpaper", ("avalos-wallpaper",), "🖼️"),
    ("look", "appearance", ("nwg-look",), "🎨"),
    ("hardware", "displays", ("nwg-displays",), "🖥️"),
    ("hardware", "audio", ("pavucontrol",), "🔊"),
    ("hardware", "network", ("nm-connection-editor",), "📶"),
    ("hardware", "bluetooth", ("blueman-manager",), "🔵"),
    ("session", "files", ("thunar",), "📁"),
    ("session", "account", ("kitty", "--title", "AvalOS — passwd", "--", "passwd"), "🔑"),
    ("session", "welcome", ("avalos-welcome",), "👋"),
]
TILE_ARGV = {tid: argv for _g, tid, argv, _i in TILES}

# Datos del resumen del equipo (claves de system_info()). Texto de la etiqueta: f-<clave>.
FACTS = ("os", "kernel", "cpu", "memory", "disk", "uptime")

# Cuántos problemas se listan bajo el resumen de salud (los demás se ven en el Doctor).
MAX_ISSUES = 5
DOCTOR_TIMEOUT = 90

