#!/usr/bin/env python3
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║  avalos-store — Tienda de software de AvalOS                        ║
# ║  Catálogo curado de juegos, aplicaciones y utilidades, instalables   ║
# ║  vía pacman, AUR (yay/paru) o Flatpak.                               ║
# ║  Mismo patrón que avalos-wallpaper: pywebview + HTML/CSS/JS          ║
# ║  embebido en este mismo archivo, i18n leído de /etc/avalos-lang.     ║
# ║  Soporta: English · Español · 中文简体 · 日本語                      ║
# ╚═══════════════════════════════════════════════════════════════════════╝
#
# Requiere: python-pywebview, webkit2gtk-4.1, python-gobject
# (ya están en HYPRLAND_PKGS por avalos-wallpaper — no hace falta tocar
# el instalador para esto).
#
# Catálogo: busca avalos-store-catalog.json junto a este script primero,
# y si no está, en las rutas del sistema listadas en CATALOG_CANDIDATES.
# Es un JSON plano a propósito — agregar/editar apps no debería requerir
# tocar este .py.
import base64
import json
