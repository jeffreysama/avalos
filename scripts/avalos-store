    import webview
except ImportError:
    print("ERROR: pywebview no está instalado.")
    print("Instala con: pacman -S python-pywebview webkit2gtk-4.1 python-gobject")
    sys.exit(1)

SCRIPT_DIR = Path(__file__).resolve().parent
CATALOG_CANDIDATES = [
    SCRIPT_DIR / "avalos-store-catalog.json",
    Path("/usr/share/avalos-store/avalos-store-catalog.json"),
    Path("/usr/local/share/avalos-store/avalos-store-catalog.json"),
]
TERMINALS = ("kitty", "foot", "alacritty", "xterm")
AUR_HELPERS = ("yay", "paru")
AUR_RPC_URL = "https://aur.archlinux.org/rpc/v5/info"
CATEGORIES = ("games", "apps", "utils")

_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")


def _detectar_idioma() -> str:
    # Fuente de verdad: /etc/avalos-lang, el idioma real elegido en el
    # instalador (chooseLang -> set_language -> self._lang). NO es el
    # locale regional (LANG=es_MX.UTF-8...) — mismo criterio que
    # avalos-about / avalos-settings / avalos-wallpaper.
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

_AVALOS_PROFILE_FILE = Path("/etc/avalos-profile")


def _leer_perfil_instalacion() -> set[str]:
    # /etc/avalos-profile: una flag por línea (ej. "gaming"), escrita por
    # el instalador según los checkboxes que el usuario marcó (chk-gaming,
    # chk-bore). Mismo espíritu que avalos-lang: un archivo, una fuente de
    # verdad. Si el instalador todavía no la escribe (versión vieja), esto
    # simplemente devuelve un set vacío y la Store se comporta como antes.
    try:
        texto = _AVALOS_PROFILE_FILE.read_text(encoding="utf-8")
        return {linea.strip() for linea in texto.splitlines() if linea.strip()}
    except OSError:
        return set()


PERFIL_INSTALACION = _leer_perfil_instalacion()

