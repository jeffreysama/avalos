<script>
let T = {};
let STATE = {
  apps: [], installedIds: new Set(), lang: 'en', hasFlatpak: true, hasAurHelper: null,
  category: 'all', query: '', openAppId: null, progress: {}, logs: {}, iconCache: {}, iconPending: {},
  detailsFetching: new Set(),
};
let pollTimer = null;

function tr(key, vars) {
  let s = T[key] || key;
  if (vars) for (const k in vars) s = s.split('{' + k + '}').join(vars[k]);
  return s;
}

function localized(obj) {
  if (!obj) return '';
  return obj[STATE.lang] || obj.en || obj.es || '';
}

function setup() {
  document.title = T.title;
  document.getElementById('search').placeholder = T.search_placeholder;
  document.getElementById('refreshBtn').title = T.refresh;
  renderCatbar();
  renderGrid();
}

function renderCatbar() {
  const bar = document.getElementById('catbar');
  bar.innerHTML = '';
  const cats = [
    ['all', T.nav_all], ['games', T.nav_games], ['apps', T.nav_apps],
    ['utils', T.nav_utils], ['installed', T.nav_installed],
  ];
  for (const [id, label] of cats) {
    const btn = document.createElement('button');
    btn.className = 'cat-btn' + (STATE.category === id ? ' active' : '');
    btn.textContent = label;
    btn.addEventListener('click', () => { STATE.category = id; renderCatbar(); renderGrid(); });
    bar.appendChild(btn);
  }
}

function matchesQuery(app, q) {
  if (!q) return true;
  q = q.toLowerCase();
  const hay = [
    app.name, localized(app.short_desc), (app.short_desc && app.short_desc.en) || '',
    (app.tags || []).join(' '),
  ].join(' ').toLowerCase();
  return hay.includes(q);
}

function filteredApps() {
  return STATE.apps.filter(app => {
    if (STATE.category === 'installed') { if (!STATE.installedIds.has(app.id)) return false; }
    else if (STATE.category !== 'all' && app.category !== STATE.category) return false;
    return matchesQuery(app, STATE.query);
  });
}

function renderGrid() {
  const grid = document.getElementById('grid');
  const count = document.getElementById('count');
  const apps = filteredApps();
  grid.innerHTML = '';
  count.textContent = (apps.length === 1 ? T.found_one : T.found_many).replace('{n}', apps.length);

  if (apps.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = '<div class="big">🔍</div><div class="t">' + T.empty_title + '</div><div class="b">' + T.empty_body + '</div>';
    grid.appendChild(empty);
    return;
  }
  for (const app of apps) grid.appendChild(buildCard(app));
}

function setCardIcon(iconWrap, app) {
  iconWrap.dataset.iconFor = app.id;
  iconWrap.dataset.fallbackEmoji = app.icon || '📦';
  iconWrap.textContent = app.icon || '📦';
  if (STATE.iconCache[app.id]) {
    applyIconDataUri(iconWrap, STATE.iconCache[app.id]);
    return;
  }
  if (STATE.iconPending[app.id]) return;
  STATE.iconPending[app.id] = true;
  const installed = STATE.installedIds.has(app.id);
  window.pywebview.api.get_icon(app.id, installed).then(raw => {
    delete STATE.iconPending[app.id];
    const res = JSON.parse(raw);
    if (res.ok && res.data_uri) {
      STATE.iconCache[app.id] = res.data_uri;
      document.querySelectorAll('[data-icon-for="' + app.id + '"]').forEach(el => applyIconDataUri(el, res.data_uri));
    }
  }).catch(() => { delete STATE.iconPending[app.id]; });
}

function applyIconDataUri(iconWrap, dataUri) {
  const existingCheck = iconWrap.querySelector('.check');
  // Fallback emoji guardado ANTES de vaciar el div: si dataUri resulta ser
  // un data: URI corrupto o truncado (cache en disco dañado, respuesta
  // parcial de Flathub), onerror necesita algo a lo que volver — sin esto,
  // el fallback quedaba en un div completamente vacío en vez del emoji.
  const fallbackEmoji = iconWrap.dataset.fallbackEmoji || iconWrap.textContent || '📦';
  iconWrap.dataset.fallbackEmoji = fallbackEmoji;
  const img = document.createElement('img');
  img.src = dataUri;
  img.alt = '';
  img.onerror = () => {
    img.remove();
    iconWrap.textContent = fallbackEmoji;
    if (existingCheck) iconWrap.appendChild(existingCheck);
  };
  iconWrap.textContent = '';
  iconWrap.appendChild(img);
  if (existingCheck) iconWrap.appendChild(existingCheck);
}

function buildCard(app) {
  const card = document.createElement('div');
  card.className = 'card';
  card.addEventListener('click', (e) => { if (!e.target.closest('button')) openModal(app.id); });

  const top = document.createElement('div');
  top.className = 'card-top';
  const iconWrap = document.createElement('div');
  iconWrap.className = 'card-icon';
  setCardIcon(iconWrap, app);
  if (STATE.installedIds.has(app.id)) {
    const check = document.createElement('div');
    check.className = 'check';
    check.textContent = '✓';
    iconWrap.appendChild(check);
  }
  const badge = document.createElement('span');
  badge.className = 'badge badge-' + app.source;
  badge.textContent = T['badge_' + app.source] || app.source;
  const badgeCol = document.createElement('div');
  badgeCol.className = 'badge-col';
  badgeCol.appendChild(badge);
  if (STATE.installedIds.has(app.id)) {
    const installedBadge = document.createElement('span');
    installedBadge.className = 'badge badge-installed';
    installedBadge.textContent = T.installed_label;
    badgeCol.appendChild(installedBadge);
  }
  top.appendChild(iconWrap);
  top.appendChild(badgeCol);

  const body = document.createElement('div');
  const h3 = document.createElement('h3');
  h3.textContent = app.name;
  const desc = document.createElement('p');
  desc.className = 'desc';
  desc.textContent = localized(app.short_desc);
  body.appendChild(h3);
  body.appendChild(desc);

  const footer = document.createElement('div');
  footer.className = 'card-footer';
  footer.appendChild(buildActionArea(app.id));

  card.appendChild(top);
  card.appendChild(body);
  card.appendChild(footer);
  return card;
}

function buildActionArea(appId) {
  const wrap = document.createElement('div');
  const prog = STATE.progress[appId];
  const installed = STATE.installedIds.has(appId);
  const busy = prog && (prog.status === 'installing' || prog.status === 'external');

  if (busy) {
    wrap.className = 'progress-row';
    const dot = document.createElement('span'); dot.className = 'dot';
    const label = document.createElement('span');
    label.textContent = prog.status === 'external' ? T.done_external
      : (prog.action === 'uninstall' ? T.status_uninstalling : T.status_installing);
    wrap.appendChild(dot); wrap.appendChild(label);
    return wrap;
  }

  if (installed) {
    wrap.className = 'installed-row';
    const openBtn = document.createElement('button');
    openBtn.className = 'btn btn-primary'; openBtn.textContent = T.btn_open;
    openBtn.addEventListener('click', (e) => { e.stopPropagation(); doLaunch(appId); });
    const delBtn = document.createElement('button');
    delBtn.className = 'btn btn-danger-ghost'; delBtn.textContent = '🗑'; delBtn.title = T.btn_uninstall;
    delBtn.addEventListener('click', (e) => { e.stopPropagation(); doUninstall(appId); });
    wrap.appendChild(openBtn); wrap.appendChild(delBtn);
    return wrap;
  }

  const btn = document.createElement('button');
  btn.className = 'btn btn-primary'; btn.textContent = T.btn_install;
  btn.addEventListener('click', (e) => { e.stopPropagation(); doInstall(appId); });
  wrap.appendChild(btn);
  return wrap;
}

function openModal(appId) {
  STATE.openAppId = appId;
  const app = STATE.apps.find(a => a.id === appId);
  if (!app._extra) {
    STATE.detailsFetching.add(appId);
  }
  renderModal();
  document.getElementById('modalOverlay').classList.add('open');
  window.pywebview.api.details(appId).then(raw => {
    const res = JSON.parse(raw);
    STATE.detailsFetching.delete(appId);
    if (res.ok && STATE.openAppId === appId) {
      const app = STATE.apps.find(a => a.id === appId);
      app._extra = res.extra;
      renderModal();
    } else if (STATE.openAppId === appId) {
      renderModal();
    }
  }).catch(() => {
    STATE.detailsFetching.delete(appId);
    if (STATE.openAppId === appId) renderModal();
  });
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  STATE.openAppId = null;
}

function addMeta(grid, label, value, isLink) {
  if (!value) return;
  const kd = document.createElement('div'); kd.className = 'k'; kd.textContent = label;
  const vd = document.createElement('div'); vd.className = 'v';
  if (isLink) {
    const a = document.createElement('a'); a.href = value; a.target = '_blank';
    a.textContent = value.replace(/^https?:\/\//, '');
    vd.appendChild(a);
  } else {
    vd.textContent = value;
  }
  grid.appendChild(kd); grid.appendChild(vd);
}

function buildModalActionButtons(app) {
  const wrap = document.createElement('div');
  wrap.style.display = 'flex'; wrap.style.gap = '8px'; wrap.style.flex = '1';
  const installed = STATE.installedIds.has(app.id);
  const prog = STATE.progress[app.id];
  const busy = prog && (prog.status === 'installing' || prog.status === 'external');

  if (installed) {
    const openBtn = document.createElement('button');
    openBtn.className = 'btn btn-primary'; openBtn.textContent = T.btn_open;
    openBtn.addEventListener('click', () => doLaunch(app.id));
    const delBtn = document.createElement('button');
    delBtn.className = 'btn btn-danger-ghost'; delBtn.textContent = T.btn_uninstall;
    delBtn.disabled = busy;
    delBtn.addEventListener('click', () => doUninstall(app.id));
    wrap.appendChild(openBtn); wrap.appendChild(delBtn);
  } else {
    const btn = document.createElement('button');
    btn.className = 'btn btn-primary'; btn.textContent = T.btn_install;
    btn.disabled = busy;
    btn.addEventListener('click', () => doInstall(app.id));
    wrap.appendChild(btn);
  }
  return wrap;
}

function renderModal() {
  const appId = STATE.openAppId;
  if (!appId) return;
  const app = STATE.apps.find(a => a.id === appId);
  if (!app) return;
  const modal = document.getElementById('modal');
  modal.innerHTML = '';

  const head = document.createElement('div'); head.className = 'modal-head';
  const icon = document.createElement('div'); icon.className = 'modal-icon';
  setCardIcon(icon, app);
  const titles = document.createElement('div'); titles.className = 'modal-titles';
  const h2 = document.createElement('h2'); h2.textContent = app.name;
  const sub = document.createElement('div'); sub.className = 'sub'; sub.textContent = localized(app.short_desc);
  titles.appendChild(h2); titles.appendChild(sub);
  const closeBtn = document.createElement('button'); closeBtn.className = 'modal-close'; closeBtn.innerHTML = '✕';
  closeBtn.title = T.btn_close;
  closeBtn.addEventListener('click', closeModal);
  head.appendChild(icon); head.appendChild(titles); head.appendChild(closeBtn);
  modal.appendChild(head);

  const p = document.createElement('p'); p.className = 'long'; p.textContent = localized(app.long_desc);
  modal.appendChild(p);

  const extra = app._extra || {};
  if (STATE.detailsFetching.has(appId)) {
    const fetching = document.createElement('div');
    fetching.className = 'fetching-line';
    fetching.textContent = T.status_fetching;
    modal.appendChild(fetching);
  }
  const mgrid = document.createElement('div'); mgrid.className = 'meta-grid';
  addMeta(mgrid, T.label_developer, app.developer);
  addMeta(mgrid, T.label_license, app.license);
  addMeta(mgrid, T.label_source, T['badge_' + app.source] || app.source);
  addMeta(mgrid, T.label_package, app.package);
  addMeta(mgrid, T.label_version, extra.live_version);
  addMeta(mgrid, T.label_size, extra.live_download_size);
  if (app.source === 'aur') {
    addMeta(mgrid, T.label_aur_votes, extra.aur_votes != null ? String(extra.aur_votes) : '');
    addMeta(mgrid, T.label_aur_maintainer, extra.aur_maintainer);
  }
  addMeta(mgrid, T.label_website, app.website, true);
  modal.appendChild(mgrid);

  if (app.note) {
    const note = document.createElement('div'); note.className = 'note-box';
    const s1 = document.createElement('span'); s1.textContent = 'ℹ️';
    const s2 = document.createElement('span');
    const strong = document.createElement('strong'); strong.textContent = T.label_note + ': ';
    s2.appendChild(strong);
    s2.appendChild(document.createTextNode(localized(app.note)));
    note.appendChild(s1); note.appendChild(s2);
    modal.appendChild(note);
  }

  const actions = document.createElement('div'); actions.className = 'modal-actions';
  actions.appendChild(buildModalActionButtons(app));
  modal.appendChild(actions);

  const prog = STATE.progress[appId];
  const logs = STATE.logs[appId] || [];
  if (prog || logs.length) {
    const logWrap = document.createElement('div'); logWrap.className = 'log-wrap';
    const pre = document.createElement('pre'); pre.className = 'log';
    pre.textContent = logs.join('\n');
    logWrap.appendChild(pre);
    const status = document.createElement('div');
    status.className = 'modal-status ' + (prog ? (prog.status === 'done' ? 'ok' : prog.status === 'error' ? 'err' : 'pending') : '');
    status.textContent = prog ? (prog.message || '') : '';
    logWrap.appendChild(status);
    modal.appendChild(logWrap);
    pre.scrollTop = pre.scrollHeight;
  }
}

async function doInstall(appId) {
  STATE.progress[appId] = { status: 'installing', action: 'install' };
  STATE.logs[appId] = [];
  renderGrid();
  if (STATE.openAppId === appId) renderModal();
  try { await window.pywebview.api.install(appId); } catch (e) {}
}

async function doUninstall(appId) {
  const app = STATE.apps.find(a => a.id === appId);
  const ok = confirm(tr('confirm_uninstall', { name: app ? app.name : appId }));
  if (!ok) return;
  STATE.progress[appId] = { status: 'installing', action: 'uninstall' };
  STATE.logs[appId] = [];
  renderGrid();
  if (STATE.openAppId === appId) renderModal();
  try { await window.pywebview.api.uninstall(appId); } catch (e) {}
}

async function doLaunch(appId) {
  try { await window.pywebview.api.launch(appId); } catch (e) {}
}

function onBackendEvent(packet) {
  const appId = packet.appId;
  if (packet.event === 'log') {
    if (!STATE.logs[appId]) STATE.logs[appId] = [];
    STATE.logs[appId].push(packet.message);
    if (STATE.openAppId === appId) renderModal();
  } else if (packet.event === 'finish') {
    const status = packet.external ? 'external' : (packet.ok ? 'done' : 'error');
    STATE.progress[appId] = { status: status, message: packet.message, action: packet.action };
    if (packet.ok && !packet.external) {
      if (packet.action === 'install') STATE.installedIds.add(appId);
      if (packet.action === 'uninstall') STATE.installedIds.delete(appId);
    }
    renderGrid();
    if (STATE.openAppId === appId) renderModal();
    ensurePolling();
  }
}

function ensurePolling() {
  const anyPending = Object.values(STATE.progress).some(p => p.status === 'installing' || p.status === 'external');
  if (!anyPending || pollTimer) return;
  pollTimer = setInterval(async () => {
    try {
      const raw = await window.pywebview.api.refresh_installed();
      const data = JSON.parse(raw);
      STATE.installedIds = new Set(data.installed);
      for (const id of Object.keys(STATE.progress)) {
        const p = STATE.progress[id];
        if (p.status === 'external' && STATE.installedIds.has(id)) STATE.progress[id] = { status: 'done' };
      }
      renderGrid();
      if (STATE.openAppId) renderModal();
    } catch (e) {}
    const stillPending = Object.values(STATE.progress).some(p => p.status === 'installing' || p.status === 'external');
    if (!stillPending) { clearInterval(pollTimer); pollTimer = null; }
  }, 4000);
}

async function init() {
  const raw = await window.pywebview.api.list();
  const data = JSON.parse(raw);
  T = data.strings;
  STATE.apps = data.apps;
  STATE.installedIds = new Set(data.installed);
  STATE.lang = data.lang;
  STATE.hasFlatpak = data.has_flatpak;
  STATE.hasAurHelper = data.has_aur_helper;
  STATE.category = data.default_category || 'all';
  setup();

  document.getElementById('search').addEventListener('input', (e) => {
    STATE.query = e.target.value;
    renderGrid();
  });
  document.getElementById('refreshBtn').addEventListener('click', async (e) => {
    e.currentTarget.classList.add('spin');
    setTimeout(() => e.currentTarget.classList.remove('spin'), 650);
    try {
      const r2 = await window.pywebview.api.refresh_installed();
      const d2 = JSON.parse(r2);
      STATE.installedIds = new Set(d2.installed);
      renderGrid();
      if (STATE.openAppId) renderModal();
    } catch (err) {}
  });
  document.getElementById('modalOverlay').addEventListener('click', (e) => {
    if (e.target.id === 'modalOverlay') closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && STATE.openAppId) closeModal();
  });
}

window.addEventListener('pywebviewready', init);
window.avalosStore = { onBackendEvent: onBackendEvent };
</script>
</body>
</html>"""


def main():
    html = (_build_html()
            .replace("LANG_PLACEHOLDER", LANG)
            .replace("TITLE_PLACEHOLDER", T["title"].split("— ", 1)[-1]))

    # Mismo fix que avalos-wallpaper (BUG-012): sin esto, GTK usa "python3"
    # como app_id en Wayland y una window rule (class = "avalos-store")
    # nunca matchearía, así que la ventana no abriría flotante/centrada.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-store")
    except Exception:
        pass

    api = StoreAPI()
    win = webview.create_window(
        title            = T["title"],
        html             = html,
        js_api           = api,
        width            = 1200,
        height           = 780,
        min_size         = (900, 600),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win

    try:
        webview.start(debug=False)
    except Exception as e:
        print(f"ERROR al iniciar pywebview: {e}")
        print("Asegúrate de que webkit2gtk-4.1 esté instalado:")
        print("  pacman -S webkit2gtk-4.1 python-gobject")
        sys.exit(1)


if __name__ == "__main__":
    main()
