def load_catalog():
    for path in CATALOG_CANDIDATES:
        try:
            if path.is_file():
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                if isinstance(data, list):
                    return data
        except Exception:
            continue
    return []


CATALOG = load_catalog()


def app_by_id(app_id):
    return next((a for a in CATALOG if a.get("id") == app_id), None)


def find_aur_helper():
    for helper in AUR_HELPERS:
        if shutil.which(helper):
            return helper
    return None


def find_terminal():
    for term in TERMINALS:
        if shutil.which(term):
            return term
    return None


def spawn_terminal(term, title, argv):
    if term == "kitty":
        return subprocess.Popen([term, "--title", title, "--"] + list(argv))
    if term == "foot":
        return subprocess.Popen([term, "-T", title] + list(argv))
    return subprocess.Popen([term, "-e"] + list(argv))


def installed_snapshot():
    pacman_pkgs = set()
    try:
        r = subprocess.run(["pacman", "-Qq"], capture_output=True, text=True, timeout=10)
        pacman_pkgs = set(r.stdout.split())
    except Exception:
        pass
    flatpak_apps = set()
    if shutil.which("flatpak"):
        try:
            r = subprocess.run(
                ["flatpak", "list", "--app", "--columns=application"],
                capture_output=True, text=True, timeout=10,
            )
            flatpak_apps = set(r.stdout.split())
        except Exception:
            pass
    return pacman_pkgs, flatpak_apps


def installed_ids_from_snapshot(pacman_pkgs, flatpak_apps):
    ids = []
    for app in CATALOG:
        pkg = app.get("package", "")
        if app.get("source") == "flatpak":
            if pkg in flatpak_apps:
                ids.append(app["id"])
        elif pkg in pacman_pkgs:
            ids.append(app["id"])
    return ids


def parse_pacman_info(text):
    info = {}
    for line in text.splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        key, value = key.strip(), value.strip()
        if key == "Version":
            info["live_version"] = value
        elif key == "Download Size":
            info["live_download_size"] = value
        elif key == "Installed Size":
            info["live_installed_size"] = value
    return info


def fetch_aur_info(pkg):
    try:
        url = AUR_RPC_URL + "?" + urllib.parse.urlencode({"type": "info", "arg[]": pkg})
        req = urllib.request.Request(url, headers={"User-Agent": "avalos-store"})
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        results = data.get("results") or []
        return results[0] if results else None
    except Exception:
        return None


# ── Resolución de íconos reales ──────────────────────────────────────────
# Mismo principio que COSMIC Store/GNOME Software: nunca se "dibuja" un
# logo, se trae el ícono que el propio proyecto ya publica para esto.
#   1. Si la app está instalada, su ícono YA vive en el sistema de
#      archivos (así funciona el spec de iconos de FreeDesktop) — se lee
#      directo, cero red, cero dependencias nuevas.
#   2. Si no está instalada pero es Flatpak (o tiene flathub_id aunque se
#      instale por pacman/AUR), se trae de la API pública de Flathub y se
#      cachea en disco para no repetir la descarga cada vez que se abre
#      la Store.
#   3. Sin red (o Flathub sin respuesta) y sin AppStream —típicamente AUR,
#      que no tiene equivalente en Flathub ni metadata AppStream— se busca
#      en el TEMA DE ÍCONOS instalado (Papirus, en el paquete
#      papirus-icon-theme del instalador): trae íconos de miles de apps SIN
#      necesidad de tenerlas instaladas, a diferencia de hicolor, que solo
#      tiene lo que ya se instaló. Se busca por app["icon_name"] (opcional,
#      en el catálogo) y luego por exec, package e id.
#   4. Solo si tampoco hay eso, el frontend cae al emoji. Antes este paso
#      era el 3 y pasaba con casi todo lo que no estaba instalado y no tenía
#      flathub_id (Edge, Unity Hub, Postman, CoreCtrl, Btrfs Assistant...).
ICON_CACHE_DIR = Path.home() / ".cache" / "avalos-store" / "icons"
FLATHUB_APPSTREAM_URL = "https://flathub.org/api/v2/appstream/"

_HICOLOR_SIZES = ("128x128", "256x256", "96x96", "64x64", "48x48", "scalable")
_HICOLOR_ROOTS = (
    Path.home() / ".local" / "share" / "icons" / "hicolor",
    Path("/usr/share/icons/hicolor"),
    Path("/var/lib/flatpak/exports/share/icons/hicolor"),
    Path.home() / ".local" / "share" / "flatpak" / "exports" / "share" / "icons" / "hicolor",
)
_PIXMAP_ROOTS = (Path("/usr/share/pixmaps"),)

# Tema de íconos instalado (papirus-icon-theme). Layout: <size>/apps/<nombre>.svg
# (varios son symlinks a otro nombre dentro de la misma carpeta; Path.is_file()
# los sigue). Papirus trae 16/22/24/32/48/64: se prefiere el más grande.
_THEME_ROOTS = (
    Path("/usr/share/icons/Papirus"),
    Path("/usr/share/icons/Papirus-Dark"),
)
_THEME_SIZES = ("64x64", "48x48", "32x32")


_DESKTOP_APPS_DIRS = (
    Path("/usr/share/applications"),
    Path.home() / ".local" / "share" / "applications",
    Path("/var/lib/flatpak/exports/share/applications"),
    Path.home() / ".local" / "share" / "flatpak" / "exports" / "share" / "applications",
)


def _icon_name_from_desktop_file(exec_name):
    icon_re = re.compile(r"^Icon\s*=\s*(.+)$", re.MULTILINE)
    for apps_dir in _DESKTOP_APPS_DIRS:
        if not apps_dir.is_dir():
            continue
        try:
            entries = list(apps_dir.glob("*.desktop"))
        except OSError:
            continue
        for entry in entries:
            try:
                text = entry.read_text(encoding="utf-8", errors="ignore")
            except OSError:
                continue
            for line in text.splitlines():
                if not line.startswith("Exec"):
                    continue
                key, sep, value = line.partition("=")
                if not sep or key.strip() != "Exec":
                    continue
                value = value.strip()
                first_token = value.split()[0] if value else ""
                base_name = first_token.rsplit("/", 1)[-1]
                if base_name == exec_name:
                    m = icon_re.search(text)
                    return m.group(1).strip() if m else None
                break
    return None


def _resolve_icon_name_to_path(icon_name):
    if not icon_name:
        return None
    p = Path(icon_name)
    if p.is_absolute() and p.is_file():
        return p
    for root in _HICOLOR_ROOTS:
        for size in _HICOLOR_SIZES:
            for ext in ("png", "svg", "svgz", "xpm"):
                candidate = root / size / "apps" / f"{icon_name}.{ext}"
                if candidate.is_file():
                    return candidate
    for root in _PIXMAP_ROOTS:
        for ext in ("png", "svg", "xpm"):
            candidate = root / f"{icon_name}.{ext}"
            if candidate.is_file():
                return candidate
    return None


# archlinux-appstream-data (paquete oficial de [extra], en HYPRLAND_PKGS del
# instalador): metadata + íconos AppStream de la inmensa mayoría de paquetes
# de los repos oficiales, generados por appstream-generator SIN necesidad de
# tener el paquete instalado. Layout real (confirmado contra el file list del
# paquete en archlinux.org, no supuesto): una carpeta PLANA por resolución,
# NO el layout size/apps/ de hicolor —
#   swcatalog/icons/archlinux-arch-{core,extra}/<size>/<pkgname>_<algo>.<ext>
# — donde "<algo>" es case por case el nombre del binario, un app-id
# reverse-DNS, o directamente igual al pkgname (xonotic_xonotic.png), sin
# regla fija. Por eso esto es glob por PREFIJO de pkgname, no una ruta
# construida a mano como en hicolor: cubre el caso común (pkgname real ==
# nuestro app["package"], que es la mayoría) pero NO resuelve paquetes cuyo
# nombre real en el repo difiere del genérico en el catálogo — ej. "freeciv"
# en avalos-store-catalog.json empaqueta como freeciv-gtk4/freeciv-qt/
# freeciv-gtk3 en Arch real, ninguno literalmente "freeciv", así que ese caso
# específico sigue sin ícono real hasta instalarse. Ver resumen de la sesión.
_APPSTREAM_SIZES = ("128x128", "64x64", "48x48")
_APPSTREAM_ROOTS = (
    Path("/usr/share/swcatalog/icons/archlinux-arch-extra"),
    Path("/usr/share/swcatalog/icons/archlinux-arch-core"),
    Path("/usr/share/swcatalog/icons/archlinux-arch-multilib"),
)


def _appstream_icon_path(pkgname):
    if not pkgname:
        return None
    for root in _APPSTREAM_ROOTS:
        for size in _APPSTREAM_SIZES:
            size_dir = root / size
            if not size_dir.is_dir():
                continue
            try:
                # Prefijo exacto "<pkgname>_" primero (evita que "foo"
                # matchee "foobar_x.png"); si no hay nada, se intenta
                # cualquier archivo que CONTENGA el pkgname como último
                # recurso, por si el pkgname real trae versión o sufijo
                # (ej. algo-git, algo2) que el catálogo no versiona.
                matches = sorted(size_dir.glob(f"{pkgname}_*"))
                if not matches:
                    matches = sorted(size_dir.glob(f"*{pkgname}*"))
                if matches:
                    return matches[0]
            except OSError:
                continue
    return None


def _theme_icon_path(app):
    """Ícono del tema instalado para `app`, o None. Nombres a probar, en orden:
    icon_name (campo opcional del catálogo), exec, package, id."""
    names = [n for n in dict.fromkeys([app.get("icon_name"), app.get("exec"), app.get("package"), app.get("id")]) if n]
    for name in names:
        for root in _THEME_ROOTS:
            for size in _THEME_SIZES:
                for ext in ("svg", "png"):
                    candidate = root / size / "apps" / f"{name}.{ext}"
                    if candidate.is_file():
                        return candidate
    return None


def _local_icon_path(app):
    if app.get("source") == "flatpak":
        icon_name = app["package"]
    else:
        icon_name = _icon_name_from_desktop_file(app.get("exec") or app["package"])
        if not icon_name:
            icon_name = app.get("exec") or app["package"]
    return _resolve_icon_name_to_path(icon_name)


_MIME_BY_EXT = {".png": "image/png", ".svg": "image/svg+xml", ".svgz": "image/svg+xml", ".xpm": "image/x-xpixmap"}


def _file_to_data_uri(path):
    try:
        mime = _MIME_BY_EXT.get(path.suffix.lower(), "application/octet-stream")
        raw = path.read_bytes()
        b64 = base64.b64encode(raw).decode("ascii")
        return f"data:{mime};base64,{b64}"
    except Exception:
        return None


def _cached_icon_data_uri(app_id):
    for ext in ("png", "svg"):
        p = ICON_CACHE_DIR / f"{app_id}.{ext}"
        if p.is_file():
            return _file_to_data_uri(p)
    return None


def _fetch_flathub_icon(app_id, flathub_id):
    try:
        req = urllib.request.Request(
            FLATHUB_APPSTREAM_URL + urllib.parse.quote(flathub_id),
            headers={"User-Agent": "avalos-store", "Accept": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None

    icon_url = None
    if isinstance(data.get("icon"), str):
        icon_url = data["icon"]
    elif isinstance(data.get("icon"), dict):
        icon_url = data["icon"].get("url") or data["icon"].get("128") or data["icon"].get("64")
    elif isinstance(data.get("icons"), list) and data["icons"]:
        icon_url = data["icons"][-1].get("url") if isinstance(data["icons"][-1], dict) else None
    if not icon_url:
        return None
    if icon_url.startswith("/"):
        icon_url = "https://flathub.org" + icon_url

    try:
        req = urllib.request.Request(icon_url, headers={"User-Agent": "avalos-store"})
        with urllib.request.urlopen(req, timeout=8) as resp:
            raw = resp.read()
            content_type = resp.headers.get("Content-Type", "")
    except Exception:
        return None

    ext = "svg" if "svg" in content_type or icon_url.endswith(".svg") else "png"
    try:
        ICON_CACHE_DIR.mkdir(parents=True, exist_ok=True)
        (ICON_CACHE_DIR / f"{app_id}.{ext}").write_bytes(raw)
    except OSError:
        pass
    mime = "image/svg+xml" if ext == "svg" else "image/png"
    return f"data:{mime};base64,{base64.b64encode(raw).decode('ascii')}"


def resolve_icon(app, installed_ids):
    cached = _cached_icon_data_uri(app["id"])
    if cached:
        return cached

    if app["id"] in installed_ids:
        local_path = _local_icon_path(app)
        if local_path:
            data_uri = _file_to_data_uri(local_path)
            if data_uri:
                return data_uri

    flathub_id = app["package"] if app.get("source") == "flatpak" else app.get("flathub_id")

    # Sin flathub_id conocido (típicamente pacman/AUR sin equivalente en
    # Flathub) Y todavía no instalada: se intenta archlinux-appstream-data
    # ANTES de rendirse al emoji — es la única fuente de ícono real que
    # queda en ese caso, ya que Flathub no tiene nada que devolver sin un
    # ID válido. Cuando SÍ hay flathub_id, Flathub tiene prioridad más
    # abajo: es una fuente determinística (el ID viene mapeado a mano en
    # el catálogo), mientras que esto es glob por prefijo de pkgname
    # (best-effort, ver docstring de _appstream_icon_path) — no tiene
    # sentido preferir la heurística cuando ya hay algo exacto disponible.
    if not flathub_id and app["id"] not in installed_ids and app.get("source") in ("pacman", "aur"):
        appstream_path = _appstream_icon_path(app["package"])
        if appstream_path:
            data_uri = _file_to_data_uri(appstream_path)
            if data_uri:
                return data_uri

    if flathub_id:
        data_uri = _fetch_flathub_icon(app["id"], flathub_id)
        if data_uri:
            return data_uri
        # Sin red (o Flathub sin respuesta): AppStream local antes de rendirse.
        if app["id"] not in installed_ids and app.get("source") in ("pacman", "aur"):
            appstream_path = _appstream_icon_path(app["package"])
            if appstream_path:
                data_uri = _file_to_data_uri(appstream_path)
                if data_uri:
                    return data_uri

    # Último recurso ANTES del emoji: el tema de íconos instalado (ver arriba).
    theme_path = _theme_icon_path(app)
    if theme_path:
        data_uri = _file_to_data_uri(theme_path)
        if data_uri:
            return data_uri

    return None


class StoreAPI:
    def __init__(self):
        self.window = None

    def list(self):
        pacman_pkgs, flatpak_apps = installed_snapshot()
        return json.dumps({
            "apps": CATALOG,
            "installed": installed_ids_from_snapshot(pacman_pkgs, flatpak_apps),
            "strings": T,
            "lang": LANG,
            "has_flatpak": shutil.which("flatpak") is not None,
            "has_aur_helper": find_aur_helper(),
            "default_category": "games" if "gaming" in PERFIL_INSTALACION else "all",
        })

    def refresh_installed(self):
        pacman_pkgs, flatpak_apps = installed_snapshot()
        return json.dumps({"installed": installed_ids_from_snapshot(pacman_pkgs, flatpak_apps)})

    def get_icon(self, app_id, installed):
        app = app_by_id(app_id)
        if not app:
            return json.dumps({"ok": False})
        data_uri = resolve_icon(app, {app_id} if installed else set())
        return json.dumps({"ok": data_uri is not None, "data_uri": data_uri})

    def details(self, app_id):
        app = app_by_id(app_id)
        if not app:
            return json.dumps({"ok": False})
        extra = {}
        source, pkg = app.get("source"), app.get("package", "")
        if source in ("pacman", "aur"):
            try:
                r = subprocess.run(["pacman", "-Si", pkg], capture_output=True, text=True, timeout=6)
                text = r.stdout
                if not text.strip():
                    r = subprocess.run(["pacman", "-Qi", pkg], capture_output=True, text=True, timeout=6)
                    text = r.stdout
                extra.update(parse_pacman_info(text))
            except Exception:
                pass
        if source == "aur":
            aur = fetch_aur_info(pkg)
            if aur:
                if aur.get("Version"):
                    extra["live_version"] = aur["Version"]
                extra["aur_votes"] = aur.get("NumVotes")
                extra["aur_popularity"] = aur.get("Popularity")
                extra["aur_maintainer"] = aur.get("Maintainer")
        return json.dumps({"ok": True, "extra": extra})

    def install(self, app_id):
        app = app_by_id(app_id)
        if not app:
            return json.dumps({"ok": False, "message": T["err_notfound"]})
        threading.Thread(target=self._do_install, args=(app,), daemon=True).start()
        return json.dumps({"ok": True})

    def uninstall(self, app_id):
        app = app_by_id(app_id)
        if not app:
            return json.dumps({"ok": False, "message": T["err_notfound"]})
        threading.Thread(target=self._do_uninstall, args=(app,), daemon=True).start()
        return json.dumps({"ok": True})

    def launch(self, app_id):
        app = app_by_id(app_id)
        if not app:
            return json.dumps({"ok": False})
        try:
            if app.get("source") == "flatpak":
                subprocess.Popen(["flatpak", "run", app["package"]], start_new_session=True)
            else:
                subprocess.Popen([app.get("exec") or app["package"]], start_new_session=True)
            return json.dumps({"ok": True})
        except Exception as e:
            return json.dumps({"ok": False, "message": str(e)})

    def _emit(self, app_id, event, payload):
        if not self.window:
            return
        packet = json.dumps({"appId": app_id, "event": event, **payload})
        try:
            self.window.evaluate_js(f"avalosStore.onBackendEvent({packet})")
        except Exception:
            pass

    def _log(self, app_id, message):
        self._emit(app_id, "log", {"message": message})

    def _finish(self, app_id, action, ok, message="", external=False):
        self._emit(app_id, "finish", {"action": action, "ok": ok, "message": message, "external": external})

    def _stream(self, app_id, proc):
        try:
            for line in proc.stdout:
                self._log(app_id, line.rstrip())
        except Exception:
            pass
        proc.wait()
        return proc.returncode

    def _notify(self, message):
        try:
            subprocess.run(
                ["notify-send", "AvalOS Store", message, "-i", "system-software-install", "-t", "3500"],
                capture_output=True, timeout=5,
            )
        except Exception:
            pass

    def _do_install(self, app):
        app_id, name, source, pkg = app["id"], app["name"], app.get("source"), app.get("package", "")
        self._log(app_id, T["log_start_install"].format(name=name))
        try:
            if source == "pacman":
                if not shutil.which("pkexec"):
                    self._finish(app_id, "install", False, T["err_nopkexec"])
                    return
                # "-S" debe ser el PRIMER argumento después de "pacman" — es lo
                # que org.freedesktop.policykit.exec.argv1 en avalos-store.policy
                # (acción com.avalos.store.install) usa para matchear esto contra
                # la acción con auth_admin_keep. Si esto se reordena, cae en la
                # acción genérica de pkexec (pide contraseña en cada instalación).
                proc = subprocess.Popen(
                    ["pkexec", "pacman", "-S", "--noconfirm", "--needed", pkg],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
                rc = self._stream(app_id, proc)
                ok = rc == 0
                msg = T["done_install"].format(name=name) if ok else T["err_install"]
                self._finish(app_id, "install", ok, msg)
                if ok:
                    self._notify(msg)
            elif source == "flatpak":
                if not shutil.which("flatpak"):
                    self._finish(app_id, "install", False, T["err_noflatpak"])
                    return
                proc = subprocess.Popen(
                    ["flatpak", "install", "--user", "--noninteractive", "-y", "flathub", pkg],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
                rc = self._stream(app_id, proc)
                ok = rc == 0
                msg = T["done_install"].format(name=name) if ok else T["err_install"]
                self._finish(app_id, "install", ok, msg)
                if ok:
                    self._notify(msg)
            elif source == "aur":
                helper = find_aur_helper()
                term = find_terminal()
                if not helper:
                    self._finish(app_id, "install", False, T["err_noaur"])
                    return
                if not term:
                    self._finish(app_id, "install", False, T["err_noterm"])
                    return
                spawn_terminal(term, f"AvalOS — {name}", [helper, "-S", pkg])
                self._log(app_id, T["log_aur_terminal"].format(name=name, helper=helper))
                self._finish(app_id, "install", True, T["done_external"], external=True)
            else:
                self._finish(app_id, "install", False, T["err_unknown_source"])
        except Exception as e:
            self._log(app_id, str(e))
            self._finish(app_id, "install", False, T["err_install"])

    def _do_uninstall(self, app):
        app_id, name, source, pkg = app["id"], app["name"], app.get("source"), app.get("package", "")
        self._log(app_id, T["log_start_uninstall"].format(name=name))
        try:
            if source in ("pacman", "aur"):
                if not shutil.which("pkexec"):
                    self._finish(app_id, "uninstall", False, T["err_nopkexec"])
                    return
                # Mismo criterio que en _do_install: "-R" primero, para
                # matchear com.avalos.store.uninstall en avalos-store.policy.
                proc = subprocess.Popen(
                    ["pkexec", "pacman", "-R", "--noconfirm", pkg],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
                rc = self._stream(app_id, proc)
                ok = rc == 0
                msg = T["done_uninstall"].format(name=name) if ok else T["err_uninstall"]
                self._finish(app_id, "uninstall", ok, msg)
                if ok:
                    self._notify(msg)
            elif source == "flatpak":
                proc = subprocess.Popen(
                    ["flatpak", "uninstall", "--user", "-y", pkg],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
                rc = self._stream(app_id, proc)
                ok = rc == 0
                msg = T["done_uninstall"].format(name=name) if ok else T["err_uninstall"]
                self._finish(app_id, "uninstall", ok, msg)
                if ok:
                    self._notify(msg)
            else:
                self._finish(app_id, "uninstall", False, T["err_unknown_source"])
        except Exception as e:
            self._log(app_id, str(e))
            self._finish(app_id, "uninstall", False, T["err_uninstall"])


