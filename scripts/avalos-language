def current_language(lang_file: Path | None = None, environ=os.environ) -> str:
    """Idioma de UI actual: /etc/avalos-lang; si falta o trae algo inválido, el prefijo de LANG; si no, inglés."""
    try:
        code = (lang_file or LANG_FILE).read_text(encoding="utf-8").strip()
    except OSError:
        code = ""
    if code not in SUPPORTED:
        code = (environ.get("LANG") or "").split(".")[0].split("_")[0]
    return code if code in SUPPORTED else "en"


def relabel_fastfetch(text: str, code: str) -> str:
    """Pone en `text` (config.jsonc) las etiquetas de `code`. Se busca cada módulo por su `"type"` y se cambia solo su
    `"key"`, así da igual en qué idioma estuviera antes. Un módulo que el usuario reordenó o quitó no se toca."""
    for module, label in FASTFETCH_KEYS[code].items():
        pattern = re.compile(r'(\{\s*"type"\s*:\s*"' + re.escape(module) + r'"\s*,\s*"key"\s*:\s*")((?:[^"\\]|\\.)*)(")')
        text = pattern.sub(lambda m: m.group(1) + label + m.group(3), text, count=1)   # lambda: sin escapes de re
    return text


def fastfetch_config_path(environ=os.environ) -> Path:
    base = environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "fastfetch" / "config.jsonc"


def relabel_fastfetch_file(path: Path, code: str) -> bool:
    """Reescribe el config.jsonc del usuario (atómico). True si cambió algo; False si no existe o ya estaba así."""
    try:
        path = path.resolve()
        original = path.read_text(encoding="utf-8")
    except OSError:
        return False
    updated = relabel_fastfetch(original, code)
    if updated == original:
        return False
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.avalos-tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(updated)
        os.chmod(tmp, path.stat().st_mode & 0o777)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return True


def _why(proc) -> str:
    """Última línea útil de lo que dijo el helper, sin el prefijo «### ERROR: »."""
    lines = [ln.strip() for ln in ((proc.stdout or "") + "\n" + (proc.stderr or "")).splitlines() if ln.strip()]
    return re.sub(r"^#+\s*(ERROR:\s*)?", "", lines[-1]) if lines else f"código {proc.returncode}"


def change_language(code: str, *, run=subprocess.run, lang_file: Path | None = None,
                    ff_config: Path | None = None) -> tuple[str, str]:
    """Cambia el idioma. Devuelve (estado, detalle) con estado: done | same | cancelled | outdated | error."""
    if code not in SUPPORTED:
        return "error", f"idioma desconocido: {code}"
    if code == current_language(lang_file):
        return "same", ""
    if not os.access(HELPER, os.X_OK):
        return "error", f"{HELPER} no está instalado"
    try:
        proc = run(["pkexec", HELPER, "set-language", "--code", code], capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "error", str(e)
    if proc.returncode in (126, 127):          # pkexec: la autenticación se canceló o se denegó
        return "cancelled", ""
    if proc.returncode == 2 and "invalid choice" in (proc.stderr or ""):   # helper viejo: no conoce set-language
        return "outdated", ""
    if proc.returncode != 0:
        return "error", _why(proc)
    relabel_fastfetch_file(ff_config or fastfetch_config_path(), code)
    return "done", ""


def notify(text: str) -> None:
    print(text)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-i", "preferences-desktop-locale", "-t", "8000", "AvalOS", text], check=False)


def pick_with_rofi(current: str, run=subprocess.run) -> str | None:
    lines = [f" {'✔' if code == current else ' '}  {NAMES[code]}" for code in SUPPORTED]
    proc = run(["rofi", "-dmenu", "-i", "-no-custom", "-p", STRINGS[current]["title"], "-theme-str",
                "window {width: 360px;} listview {lines: 4;}"], input="\n".join(lines), capture_output=True, text=True)
    chosen = (proc.stdout or "").strip()
    return next((code for code in SUPPORTED if chosen.endswith(NAMES[code])), None)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="avalos-language", description="Cambia el idioma de AvalOS.")
    group = ap.add_mutually_exclusive_group()
    group.add_argument("--set", dest="code", choices=SUPPORTED, help="cambiar directamente, sin menú")
    group.add_argument("--current", action="store_true", help="mostrar el idioma actual")
    group.add_argument("--relabel", action="store_true", help="reescribir los íconos y etiquetas de fastfetch en el idioma actual")
    args = ap.parse_args(argv)

    current = current_language()
    if args.current:
        print(current)
        return 0
    if args.relabel:
        changed = relabel_fastfetch_file(fastfetch_config_path(), current)
        print(STRINGS[current]["relabeled" if changed else "relabel-same"])
        return 0
    code = args.code
    if code is None:
        if not shutil.which("rofi"):
            print(STRINGS[current]["no-rofi"], file=sys.stderr)
            return 1
        code = pick_with_rofi(current)
        if code is None:                        # se cerró el menú sin elegir
            return 0

    status, detail = change_language(code)
    if status == "done":
        notify(STRINGS[code]["done"].format(name=NAMES[code]))
        return 0
    if status == "same":
        notify(STRINGS[current]["same"].format(name=NAMES[code]))
        return 0
    if status == "cancelled":
        return 1
    notify(STRINGS[current]["outdated" if status == "outdated" else "failed"].format(why=detail))
    return 2


if __name__ == "__main__":
    sys.exit(main())
