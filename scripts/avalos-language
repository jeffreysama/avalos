    },
}

STRINGS = {
    "en": {
        "title": "Language",
        "done": "Language changed to {name}. Windows that are already open keep the old language until you reopen them.",
        "same": "AvalOS is already in {name}.",
        "outdated": "This system's update helper can't change the language yet. Update AvalOS first and try again.",
