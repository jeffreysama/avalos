#!/usr/bin/env python3
"""avalos-language — cambia el idioma de AvalOS después de la instalación.

Antes el idioma solo se elegía en el instalador y no había forma de cambiarlo después. Qué cambia esto:
  · /etc/avalos-lang, que leen TODAS las herramientas de AvalOS (Ajustes, Centro de control, Actualizar,
    Doctor, Tienda, Bienvenida, Acerca de…). Lo escribe `avalos-update-helper set-language` vía pkexec,
    porque /etc es de root; esta herramienta corre sin privilegios.
  · Los textos de la pantalla de inicio de sesión (SDDM), que el mismo helper vuelve a renderizar.
  · Las etiquetas de fastfetch en ~/.config/fastfetch/config.jsonc (OS, Kernel, Uptime…): el instalador las deja
    escritas en el idioma elegido y no las lee en vivo, así que se reescriben aquí.

Lo que NO cambia: la configuración regional del sistema (LANG: formato de fecha, moneda…). Es un ajuste distinto
—el instalador también los separa— y las ventanas que ya estén abiertas conservan el idioma anterior.

Uso:
  avalos-language             menú (rofi) para elegir el idioma
  avalos-language --set es    cambia directamente (en | es | zh | ja)
  avalos-language --current   muestra el idioma actual
  avalos-language --relabel   reescribe los íconos y etiquetas de fastfetch en el idioma actual (sin cambiar nada más;
                              útil tras actualizar AvalOS, porque el config.jsonc de fastfetch es del usuario y el
                              actualizador nunca toca ~/.config)
"""
from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

LANG_FILE = Path("/etc/avalos-lang")
HELPER = "/usr/local/bin/avalos-update-helper"
SUPPORTED = ("en", "es", "zh", "ja")
NAMES = {"en": "English", "es": "Español", "zh": "中文（简体）", "ja": "日本語"}

# Etiquetas de los módulos de fastfetch por idioma. Son las MISMAS que translations.py (ff-*): el instalador las
# escribe al instalar y esto las reescribe al cambiar de idioma. translations.py sigue siendo la fuente de verdad:
# tests/test_language.py falla si esta tabla se desalinea. (Las barras `\\uXXXX` son escapes JSON: van tal cual.)
FASTFETCH_KEYS = {
    "en": {
        "os": "\\udb80\\udf3d OS",
