#!/usr/bin/env python3
# ── AvalOS — avalos-update ──────────────────────────────────────────────────
# Elegir QUÉ actualizar: paquetes de sistema, kernel (con cambio de variante
# EEVDF↔BORE↔Compat), AUR, Flatpak, y los scripts/plantillas de AvalOS.
#
# Esta GUI corre SIN privilegios, como el usuario normal — igual que
# avalos-wallpaper. Nada acá toca root directo. Lo único privilegiado es
# avalos-update-helper, invocado vía pkexec (com.avalos.update.run-helper,
# ver avalos-update.policy) — hyprpolkitagent ya corre en el sistema
# instalado así que el diálogo gráfico de contraseña aparece solo, sin
# configurar nada más.
#
# Por qué "system" no permite elegir paquete-por-paquete: un pacman -Syu
# parcial (aplicar unos paquetes del sync y otros no) es exactamente el
# patrón de "partial upgrade" que Arch marca como no soportado — se puede
# romper linking entre paquetes que sí dependen entre sí. El kernel es la
# EXCEPCIÓN segura: nada en el resto del sistema depende del paquete de
# kernel por su nombre exacto, así que --ignore sobre él (ver apply-system
# --hold-kernel en el helper) es un patrón reconocido y seguro. AUR y
# Flatpak sí son paquete-por-paquete: son hojas sin interdependencias
# complejas entre sí.
#
# Requiere: python-pywebview, webkit2gtk-4.1, python-gobject (ya en
# HYPRLAND_PKGS por avalos-wallpaper), pacman-contrib (checkupdates).
import json
import os
import subprocess
import sys
import threading
import urllib.request
from pathlib import Path

import webview

REPO_RAW = "https://raw.githubusercontent.com/jeffreysama/avalos/main"
HELPER_BIN = "/usr/local/bin/avalos-update-helper"
TEMPLATE_LOCAL = Path("/usr/share/avalos/configs/hyprland/hyprland_conf_lua.template")

KERNEL_VARIANTS = {
    "eevdf": "linux-avalos",
    "bore": "linux-avalos-bore",
    "compat": "linux-avalos-compat",
}

# ── i18n — mismo patrón que avalos-about/avalos-settings/avalos-wallpaper ───
_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")


def _detectar_idioma() -> str:
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

