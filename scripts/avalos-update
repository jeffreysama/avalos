  .kv-opt.locked input { cursor: not-allowed; }
  .kv-note { font-size: 10px; color: var(--text-dim); margin-left: 22px; }

  .diff-toggle { font-size: 11px; color: var(--blue); cursor: pointer; margin: 8px 0 0 25px; display: inline-block; }
  .diff-box { display: none; margin: 8px 0 0 25px; background: var(--bg-alt); border: 1px solid var(--border);
    border-radius: 7px; padding: 8px 10px; font-size: 10.5px; white-space: pre-wrap; max-height: 160px; overflow-y: auto; }
  .diff-box.show { display: block; }
  .diff-add { color: var(--green); }
  .diff-del { color: var(--red); }

  footer { flex-shrink: 0; padding: 12px 22px; border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; }
  .auth-note { font-size: 10px; color: var(--text-dim); max-width: 60%; }
  button.primary { background: linear-gradient(135deg, var(--blue), var(--purple)); color: var(--bg);
    border: none; border-radius: 8px; padding: 9px 18px; font-weight: 700; font-size: 12px;
    cursor: pointer; font-family: inherit; }
  button.primary:disabled { opacity: .4; cursor: not-allowed; }
  button.ghost { background: transparent; color: var(--text-dim); border: 1px solid var(--border);
    border-radius: 8px; padding: 9px 16px; font-size: 12px; cursor: pointer; font-family: inherit; }

  #logPanel { font-size: 11px; line-height: 1.6; white-space: pre-wrap; }
  .l-info { color: var(--text); }
  .l-step { color: var(--blue); font-weight: 700; margin-top: 6px; display: block; }
  .l-err { color: var(--red); }
  .l-ok { color: var(--green); }

  .checking { display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 100%; color: var(--text-dim); font-size: 12.5px; gap: 10px; }
  .spinner { width: 22px; height: 22px; border: 2px solid var(--border); border-top-color: var(--blue);
    border-radius: 50%; animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="app">
  <header>
    <h1><span class="accent">AvalOS</span> — <span id="ttl"></span></h1>
    <div class="status" id="statusText"></div>
  </header>

  <div class="body" id="checkingView">
    <div class="checking"><div class="spinner" id="spinner"></div><div id="checkingTxt"></div></div>
  </div>

  <div class="body hidden" id="mainView">
    <div class="section">
      <label class="section-head">
        <input type="checkbox" id="cb-snapshot">
        <div>
          <div class="section-title" id="t-snapshot"></div>
          <p class="section-desc" id="d-snapshot"></p>
        </div>
      </label>
    </div>

    <div class="section" id="sec-system">
      <label class="section-head">
        <input type="checkbox" id="cb-system">
        <div style="flex:1">
          <div class="section-title"><span id="t-system"></span><span class="badge n" id="badge-system"></span></div>
          <p class="section-desc" id="d-system"></p>
        </div>
      </label>
      <div class="item-list" id="list-system"></div>
      <div class="section-none hidden" id="none-system"></div>
    </div>

    <div class="section" id="sec-kernel">
      <label class="section-head">
        <input type="checkbox" id="cb-kernel">
        <div style="flex:1">
          <div class="section-title"><span id="t-kernel"></span> <span class="badge" id="badge-kernel-current"></span></div>
          <p class="section-desc" id="d-kernel"></p>
        </div>
      </label>
      <div class="kernel-variants" id="kernel-variants"></div>
    </div>

    <div class="section" id="sec-aur">
      <label class="section-head">
        <input type="checkbox" id="cb-aur-all">
        <div style="flex:1">
          <div class="section-title"><span id="t-aur"></span><span class="badge n" id="badge-aur"></span></div>
        </div>
      </label>
      <div class="item-list" id="list-aur"></div>
      <div class="section-none hidden" id="none-aur"></div>
    </div>

    <div class="section" id="sec-flatpak">
      <label class="section-head">
        <input type="checkbox" id="cb-flatpak-all">
        <div style="flex:1">
          <div class="section-title"><span id="t-flatpak"></span><span class="badge n" id="badge-flatpak"></span></div>
        </div>
      </label>
      <div class="item-list" id="list-flatpak"></div>
      <div class="section-none hidden" id="none-flatpak"></div>
    </div>

    <div class="section" id="sec-configs">
      <label class="section-head">
        <input type="checkbox" id="cb-configs">
        <div style="flex:1">
          <div class="section-title"><span id="t-configs"></span><span class="badge" id="badge-configs"></span></div>
          <p class="section-desc" id="d-configs"></p>
        </div>
      </label>
      <span class="diff-toggle hidden" id="diffToggle"></span>
      <div class="diff-box" id="diffBox"></div>
      <p class="section-desc" id="configsNote" style="margin-left:25px;margin-top:8px;"></p>
    </div>
  </div>

  <div class="body hidden" id="logView">
    <pre id="logPanel"></pre>
  </div>

  <footer>
    <span class="auth-note" id="authNote"></span>
    <div style="display:flex; gap:8px;">
      <button class="ghost hidden" id="retryBtn"></button>
      <button class="ghost hidden" id="closeBtn"></button>
      <button class="primary" id="applyBtn"></button>
    </div>
  </footer>
</div>

<script>
let T = {};
let STATE = null;

function escapeHtml(s) {
  return String(s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function el(id) { return document.getElementById(id); }

function pyLog(txt, cls) {
  const p = el('logPanel');
  const span = document.createElement('span');
  span.className = 'l-' + (cls || 'info');
  span.textContent = txt;
  p.appendChild(span);
  p.appendChild(document.createTextNode('\n'));
  p.parentElement.scrollTop = p.parentElement.scrollHeight;
}

function pyDone(okAll, kernelTouched) {
  el('applyBtn').classList.add('hidden');
  el('retryBtn').classList.remove('hidden');
  el('closeBtn').classList.remove('hidden');
  el('statusText').textContent = okAll ? T['done-ok'] : T['done-err'];
  if (kernelTouched) {
    pyLog(T['reboot-needed'], okAll ? 'ok' : 'info');
  }
}

function verLine(item) {
  return `<span class="ver">${escapeHtml(item.old)} → <span class="new">${escapeHtml(item.new)}</span></span>`;
}

function renderSystem() {
  const list = STATE.system;
  el('badge-system').textContent = list.length;
  el('badge-system').classList.toggle('hidden', list.length === 0);
  el('cb-system').disabled = list.length === 0;
  if (list.length === 0) {
    el('none-system').textContent = T['sec-system-none'];
    el('none-system').classList.remove('hidden');
    return;
  }
  el('list-system').innerHTML = list.map(i =>
    `<div class="item"><span>${escapeHtml(i.name)}</span>${verLine(i)}</div>`
  ).join('');
}

function renderKernel() {
  const k = STATE.kernel;
  el('badge-kernel-current').textContent = T['kernel-current'].replace('{variant}', k.current_variant || '?');
  const variants = [
    { id: 'eevdf', label: 'EEVDF', pkg: 'linux-avalos', locked: false },
    { id: 'bore', label: 'BORE', pkg: 'linux-avalos-bore', locked: !k.bore_ok },
    { id: 'compat', label: 'Compat', pkg: 'linux-avalos-compat', locked: false },
  ];
  el('kernel-variants').innerHTML = variants.map(v => {
    const isCurrent = v.id === k.current_variant;
    const label = isCurrent
      ? T['kernel-update-now'].replace('{pkg}', v.pkg)
      : `${v.label} (${v.pkg})`;
    const lockedClass = v.locked ? ' locked' : '';
    const disabled = v.locked ? 'disabled' : '';
    return `<label class="kv-opt${lockedClass}">
      <input type="radio" name="kv" value="${v.id}" ${isCurrent ? 'checked' : ''} ${disabled}>
      <span>${label}</span>
    </label>` + (v.locked ? `<div class="kv-note">${T['kernel-bore-locked']}</div>` : '');
  }).join('');

  // El checkbox de la sección es el opt-in real: sin esto, como algún
  // radio SIEMPRE queda marcado (la variante actual, por defecto),
  // kernel_variant se mandaría en cada "Aplicar" aunque el usuario solo
  // quisiera tocar AUR o Flatpak. Elegir un radio marca el checkbox solo
  // — no hace falta que el usuario haga las dos cosas por separado.
  document.querySelectorAll('input[name=kv]').forEach(r => {
    r.addEventListener('change', () => { el('cb-kernel').checked = true; });
  });
  if (!k.current_variant) {
    el('cb-kernel').disabled = true;
  }
}

function renderAur() {
  const list = STATE.aur;
  el('badge-aur').textContent = list.length;
  el('badge-aur').classList.toggle('hidden', list.length === 0);
  el('cb-aur-all').disabled = list.length === 0;
  if (list.length === 0) {
    el('none-aur').textContent = T['sec-aur-none'];
    el('none-aur').classList.remove('hidden');
    return;
  }
  el('list-aur').innerHTML = list.map(i =>
    `<label class="item"><input type="checkbox" class="aur-item" value="${escapeHtml(i.name)}" checked><span>${escapeHtml(i.name)}</span>${verLine(i)}</label>`
  ).join('');
  el('cb-aur-all').checked = true;
  el('cb-aur-all').addEventListener('change', e => {
    document.querySelectorAll('.aur-item').forEach(cb => cb.checked = e.target.checked);
  });
}

function renderFlatpak() {
  const list = STATE.flatpak;
  el('badge-flatpak').textContent = list.length;
  el('badge-flatpak').classList.toggle('hidden', list.length === 0);
  el('cb-flatpak-all').disabled = list.length === 0;
  if (list.length === 0) {
    el('none-flatpak').textContent = T['sec-flatpak-none'];
    el('none-flatpak').classList.remove('hidden');
    return;
  }
  el('list-flatpak').innerHTML = list.map(i =>
    `<label class="item"><input type="checkbox" class="fp-item" value="${escapeHtml(i.id)}" checked><span>${escapeHtml(i.id)}</span></label>`
  ).join('');
  el('cb-flatpak-all').checked = true;
  el('cb-flatpak-all').addEventListener('change', e => {
    document.querySelectorAll('.fp-item').forEach(cb => cb.checked = e.target.checked);
  });
}

function renderConfigs() {
  const c = STATE.configs;
  if (!c.reachable) {
    el('badge-configs').textContent = '?';
    el('cb-configs').disabled = true;
  } else if (c.changed) {
    el('badge-configs').textContent = T['configs-changed'];
    el('badge-configs').className = 'badge warn';
    el('diffToggle').textContent = T['configs-view-diff'];
    el('diffToggle').classList.remove('hidden');
    el('diffToggle').onclick = () => el('diffBox').classList.toggle('show');
    const lines = c.diff.split('\n').map(l => {
      const cls = l.startsWith('+') ? 'diff-add' : (l.startsWith('-') ? 'diff-del' : '');
      return `<span class="${cls}">${escapeHtml(l)}</span>`;
    });
    el('diffBox').innerHTML = lines.join('\n');
  } else {
    el('badge-configs').textContent = T['configs-uptodate'];
    el('badge-configs').className = 'badge ok';
  }
  el('configsNote').textContent = T['configs-note'];
}

let firstCheckDone = false;

function applyStrings() {
  document.title = 'AvalOS — ' + T['title'];
  el('ttl').textContent = T['title'];
  el('t-snapshot').textContent = T['sec-snapshot'];
  el('d-snapshot').textContent = T['sec-snapshot-d'];
  el('t-system').textContent = T['sec-system'];
  el('d-system').textContent = T['sec-system-d'];
  el('t-kernel').textContent = T['sec-kernel'];
  el('d-kernel').textContent = T['sec-kernel-d'];
  el('t-aur').textContent = T['sec-aur'];
  el('t-flatpak').textContent = T['sec-flatpak'];
  el('t-configs').textContent = T['sec-configs'];
  el('d-configs').textContent = T['sec-configs-d'];
  el('applyBtn').textContent = T['apply'];
  el('closeBtn').textContent = T['close'];
  el('retryBtn').textContent = T['retry-check'];
  el('authNote').textContent = T['auth-note'];
  el('checkingTxt').textContent = T['checking'];
  if (!firstCheckDone) {
    el('cb-snapshot').checked = true;
    firstCheckDone = true;
  }
}

function collectPayload() {
  const variantChosen = document.querySelector('input[name=kv]:checked');
  const kernelOptedIn = el('cb-kernel').checked;
  return {
    snapshot: el('cb-snapshot').checked,
    system: el('cb-system').checked,
    hold_kernel: kernelOptedIn,
    kernel_variant: kernelOptedIn && variantChosen ? variantChosen.value : null,
    aur_packages: Array.from(document.querySelectorAll('.aur-item:checked')).map(cb => cb.value),
    flatpak_apps: Array.from(document.querySelectorAll('.fp-item:checked')).map(cb => cb.value),
    sync_configs: el('cb-configs').checked,
  };
}

function onApply() {
  const payload = collectPayload();
  el('mainView').classList.add('hidden');
  el('logView').classList.remove('hidden');
  el('logPanel').innerHTML = '';
  el('statusText').textContent = T['applying'];
  el('applyBtn').disabled = true;
  window.pywebview.api.apply(JSON.stringify(payload));
}

const FALLBACK_T = { 'check-error': 'Could not check for updates.', 'retry-check': 'Retry' };

async function runCheck() {
  el('checkingView').classList.remove('hidden');
  el('mainView').classList.add('hidden');
  el('logView').classList.add('hidden');
  el('retryBtn').classList.add('hidden');
  el('closeBtn').classList.add('hidden');
  el('applyBtn').classList.remove('hidden');
  el('applyBtn').disabled = false;
  el('spinner').classList.remove('hidden');
  el('checkingTxt').textContent = (Object.keys(T).length ? T : FALLBACK_T)['checking'] || '';

  try {
    const raw = await window.pywebview.api.check();
    STATE = JSON.parse(raw);
    T = STATE.strings;
    applyStrings();
    renderSystem();
    renderKernel();
    renderAur();
    renderFlatpak();
    renderConfigs();

    el('checkingView').classList.add('hidden');
    el('mainView').classList.remove('hidden');
    const nadaPendiente = STATE.system.length === 0 && STATE.aur.length === 0 && STATE.flatpak.length === 0;
    el('statusText').textContent = nadaPendiente ? T['up-to-date'] : '';
  } catch (e) {
    const t = Object.keys(T).length ? T : FALLBACK_T;
    el('spinner').classList.add('hidden');
    el('checkingTxt').textContent = t['check-error'];
    el('applyBtn').classList.add('hidden');
    el('retryBtn').textContent = t['retry-check'];
    el('retryBtn').classList.remove('hidden');
    console.error('avalos-update check() failed:', e);
  }
}

function closeWindow() {
  if (window.pywebview && window.pywebview.api && window.pywebview.api.close) {
    window.pywebview.api.close();
  }
}

function init() {
  el('applyBtn').addEventListener('click', onApply);
  el('retryBtn').addEventListener('click', runCheck);
  el('closeBtn').addEventListener('click', closeWindow);
  runCheck();
}

window.addEventListener('pywebviewready', init);
</script>
</body>
</html>"""


def main():
    html = _build_html().replace("LANG_PLACEHOLDER", LANG)

    # Mismo fix que avalos-wallpaper (BUG-012): sin esto GTK usa "python3"
    # como app_id en Wayland y la window rule (class = "avalos-update")
    # nunca matchea.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-update")
    except Exception:
        pass

    api = UpdateAPI()
    win = webview.create_window(
        title            = f"AvalOS — {T['title']}",
        html             = html,
        js_api           = api,
        width            = 760,
        height           = 720,
        min_size         = (620, 520),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win

    try:
        webview.start(debug=False)
    except Exception as e:
        print(f"ERROR al iniciar pywebview: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
