# ── Chequeos SIN privilegios ─────────────────────────────────────────────
def _run(cmd, timeout=30):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return -1, "", str(e)


def _check_system_updates():
    # checkupdates (pacman-contrib): base de datos temporal aparte, nunca
    # toca /var/lib/pacman real ni pide contraseña. rc=2 = sin novedades.
    rc, out, _ = _run(["checkupdates"], timeout=60)
    if rc not in (0, 2):
        return []
    items = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[2] == "->":
            items.append({"name": parts[0], "old": parts[1], "new": parts[3]})
    return items


def _check_aur_updates(repo_names):
    # yay -Qu ya incluye AUR sin necesitar -Sy ni contraseña — se filtran
    # los que YA salieron en checkupdates para no duplicar entre listas.
    rc, out, _ = _run(["yay", "-Qu"], timeout=60)
    if rc not in (0, 2):
        return []
    items = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and parts[2] == "->" and parts[0] not in repo_names:
            items.append({"name": parts[0], "old": parts[1], "new": parts[3]})
    return items


def _check_flatpak_updates():
    rc, out, _ = _run(["flatpak", "remote-ls", "--updates", "--app", "--columns=application", "flathub"], timeout=45)
    if rc != 0:
        return []
    return [{"id": line.strip()} for line in out.splitlines() if line.strip()]


def _check_kernel_info():
    variant_installed = None
    for variant, pkg in KERNEL_VARIANTS.items():
        if _run(["pacman", "-Q", pkg])[0] == 0:
            variant_installed = variant
            break
    cpu_arch = "x86-64"
    try:
        with open("/proc/cpuinfo") as f:
            flags = ""
            for line in f:
                if line.startswith("flags"):
                    flags = line.split(":", 1)[1].lower()
                    break
        flag_set = set(flags.split())
        v3 = {"avx", "avx2", "bmi1", "bmi2", "f16c", "fma", "lzcnt", "movbe", "xsave"}
        v4 = {"avx512f", "avx512bw", "avx512cd", "avx512dq", "avx512vl"}
        if v4.issubset(flag_set):
            cpu_arch = "x86-64-v4"
        elif v3.issubset(flag_set):
            cpu_arch = "x86-64-v3"
        else:
            cpu_arch = "x86-64-v2"
    except Exception:
        pass
    return {
        "current_variant": variant_installed,
        "current_pkg": KERNEL_VARIANTS.get(variant_installed),
        "bore_ok": cpu_arch in ("x86-64-v3", "x86-64-v4"),
        "cpu_arch": cpu_arch,
    }


def _check_configs_drift():
    # Lectura sola, sin root: /usr/share/avalos/configs es legible por
    # cualquiera, y el fetch a raw.githubusercontent.com no necesita
    # privilegios tampoco. La escritura real (si el usuario decide
    # sincronizar) sí pasa por el helper con pkexec.
    try:
        local = TEMPLATE_LOCAL.read_text(encoding="utf-8") if TEMPLATE_LOCAL.exists() else ""
    except OSError:
        local = ""
    try:
        with urllib.request.urlopen(f"{REPO_RAW}/configs/hyprland/hyprland_conf_lua.template", timeout=10) as resp:
            remote = resp.read().decode("utf-8")
    except Exception:
        return {"reachable": False, "changed": False, "diff": ""}

    if remote.strip() == local.strip():
        return {"reachable": True, "changed": False, "diff": ""}

    import difflib
    diff = "\n".join(difflib.unified_diff(
        local.splitlines(), remote.splitlines(),
        fromfile="actual (instalado)", tofile="repo (nuevo)", lineterm="",
    ))
    return {"reachable": True, "changed": True, "diff": diff}


# ── API expuesta a la GUI ────────────────────────────────────────────────
class UpdateAPI:
    window = None

    def check(self):
        system = _check_system_updates()
        repo_names = {i["name"] for i in system}
        return json.dumps({
            "strings": T,
            "system": system,
            "kernel": _check_kernel_info(),
            "aur": _check_aur_updates(repo_names),
            "flatpak": _check_flatpak_updates(),
            "configs": _check_configs_drift(),
        })

    def apply(self, payload_json):
        payload = json.loads(payload_json)
        threading.Thread(target=self._apply_worker, args=(payload,), daemon=True).start()
        return json.dumps({"started": True})

    def close(self):
        if self.window:
            self.window.destroy()

    # ── internos ──
    def _jsc(self, func, *args):
        if not self.window:
            return
        encoded = ", ".join(json.dumps(a, ensure_ascii=False) for a in args)
        try:
            self.window.evaluate_js(f"{func}({encoded})")
        except Exception as e:
            print(f"[JS] {e}")

    def _log(self, txt, cls="info"):
        self._jsc("pyLog", txt, cls)

    def _run_helper(self, args):
        cmd = ["pkexec", HELPER_BIN, *args]
        self._log(f"$ {' '.join(args)}", "step")
        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
            )
        except FileNotFoundError:
            self._log("pkexec no está disponible en este sistema.", "err")
            return False
        for line in proc.stdout:
            line = line.rstrip("\n")
            cls = "step" if line.startswith("### ") else "info"
            self._log(line[4:] if line.startswith("### ") else line, cls)
        proc.wait()
        if proc.returncode != 0:
            self._log(f"(código de salida {proc.returncode})", "err")
            return False
        return True

    def _apply_flatpak(self, app_ids):
        # Directo, sin pkexec: flatpak resuelve su propio scope (user o
        # system) y, si hace falta privilegio para system-wide, usa SU
        # PROPIO mecanismo de polkit — envolver esto en avalos-update-helper
        # sería un segundo sistema de privilegios pisando al de flatpak.
        # Streaming en vivo (no _run() bufferizado): apps grandes de
        # flatpak pueden tardar varios minutos, y sin esto el log se veía
        # "colgado" hasta que cada app terminaba entera.
        ok = True
        for app_id in app_ids:
            cmd = ["flatpak", "update", "-y", app_id]
            self._log(f"$ {' '.join(cmd)}", "step")
            try:
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1,
                )
            except FileNotFoundError:
                self._log("flatpak no está disponible en este sistema.", "err")
                return False
            for line in proc.stdout:
                self._log(line.rstrip("\n"), "info")
            proc.wait()
            if proc.returncode != 0:
                self._log(f"(código de salida {proc.returncode})", "err")
                ok = False
        return ok

    def _apply_worker(self, payload):
        ok_all = True
        kernel_touched = False

        # &= (no 'and'/'&&') a propósito: NO es cortocircuito. Si el
        # snapshot falla, igual queremos que se intenten system/kernel/
        # AUR/flatpak — son operaciones independientes entre sí, un
        # fallo temprano no debería cancelar todo lo demás que el
        # usuario pidió en la misma corrida.
        if payload.get("snapshot"):
            ok_all &= self._run_helper(["snapshot", "--description", "avalos-update: antes de actualizar"])

        if payload.get("sync_configs"):
            ok_all &= self._run_helper(["sync-system-files"])

        if payload.get("system"):
            args = ["apply-system"]
            if payload.get("hold_kernel"):
                args.append("--hold-kernel")
            ok_all &= self._run_helper(args)

        variant = payload.get("kernel_variant")
        if variant:
            kernel_touched = True
            ok_all &= self._run_helper(["apply-kernel", "--variant", variant])

        aur_pkgs = payload.get("aur_packages") or []
        if aur_pkgs:
            ok_all &= self._run_helper(["apply-aur", *aur_pkgs])

        flatpak_apps = payload.get("flatpak_apps") or []
        if flatpak_apps:
            ok_all &= self._apply_flatpak(flatpak_apps)

        self._jsc("pyDone", ok_all, kernel_touched)


# ── HTML/CSS/JS embebido (mismo patrón que avalos-wallpaper) ───────────────
