#!/usr/bin/env python3
# ── AvalOS — avalos-restore ─────────────────────────────────────────
# Restaurar el sistema a un snapshot de snapper anterior, en unos pocos
# clics. Corre SIN privilegios, igual que avalos-update — lo único que
# toca root es avalos-update-helper vía pkexec (misma acción de polkit,
# com.avalos.update.run-helper: no hace falta una .policy nueva).
#
# Por qué NO usa `snapper rollback`: AvalOS monta root con subvol=@
# explícito por NOMBRE (ver core/fstab.py del instalador), y con ese
# layout `snapper rollback` no tiene ningún efecto al reiniciar — el
# ioctl que usa por dentro para cambiar el "subvolumen por defecto" del
# filesystem se ignora cuando el mount especifica subvol= explícito. La
# lógica real de la restauración (intercambio atómico de subvolúmenes
# con renameat2) vive en avalos-update-helper — ver el comentario grande
# ahí arriba de cmd_restore para el porqué completo, con la referencia
# exacta.
#
# Requiere: python-pywebview, webkit2gtk-4.1, python-gobject (ya en
# HYPRLAND_PKGS por avalos-wallpaper), btrfs-progs, snapper (ya
# instalados por el instalador).
import json
import subprocess
import sys
import threading
from pathlib import Path

import webview

HELPER_BIN = "/usr/local/bin/avalos-update-helper"

# ── i18n — mismo patrón que avalos-update/avalos-settings/avalos-about ────
_AVALOS_LANG_FILE = Path("/etc/avalos-lang")
_SUPPORTED = ("en", "es", "zh", "ja")


def _detectar_idioma() -> str:
    try:
        code = _AVALOS_LANG_FILE.read_text(encoding="utf-8").strip()
        if code in _SUPPORTED:
            return code
    except OSError:
        pass
    import os
    _lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
    return _lang_raw if _lang_raw in _SUPPORTED else "en"


LANG = _detectar_idioma()

