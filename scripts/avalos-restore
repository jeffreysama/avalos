<script>
const STR = STRINGS_PLACEHOLDER;
let STATE = { points: [], backups: [] };

function el(tag, cls, txt) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (txt !== undefined) e.textContent = txt;
  return e;
}

function pyLog(txt, cls) {
  const box = document.getElementById('active-log');
  if (!box) return;
  const line = el('div', cls || 'info', txt);
  box.appendChild(line);
  box.scrollTop = box.scrollHeight;
}

async function loadPoints() {
  const raw = await window.pywebview.api.list_points();
  const res = JSON.parse(raw);
  const body = document.getElementById('body');
  body.innerHTML = '';
  if (!res.ok) {
    body.appendChild(el('div', 'empty', STR['err-helper']));
    return;
  }
  STATE.points = res.points; STATE.backups = res.backups;
  if (!res.snapper_ok) {
    body.appendChild(el('div', 'warn-banner', STR['snapper-warn']));
  }

  body.appendChild(el('div', 'sec-title', STR['sec-points']));
  if (res.points.length === 0) {
    body.appendChild(el('div', 'empty', STR['no-points']));
  } else {
    res.points.forEach(function (p) {
      const row = el('div', 'point');
      row.appendChild(el('div', 'num', '#' + p.number));
      const info = el('div', 'info');
      info.appendChild(el('div', 'date', p.date || ''));
      info.appendChild(el('div', 'desc', p.description || ''));
      row.appendChild(info);
      const btn = el('button', 'btn primary', STR['btn-restore']);
      btn.onclick = function () { showRestoreConfirm(p.number); };
      row.appendChild(btn);
      body.appendChild(row);
    });
  }

  if (res.backups.length > 0) {
    body.appendChild(el('div', 'sec-title', STR['sec-backups']));
    body.appendChild(el('div', 'sec-desc', STR['sec-backups-d']));
    res.backups.forEach(function (name) {
      const row = el('div', 'backup');
      row.appendChild(el('div', 'date', backupLabel(name)));
      const btn = el('button', 'btn danger', STR['btn-delete']);
      btn.onclick = function () { showDeleteConfirm(name); };
      row.appendChild(btn);
      body.appendChild(row);
    });
  }
}

function backupLabel(name) {
  // "@.avalos-restore-backup-20260921-143012-004213" -> "2026-09-21 14:30:12"
  const m = name.match(/backup-(\\d{4})(\\d{2})(\\d{2})-(\\d{2})(\\d{2})(\\d{2})/);
  if (!m) return name;
  return m[1] + '-' + m[2] + '-' + m[3] + ' ' + m[4] + ':' + m[5] + ':' + m[6];
}

function renderPanel() {
  const body = document.getElementById('body');
  body.innerHTML = '';
  const panel = el('div', 'panel');
  body.appendChild(panel);
  return panel;
}

function showRestoreConfirm(number) {
  const panel = renderPanel();
  panel.appendChild(el('h2', null, STR['confirm-restore-title'].replace('{number}', number)));
  panel.appendChild(el('p', null, STR['confirm-restore-body']));
  const row = el('div', 'row');
  const cancel = el('button', 'btn ghost', STR['confirm-restore-cancel']);
  cancel.onclick = loadPoints;
  const yes = el('button', 'btn primary', STR['confirm-restore-yes']);
  yes.onclick = function () { runRestore(number); };
  row.appendChild(cancel); row.appendChild(yes);
  panel.appendChild(row);
}

function runRestore(number) {
  const panel = renderPanel();
  panel.appendChild(el('h2', null, STR['restoring']));
  const log = el('div', 'log'); log.id = 'active-log';
  panel.appendChild(log);
  window._pfPendingNumber = number;
  window.pywebview.api.restore(number);
}

function pyRestoreDone(ok, number) {
  const body = document.getElementById('body');
  body.innerHTML = '';
  const panel = el('div', 'panel');
  if (ok) {
    panel.appendChild(el('div', 'done-icon ok', '✔'));
    panel.appendChild(el('h2', null, STR['restore-done-title']));
    panel.appendChild(el('p', null, STR['restore-done-body'].replace('{number}', number)));
    const row = el('div', 'row');
    const later = el('button', 'btn ghost', STR['btn-reboot-later']);
    later.onclick = loadPoints;
    const now = el('button', 'btn primary', STR['btn-reboot-now']);
    now.onclick = function () { window.pywebview.api.reboot_now(); };
    row.appendChild(later); row.appendChild(now);
    panel.appendChild(row);
  } else {
    panel.appendChild(el('div', 'done-icon fail', '✖'));
    panel.appendChild(el('h2', null, STR['restore-failed']));
    const log = el('div', 'log'); log.id = 'active-log';
    panel.appendChild(log);
    const row = el('div', 'row');
    const back = el('button', 'btn ghost', STR['back']);
    back.onclick = loadPoints;
    row.appendChild(back);
    panel.appendChild(row);
  }
  body.appendChild(panel);
}

function showDeleteConfirm(name) {
  const panel = renderPanel();
  panel.appendChild(el('h2', null, STR['confirm-delete-title']));
  panel.appendChild(el('p', null, STR['confirm-delete-body']));
  const row = el('div', 'row');
  const cancel = el('button', 'btn ghost', STR['confirm-delete-cancel']);
  cancel.onclick = loadPoints;
  const yes = el('button', 'btn danger', STR['confirm-delete-yes']);
  yes.onclick = function () { runDelete(name); };
  row.appendChild(cancel); row.appendChild(yes);
  panel.appendChild(row);
}

function runDelete(name) {
  const panel = renderPanel();
  panel.appendChild(el('h2', null, STR['deleting']));
  const log = el('div', 'log'); log.id = 'active-log';
  panel.appendChild(log);
  window.pywebview.api.delete_backup(name);
}

function pyDeleteDone(ok, name) {
  if (ok) { loadPoints(); return; }
  const body = document.getElementById('body');
  body.innerHTML = '';
  const panel = el('div', 'panel');
  panel.appendChild(el('div', 'done-icon fail', '✖'));
  panel.appendChild(el('h2', null, STR['delete-failed']));
  const log = el('div', 'log'); log.id = 'active-log';
  panel.appendChild(log);
  const row = el('div', 'row');
  const back = el('button', 'btn ghost', STR['back']);
  back.onclick = loadPoints;
  row.appendChild(back);
  panel.appendChild(row);
  body.appendChild(panel);
}

window.addEventListener('pywebviewready', loadPoints);
</script>
</body>
</html>"""


def main():
    html = (_build_html()
            .replace("LANG_PLACEHOLDER", LANG)
            .replace("STR_TITLE", T["title"])
            .replace("STR_SUBTITLE", T["subtitle"])
            .replace("STR_LOADING", T["loading"])
            .replace("STRINGS_PLACEHOLDER", json.dumps(T, ensure_ascii=False)))

    # Mismo fix que avalos-wallpaper/avalos-update (BUG-012): sin esto GTK
    # usa "python3" como app_id en Wayland y la window rule (class =
    # "avalos-restore") nunca matchea.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-restore")
    except Exception:
        pass

    api = RestoreAPI()
    win = webview.create_window(
        title            = f"AvalOS — {T['title']}",
        html             = html,
        js_api           = api,
        width            = 620,
        height           = 640,
        min_size         = (480, 460),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win

    try:
        webview.start(debug=False)
    except Exception as e:
        print(f"ERROR al iniciar pywebview: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
