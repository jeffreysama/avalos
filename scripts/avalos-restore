# ── API expuesta a la GUI ───────────────────────────────────────────
class RestoreAPI:
    window = None

    def list_points(self):
        ok, lines = self._run_helper_capture(["list-restore-points"])
        if not ok or not lines:
            return json.dumps({"ok": False, "points": [], "backups": [], "snapper_ok": False})
        try:
            data = json.loads(lines[-1])
        except (ValueError, IndexError):
            return json.dumps({"ok": False, "points": [], "backups": [], "snapper_ok": False})
        return json.dumps({
            "ok": True,
            "points": data.get("points", []),
            "backups": data.get("backups", []),
            "snapper_ok": data.get("snapper_ok", True),
        })

    def restore(self, number):
        threading.Thread(target=self._restore_worker, args=(int(number),), daemon=True).start()
        return json.dumps({"started": True})

    def delete_backup(self, name):
        threading.Thread(target=self._delete_worker, args=(name,), daemon=True).start()
        return json.dumps({"started": True})

    def reboot_now(self):
        # Sin pkexec a propósito: reiniciar la sesión activa es una acción
        # de logind (org.freedesktop.login1.reboot) que ya autoriza a
        # cualquier usuario con sesión activa al frente — envolverlo en el
        # pkexec de avalos-update-helper sería pedir una segunda
        # contraseña para algo que el botón de apagado del sistema ya
        # hace sin pedir ninguna.
        try:
            subprocess.Popen(["systemctl", "reboot"])
        except FileNotFoundError:
            self._log("systemctl no está disponible en este sistema.", "err")

    def close(self):
        if self.window:
            self.window.destroy()

    # ── internos ──
    def _jsc(self, func, *args):
        if not self.window:
            return
        encoded = ", ".join(json.dumps(a, ensure_ascii=False) for a in args)
        try:
            self.window.evaluate_js(f"{func}({encoded})")
        except Exception as e:
            print(f"[JS] {e}")

    def _log(self, txt, cls="info"):
        self._jsc("pyLog", txt, cls)

    def _run_helper_capture(self, args):
        """Como avalos-update._run_helper, pero además junta las líneas
        que NO llevan el prefijo '### ' — la narración (_out) va al log
        en vivo igual que en avalos-update; la salida "de datos" real
        (el JSON de una sola línea que imprime list-restore-points) es
        la que se devuelve para que el caller la parsee."""
        cmd = ["pkexec", HELPER_BIN, *args]
        self._log(f"$ {' '.join(args)}", "step")
        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1,
            )
        except FileNotFoundError:
            self._log("pkexec no está disponible en este sistema.", "err")
            return False, []
        captured = []
        for line in proc.stdout:
            line = line.rstrip("\n")
            if line.startswith("### "):
                rest = line[4:]
                cls = "err" if rest.startswith("ERROR:") else "step" if rest.startswith("$ ") else "info"
                self._log(rest, cls)
            elif line.strip():
                captured.append(line)
        proc.wait()
        if proc.returncode != 0:
            self._log(f"(código de salida {proc.returncode})", "err")
            return False, captured
        return True, captured

    def _restore_worker(self, number):
        ok, _ = self._run_helper_capture(["restore", "--number", str(number)])
        self._jsc("pyRestoreDone", ok, number)

    def _delete_worker(self, name):
        ok, _ = self._run_helper_capture(["delete-backup", "--name", name])
        self._jsc("pyDeleteDone", ok, name)


