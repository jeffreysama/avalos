  header .count { font-size: 11.5px; color: var(--text-dim); }

  .fitbar { display: flex; gap: 8px; padding: 12px 22px; border-bottom: 1px solid var(--border);
    flex-shrink: 0; }
  .fit-btn { display: flex; align-items: center; gap: 8px; background: var(--surface);
