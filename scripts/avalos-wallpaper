<body>
<div class="app">
  <header>
    <h1>AvalOS — <span class="accent">TITLE_PLACEHOLDER</span></h1>
    <span class="count" id="count"></span>
  </header>
  <div class="fitbar" id="fitbar"></div>
  <div class="grid-wrap"><div class="grid" id="grid"></div></div>
  <footer id="status"></footer>
</div>

<script>
let T = {};
let STATE = { items: [], current: null, fit_mode: 'cover' };

const FIT_ICONS = {
  cover:   '<svg viewBox="0 0 18 13"><rect x="0.5" y="0.5" width="17" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1"/><rect x="-2" y="1.5" width="22" height="10" fill="currentColor" opacity="0.85"/></svg>',
  contain: '<svg viewBox="0 0 18 13"><rect x="0.5" y="0.5" width="17" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1"/><rect x="3" y="3" width="12" height="7" fill="currentColor" opacity="0.85"/></svg>',
  fill:    '<svg viewBox="0 0 18 13"><rect x="0.5" y="0.5" width="17" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1"/><rect x="1.5" y="1.5" width="15" height="10" fill="currentColor" opacity="0.85"/></svg>',
  tile:    '<svg viewBox="0 0 18 13"><rect x="0.5" y="0.5" width="17" height="12" rx="1.5" fill="none" stroke="currentColor" stroke-width="1"/>' +
           '<rect x="1.5" y="1.5" width="7" height="5" fill="currentColor" opacity="0.85"/><rect x="9.5" y="1.5" width="7" height="5" fill="currentColor" opacity="0.55"/>' +
           '<rect x="1.5" y="6.5" width="7" height="5" fill="currentColor" opacity="0.55"/><rect x="9.5" y="6.5" width="7" height="5" fill="currentColor" opacity="0.85"/></svg>',
};

function encodePath(p) {
  return p.split('/').map(encodeURIComponent).join('/');
}

function setStatus(msg, kind) {
  const el = document.getElementById('status');
  el.textContent = msg || '';
  el.className = kind || '';
}

function renderFitBar() {
  const bar = document.getElementById('fitbar');
  bar.innerHTML = '';
  for (const mode of ['cover', 'contain', 'fill', 'tile']) {
    const btn = document.createElement('button');
    btn.className = 'fit-btn' + (STATE.fit_mode === mode ? ' active' : '');
    btn.innerHTML = FIT_ICONS[mode];
    const lbl = document.createElement('span');
    lbl.className = 'lbl';
    const main = document.createElement('span');
    main.textContent = T['fit-' + mode];
    const d = document.createElement('span');
    d.className = 'd';
    d.textContent = T['fit-' + mode + '-d'];
    lbl.appendChild(main);
    lbl.appendChild(d);
    btn.appendChild(lbl);
    btn.addEventListener('click', () => setFitMode(mode));
    bar.appendChild(btn);
  }
}

function renderGrid() {
  const grid = document.getElementById('grid');
  grid.innerHTML = '';
  const count = document.getElementById('count');

  if (STATE.items.length === 0) {
    count.textContent = '';
    grid.style.display = 'block';
    const empty = document.createElement('div');
    empty.className = 'empty';
    empty.innerHTML = '<div class="big">🖼</div>' +
      '<div class="t">' + T['empty-title'] + '</div>' +
      '<div class="b">' + T['empty-body'].replace('~/Pictures/Wallpapers', '<code>~/Pictures/Wallpapers</code>') + '</div>';
    grid.appendChild(empty);
    return;
  }

  grid.style.display = 'grid';
  count.textContent = (STATE.items.length === 1 ? T['found_one'] : T['found_many']).replace('{n}', STATE.items.length);

  for (const it of STATE.items) {
    const card = document.createElement('div');
    card.className = 'card' + (it.path === STATE.current ? ' selected' : '');

    const thumbWrap = document.createElement('div');
    thumbWrap.className = 'thumb-wrap';
    const img = document.createElement('img');
    img.loading = 'lazy';
    img.alt = it.name;
    img.src = 'file://' + encodePath(it.path);
    thumbWrap.appendChild(img);
    const check = document.createElement('div');
    check.className = 'check';
    check.textContent = '✓';
    thumbWrap.appendChild(check);

    const meta = document.createElement('div');
    meta.className = 'meta';
    const fname = document.createElement('span');
    fname.className = 'fname';
    fname.textContent = it.name;
    fname.title = it.name;
    const fdir = document.createElement('span');
    fdir.className = 'fdir';
    fdir.textContent = it.dir;
    meta.appendChild(fname);
    meta.appendChild(fdir);

    card.appendChild(thumbWrap);
    card.appendChild(meta);
    card.addEventListener('click', () => selectWallpaper(it.path));
    grid.appendChild(card);
  }
}

async function selectWallpaper(path) {
  setStatus(T['applying'], 'pending');
  try {
    const raw = await window.pywebview.api.apply(path, STATE.fit_mode);
    const res = JSON.parse(raw);
    if (res.ok) {
      STATE.current = path;
      renderGrid();
      setStatus(res.message, 'ok');
    } else {
      setStatus(res.message, 'err');
    }
  } catch (e) {
    setStatus(String(e), 'err');
  }
}

async function setFitMode(mode) {
  STATE.fit_mode = mode;
  renderFitBar();
  if (STATE.current) {
    await selectWallpaper(STATE.current);
  }
}

async function init() {
  const raw = await window.pywebview.api.list();
  const data = JSON.parse(raw);
  T = data.strings;
  STATE.items = data.items;
  STATE.current = data.current;
  STATE.fit_mode = data.fit_mode || 'cover';
  document.title = T['title'];
  renderFitBar();
  renderGrid();
}

window.addEventListener('pywebviewready', init);
</script>
</body>
</html>"""


def main():
    html = (_build_html()
            .replace("LANG_PLACEHOLDER", LANG)
            .replace("TITLE_PLACEHOLDER", T["title"].split("— ", 1)[-1]))

    # Mismo fix que el instalador (BUG-012): sin esto, GTK usa "python3"
    # como app_id en Wayland y la window rule (class = "avalos-wallpaper")
    # nunca matchea, así que la ventana no abre flotante/centrada.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-wallpaper")
    except Exception:
        pass

    api = WallpaperAPI()
    win = webview.create_window(
        title            = T["title"],
        html             = html,
        js_api           = api,
        width            = 1000,
        height           = 700,
        min_size         = (700, 500),
        resizable        = True,
        background_color = "#1a1b26",
    )

    try:
        webview.start(debug=False)
    except Exception as e:
        print(f"ERROR al iniciar pywebview: {e}")
        print("Asegúrate de que webkit2gtk-4.1 esté instalado:")
        print("  pacman -S webkit2gtk-4.1 python-gobject")
        sys.exit(1)


if __name__ == "__main__":
    main()
