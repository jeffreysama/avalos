#!/usr/bin/env python3
# ── AvalOS — avalos-wallpaper ──────────────────────────────────────────────
# Reescritura completa: antes era un menú de texto en rofi que identificaba
# wallpapers por NOMBRE DE ARCHIVO. Con 3+ archivos del mismo nombre en
# carpetas distintas, el reemplazo por substring de bash corrompía el menú
# (display_list y la tabla de rutas quedaban desincronizados — probado y
# reproducido en sandbox). Esta versión identifica cada wallpaper por su
# RUTA COMPLETA (nunca por nombre) y muestra un preview real de cada uno,
# así que el problema de nombres duplicados queda resuelto de raíz: dos
# archivos "wallpaper.png" en carpetas distintas simplemente se ven como
# dos tarjetas distintas con su propia imagen.
#
# También agrega selector de fit_mode (cover/contain/fill/tile), posible
# porque hyprpaper se reescribió sobre hyprtoolkit (dic-2025/ene-2026) y
# cambió su sintaxis de config — ver hyprpaper.conf para el detalle.
#
# Requiere: python-pywebview, webkit2gtk-4.1, python-gobject
# (agregados a HYPRLAND_PKGS en skill_instalar_usb.py).
import json
import os
import re
import subprocess
import sys
from pathlib import Path

try:
    import webview
except ImportError:
    print("ERROR: pywebview no está instalado.")
    print("Instala con: pacman -S python-pywebview webkit2gtk-4.1 python-gobject")
    sys.exit(1)

HOME = Path.home()
HYPR_DIR = HOME / ".config" / "hypr"
HYPR_CONF = HYPR_DIR / "hyprpaper.conf"

WALLPAPER_DIRS = [
    HOME / "Pictures" / "Wallpapers",
    HOME / "Pictures" / "wallpapers",
    HOME / ".local" / "share" / "avalos" / "wallpapers",
    Path("/usr/share/avalos/wallpapers"),
    Path("/usr/share/backgrounds"),
]
EXTS = {".jpg", ".jpeg", ".png", ".webp"}
MAX_DEPTH = 4
FIT_MODES = ("cover", "contain", "fill", "tile")

# ── i18n — autocontenido, mismo patrón que avalos-about/avalos-settings ────
_lang_raw = os.environ.get("LANG", "en_US").split("_")[0].split(".")[0]
LANG = _lang_raw if _lang_raw in ("es", "zh") else "en"

