        "fit-contain": "适应", "fit-contain-d": "完整显示，可能留边",
        "fit-fill": "拉伸", "fit-fill-d": "拉伸填充，可能变形",
        "fit-tile": "平铺", "fit-tile-d": "重复图像",
        "empty-title": "未找到壁纸",
        "empty-body": "请将图片添加到 ~/Pictures/Wallpapers 后重新打开此应用。",
        "applying": "应用中…",
        "applied": "壁纸已应用",
        "err-notfound": "文件已不存在",
        "err-write": "无法写入 hyprpaper.conf",
        "err-restart": "无法重启 hyprpaper",
        "current-badge": "当前",
    },
