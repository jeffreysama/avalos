    border-color: transparent; font-weight: 600; }
  .fit-btn svg { width: 18px; height: 13px; flex-shrink: 0; }
  .fit-btn .lbl { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.25; }
  .fit-btn .lbl .d { font-size: 9.5px; opacity: .75; font-weight: 400; }

  .grid-wrap { flex: 1; overflow-y: auto; padding: 18px 22px 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }

  .card { cursor: pointer; border-radius: 10px; overflow: hidden; background: var(--surface);
    border: 2px solid transparent; transition: transform .12s, border-color .12s; }
  .card:hover { transform: translateY(-2px); }
  .card.selected { border-color: var(--blue); box-shadow: 0 0 0 1px var(--purple); }
  .thumb-wrap { position: relative; aspect-ratio: 16/10; background: var(--bg-alt); }
  .thumb-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .check { position: absolute; top: 6px; right: 6px; width: 20px; height: 20px; border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), var(--purple)); color: var(--bg);
    display: none; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; }
