T = STRINGS[LANG]


# ── Escaneo de wallpapers ───────────────────────────────────────────────
def _walk_limited(base: Path, max_depth: int):
    if not base.is_dir():
        return
    base_depth = len(base.resolve().parts)
    for root, dirs, files in os.walk(base, followlinks=False):
        depth = len(Path(root).parts) - base_depth
        if depth >= max_depth:
            dirs[:] = []
        for fn in files:
            p = Path(root) / fn
            if p.suffix.lower() in EXTS:
                yield p


def list_wallpapers():
    """Dedup por RUTA COMPLETA resuelta — nunca por nombre. Esto es lo que
    elimina de raíz el bug de colisión de nombres del bash original."""
    seen = set()
    items = []
    for d in WALLPAPER_DIRS:
        try:
            candidates = sorted(_walk_limited(d, MAX_DEPTH))
        except Exception:
            continue
        for p in candidates:
            try:
                rp = str(p.resolve())
            except Exception:
                continue
            if rp in seen:
                continue
            seen.add(rp)
            items.append({"path": rp, "name": p.name, "dir": p.parent.name})
    items.sort(key=lambda x: (x["dir"].lower(), x["name"].lower()))
    return items


# ── Estado actual (leer hyprpaper.conf existente) ───────────────────────
_BLOCK_RE = re.compile(r"wallpaper\s*\{([^}]*)\}", re.S)
_PATH_RE = re.compile(r"^\s*path\s*=\s*(.+?)\s*$", re.M)
_FIT_RE = re.compile(r"^\s*fit_mode\s*=\s*(\w+)\s*$", re.M)


def _current_state():
    if not HYPR_CONF.is_file():
        return None, "cover"
    try:
        text = HYPR_CONF.read_text(encoding="utf-8")
    except Exception:
        return None, "cover"
    m = _BLOCK_RE.search(text)
    if not m:
        return None, "cover"
    block = m.group(1)
    path, fit = None, "cover"
    pm = _PATH_RE.search(block)
    if pm:
        try:
            path = str(Path(os.path.expanduser(pm.group(1))).resolve())
        except Exception:
            path = None
    fm = _FIT_RE.search(block)
    if fm and fm.group(1) in FIT_MODES:
        fit = fm.group(1)
    return path, fit


# ── API expuesta a JS vía pywebview ─────────────────────────────────────
class WallpaperAPI:
    def list(self):
        cur_path, cur_fit = _current_state()
        return json.dumps({
            "items": list_wallpapers(),
            "current": cur_path,
            "fit_mode": cur_fit,
            "strings": T,
        })

    def apply(self, path, fit_mode):
        if fit_mode not in FIT_MODES:
            fit_mode = "cover"
        p = Path(path)
        if not p.is_file():
            return json.dumps({"ok": False, "message": T["err-notfound"]})

        try:
            HYPR_DIR.mkdir(parents=True, exist_ok=True)
            content = (
                "# Generado por avalos-wallpaper — no editar a mano,\n"
                "# se sobreescribe cada vez que cambiás de fondo.\n"
                "wallpaper {\n"
                "    monitor =\n"
                f"    path = {p}\n"
                f"    fit_mode = {fit_mode}\n"
                "}\n\nsplash = false\nipc = on\n"
            )
            HYPR_CONF.write_text(content, encoding="utf-8")
        except Exception as e:
            return json.dumps({"ok": False, "message": f"{T['err-write']}: {e}"})

        # Intento 1: aplicar en caliente vía IPC (sin matar el proceso)
        live_ok = False
        try:
            r = subprocess.run(
                ["hyprctl", "hyprpaper", "wallpaper", f",{p},{fit_mode}"],
                capture_output=True, timeout=5, text=True,
            )
            live_ok = (r.returncode == 0)
        except Exception:
            live_ok = False

        # Fallback: reiniciar hyprpaper si el IPC no respondió (daemon caído,
        # socket no disponible, etc.) — relee hyprpaper.conf ya actualizado.
        if not live_ok:
            subprocess.run(["pkill", "-x", "hyprpaper"], capture_output=True)
            try:
                subprocess.Popen(
                    ["hyprpaper"], start_new_session=True,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception as e:
                return json.dumps({"ok": False, "message": f"{T['err-restart']}: {e}"})

        subprocess.run(
            ["notify-send", "AvalOS", f"{T['applied']}: {p.name}",
             "-i", "preferences-desktop-wallpaper", "-t", "2500"],
            capture_output=True,
        )
        return json.dumps({"ok": True, "message": T["applied"], "live": live_ok})


# ── HTML/CSS/JS embebido (mismo patrón que skill_instalar_usb.py) ──────────
def _build_html():
    return r"""<!DOCTYPE html>
<html lang="LANG_PLACEHOLDER">
<head>
<meta charset="UTF-8">
<style>
  :root {
    --bg: #1a1b26; --bg-alt: #16161e; --surface: #1f2335; --surface-hi: #292e42;
    --border: #414868; --text: #c0caf5; --text-dim: #565f89;
    --blue: #7aa2f7; --purple: #bb9af7; --green: #9ece6a; --red: #f7768e;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: "JetBrainsMono Nerd Font", ui-monospace, "Cascadia Code", monospace;
    overflow: hidden; height: 100%; }
  .app { display: flex; flex-direction: column; height: 100vh; }

  header { padding: 16px 22px 14px; border-bottom: 1px solid var(--border);
