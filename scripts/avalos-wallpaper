T = STRINGS[LANG]


# ── Escaneo de wallpapers ───────────────────────────────────────────────
def _walk_limited(base: Path, max_depth: int):
    if not base.is_dir():
        return
    base_depth = len(base.resolve().parts)
    for root, dirs, files in os.walk(base, followlinks=False):
        depth = len(Path(root).parts) - base_depth
        if depth >= max_depth:
            dirs[:] = []
        for fn in files:
            p = Path(root) / fn
            if p.suffix.lower() in EXTS:
                yield p


def list_wallpapers():
    """Dedup por RUTA COMPLETA resuelta — nunca por nombre. Esto es lo que
    elimina de raíz el bug de colisión de nombres del bash original."""
    seen = set()
    items = []
    for d in WALLPAPER_DIRS:
        try:
            candidates = sorted(_walk_limited(d, MAX_DEPTH))
        except Exception:
            continue
        for p in candidates:
            try:
                rp = str(p.resolve())
            except Exception:
                continue
            if rp in seen:
                continue
            seen.add(rp)
            items.append({"path": rp, "name": p.name, "dir": p.parent.name})
    items.sort(key=lambda x: (x["dir"].lower(), x["name"].lower()))
    return items


# ── Estado actual (leer hyprpaper.conf existente) ───────────────────────
_BLOCK_RE = re.compile(r"wallpaper\s*\{([^}]*)\}", re.S)
_PATH_RE = re.compile(r"^\s*path\s*=\s*(.+?)\s*$", re.M)
_FIT_RE = re.compile(r"^\s*fit_mode\s*=\s*(\w+)\s*$", re.M)


def _current_state():
    if not HYPR_CONF.is_file():
        return None, "cover"
    try:
        text = HYPR_CONF.read_text(encoding="utf-8")
    except Exception:
        return None, "cover"
    m = _BLOCK_RE.search(text)
    if not m:
        return None, "cover"
    block = m.group(1)
    path, fit = None, "cover"
    pm = _PATH_RE.search(block)
    if pm:
        try:
            path = str(Path(os.path.expanduser(pm.group(1))).resolve())
        except Exception:
            path = None
    fm = _FIT_RE.search(block)
    if fm and fm.group(1) in FIT_MODES:
        fit = fm.group(1)
    return path, fit


# ── Ruta segura para hyprpaper.conf ─────────────────────────────────────
# hyprlang interpreta caracteres dentro de los VALORES (verificado contra la librería real, hyprlang 0.6.8):
#   '#'  empieza un comentario → «Sunset #3.png» quedaba como «/…/Sunset» (y '##' no se puede escribir
#        de forma fiable: «####» también se trunca);
#   '$'  expande variables y el entorno → «$HOME.png» se convertía en «/root.png»;
#   '{{' es una expresión → la config entera se rechazaba; una barra invertida seguida de otra barra, de '{'
#        o de '}' se des-escapa;
#   un salto de línea parte la línea → «Invalid config line» y hyprpaper no arranca en el siguiente login.
# En vez de intentar escapar (poco fiable), `path` apunta siempre a un enlace simbólico fijo con nombre
# seguro hacia la imagen elegida. _current_state() ya hace .resolve(), así que el «Actual» sigue funcionando.
LINK_BASE = "avalos-wallpaper-current"
_HYPRLANG_ESPECIALES = set("#${}\\")


def _hyprlang_seguro(texto: str) -> bool:
    """True si el texto puede ir tal cual como valor en hyprpaper.conf (ni especiales de hyprlang ni controles)."""
    return not any(c in _HYPRLANG_ESPECIALES or ord(c) < 32 or ord(c) == 127 for c in texto)


def _enlace_a(p: Path) -> Path:
    """Crea (de forma atómica) el enlace HYPR_DIR/avalos-wallpaper-current<ext> → p y devuelve su ruta. Borra solo
    enlaces simbólicos propios de otras extensiones, nunca archivos reales. hyprpaper decide el formato por el
    contenido (libmagic), no por la extensión, así que la extensión del enlace es solo cosmética."""
    HYPR_DIR.mkdir(parents=True, exist_ok=True)
    ext = p.suffix.lower() if p.suffix.lower() in EXTS else ".png"
    link = HYPR_DIR / f"{LINK_BASE}{ext}"
    tmp = HYPR_DIR / f".{LINK_BASE}.{os.getpid()}.tmp"
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
    os.symlink(str(p), tmp)
    try:
        os.replace(tmp, link)
    except OSError:
        tmp.unlink(missing_ok=True)
        raise
    for otra in EXTS - {ext}:
        viejo = HYPR_DIR / f"{LINK_BASE}{otra}"
        if viejo.is_symlink():
            viejo.unlink(missing_ok=True)
    return link


# ── Miniaturas ──────────────────────────────────────────────────────────
def _thumb_data_uri(p: Path) -> str:
    """Miniatura como data: URI. WebKitGTK no deja cargar <img src="file://…"> desde una página en memoria (las
    miniaturas salían negras con webkit2gtk 2.54.3 + pywebview 6.2.1), así que la imagen viaja por la API de Python.
    Con Pillow se reduce a THUMB_MAX y se manda como JPEG; sin Pillow se manda el archivo tal cual si no pesa mucho."""
    try:
        from PIL import Image
    except ImportError:
        Image = None
    if Image is None:
        if p.stat().st_size > RAW_MAX_BYTES:
            return ""
        mime = _MIME.get(p.suffix.lower(), "image/png")
        return f"data:{mime};base64," + base64.b64encode(p.read_bytes()).decode("ascii")
    with Image.open(p) as im:
        im.draft("RGB", THUMB_MAX)          # JPEG: lo decodifica ya reducido (no hace nada con otros formatos)
        if im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info):
            im = im.convert("RGBA")
            fondo = Image.new("RGB", im.size, (22, 22, 30))   # --bg-alt de la UI
            fondo.paste(im, mask=im.getchannel("A"))
            im = fondo
        else:
            im = im.convert("RGB")
        im.thumbnail(THUMB_MAX)
        out = io.BytesIO()
        im.save(out, "JPEG", quality=82, optimize=True)
    return "data:image/jpeg;base64," + base64.b64encode(out.getvalue()).decode("ascii")


# ── API expuesta a JS vía pywebview ─────────────────────────────────────
class WallpaperAPI:
    def __init__(self):
        self._listed = set()    # rutas que list() mostró: thumb() no sirve nada fuera de esa lista

    def thumb(self, path):
        if not isinstance(path, str) or path not in self._listed:
            return ""
        try:
            return _thumb_data_uri(Path(path))
        except Exception:       # imagen corrupta, enorme, ilegible…: sin miniatura, pero la app sigue
            return ""

    def list(self):
        cur_path, cur_fit = _current_state()
        items = list_wallpapers()
        self._listed = {it["path"] for it in items}
        return json.dumps({
            "items": items,
            "current": cur_path,
            "fit_mode": cur_fit,
            "strings": T,
        })

    def apply(self, path, fit_mode):
        if fit_mode not in FIT_MODES:
            fit_mode = "cover"
        if not isinstance(path, str) or not path:
            return json.dumps({"ok": False, "message": T["err-notfound"]})
        p = Path(path).expanduser()
        if not p.is_absolute() or not p.is_file():
            return json.dumps({"ok": False, "message": T["err-notfound"]})

        try:
            link = _enlace_a(p)
            if not _hyprlang_seguro(str(link)):   # HOME rarísimo con '#', '$'… — mejor fallar que escribir una config rota
                raise ValueError(f"la ruta {link} tiene caracteres que hyprlang interpreta")
            content = (
                "# Generado por avalos-wallpaper — no editar a mano,\n"
                "# se sobreescribe cada vez que cambiás de fondo.\n"
                "# `path` es un enlace simbólico fijo hacia la imagen elegida (ver _enlace_a en avalos-wallpaper).\n"
                "wallpaper {\n"
                "    monitor =\n"
                f"    path = {link}\n"
                f"    fit_mode = {fit_mode}\n"
                "}\n\nsplash = false\nipc = on\n"
            )
            # atómico: un corte a mitad de write_text dejaba hyprpaper.conf truncado y hyprpaper sin arrancar
            tmp_conf = HYPR_CONF.with_name(f".{HYPR_CONF.name}.{os.getpid()}.tmp")
            try:
                tmp_conf.write_text(content, encoding="utf-8")
                os.replace(tmp_conf, HYPR_CONF)
            except BaseException:
                try:
                    tmp_conf.unlink()
                except OSError:
                    pass
                raise
        except Exception as e:
            return json.dumps({"ok": False, "message": f"{T['err-write']}: {e}"})

        # Intento 1: aplicar en caliente vía IPC (sin matar el proceso)
        live_ok = False
        try:
            r = subprocess.run(
                ["hyprctl", "hyprpaper", "wallpaper", f",{link},{fit_mode}"],
                capture_output=True, timeout=5, text=True,
            )
            live_ok = (r.returncode == 0)
        except Exception:
            live_ok = False

        # Fallback: reiniciar hyprpaper si el IPC no respondió (daemon caído,
        # socket no disponible, etc.) — relee hyprpaper.conf ya actualizado.
        if not live_ok:
            subprocess.run(["pkill", "-x", "hyprpaper"], capture_output=True)
            try:
                subprocess.Popen(
                    ["hyprpaper"], start_new_session=True,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                )
            except Exception as e:
                return json.dumps({"ok": False, "message": f"{T['err-restart']}: {e}"})

        subprocess.run(
            ["notify-send", "AvalOS", f"{T['applied']}: {p.name}",
             "-i", "preferences-desktop-wallpaper", "-t", "2500"],
            capture_output=True,
        )
        return json.dumps({"ok": True, "message": T["applied"], "live": live_ok})


