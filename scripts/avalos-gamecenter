# ── Utilidades ─────────────────────────────────────────────────────────────
def _read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def _config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")


def _data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share")


def _run(cmd, timeout):
    """(código, salida) o None si no se pudo ni lanzar. Nunca lanza."""
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    return res.returncode, (res.stdout or "") + (res.stderr or "")


def _spawn(cmd) -> bool:
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def _has_display() -> bool:
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


# ── Lanzadores ─────────────────────────────────────────────────────────────
def _flatpak_installed(app_id: str) -> bool:
    if not shutil.which("flatpak"):
        return False
    return any((root / app_id).is_dir() for root in (_data_home() / "flatpak" / "app", FLATPAK_SYSTEM_APPS))


def resolve_launcher(launcher_id):
    """El comando con el que se abre ese lanzador en este sistema, o None si no está instalado."""
    for argv in LAUNCHER_CANDIDATES.get(launcher_id, ()):
        if argv[0] == "flatpak":
            if _flatpak_installed(argv[2]):
                return list(argv)
        elif shutil.which(argv[0]):
            return list(argv)
    return None


def launchers_available() -> dict:
    return {lid: resolve_launcher(lid) is not None for lid, _n, _c, _i in LAUNCHERS}


# ── GameMode ───────────────────────────────────────────────────────────────
def parse_gamemode_status(output: str) -> str:
    """«gamemode is active» -> active; «gamemode is inactive» -> idle; otra cosa -> unknown.
    («inactive» contiene «active»: se mira primero.)"""
    low = output.lower()
    if re.search(r"\binactive\b", low):
        return "idle"
    if re.search(r"\bactive\b", low):
        return "active"
    return "unknown"


def parse_gamemode_ini(text: str) -> dict:
    """Lo que interesa de un gamemode.ini. «whitelist=» puede repetirse (una línea por programa),
    por eso se lee línea a línea y no con configparser, que se quedaría con la última."""
    out = {"desiredgov": None, "whitelist": [], "blacklist": []}
    section = ""
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip().lower()
            continue
        key, sep, value = line.partition("=")
        key, value = key.strip().lower(), value.strip()
        if not sep or not value:
            continue
        if section == "general" and key == "desiredgov":
            out["desiredgov"] = value
        elif section == "filter" and key in ("whitelist", "blacklist"):
            out[key].append(value)
    return out


def gamemode_config() -> dict:
    """La config efectiva: se fusionan /usr/share, /etc y la del usuario (lo mismo que gamemoded)."""
    merged = {"desiredgov": None, "whitelist": [], "blacklist": []}
    for path in (*GAMEMODE_INI_SYSTEM, _config_home() / "gamemode.ini"):
        part = parse_gamemode_ini(_read(path))
        if part["desiredgov"]:
            merged["desiredgov"] = part["desiredgov"]
        for key in ("whitelist", "blacklist"):
            merged[key] += [v for v in part[key] if v not in merged[key]]
    return merged


def _in_gamemode_group():
    """True/False si el grupo existe y el usuario está (o no) en él; None si el grupo no existe."""
    if grp is None:
        return None
    try:
        gid = grp.getgrnam("gamemode").gr_gid
    except KeyError:
        return None
    return gid in os.getgroups() or os.getgid() == gid


def gamemode_status() -> dict:
    exe = shutil.which("gamemoded")
    cfg = gamemode_config()
    info = {
        "installed": bool(exe),
        "state": "missing",
        "in_group": _in_gamemode_group() if exe else None,
        "governor": _read(SYSFS_CPUFREQ / "scaling_governor") or NA,
        "driver": _read(SYSFS_CPUFREQ / "scaling_driver") or NA,
        "epp": _read(SYSFS_CPUFREQ / "energy_performance_preference") or NA,
        "target": cfg["desiredgov"] or "performance",
        "whitelist": cfg["whitelist"],
    }
    if exe:
        res = _run([exe, "-s"], 8)
        info["state"] = parse_gamemode_status(res[1]) if res else "unknown"
    return info


def gamemode_test() -> dict:
    """`gamemoded -t` (diagnóstico oficial): {"state": "missing"|"error"|"done", "passed", "failed", "output"}."""
    exe = shutil.which("gamemoded")
    if not exe:
        return {"state": "missing"}
    res = _run([exe, "-t"], GAMEMODE_TEST_TIMEOUT)
    if res is None:
        return {"state": "error"}
    code, output = res
    passed = len(re.findall(r":: Passed", output))
    failed = len(re.findall(r":: Failed", output))
    tail = "\n".join(output.strip().splitlines()[-12:])
    if not passed and not failed:
        return {"state": "error", "output": tail}
    return {"state": "done", "passed": passed, "failed": failed + (1 if code and not failed else 0), "output": tail}


# ── MangoHud ───────────────────────────────────────────────────────────────
def _line_key(line: str) -> str:
    return line.partition("=")[0].strip()


def profile_text(profile_id: str) -> str:
    lines = [f"# AvalOS — MangoHud, perfil: {profile_id}",
             "# Lo genera avalos-gamecenter; si lo editas, el perfil pasa a ser «tu configuración».",
             *[f"{k}={v}" for k, v in MANGO_STYLE.items()], *MANGO_PROFILES[profile_id]]
    return "\n".join(lines) + "\n"


def _effective_lines(text: str) -> frozenset:
    return frozenset(ln.strip() for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#"))


def mangohud_dir() -> Path:
    return _config_home() / "MangoHud"


def active_profile() -> str:
    """minimal/standard/full/hidden si MangoHud.conf es uno de los perfiles, custom si es otra cosa
    y none si todavía no hay archivo (MangoHud usa su aspecto de fábrica)."""
    conf = mangohud_dir() / MANGO_CONF
    if not conf.is_file():
        return "none"
    current = _effective_lines(_read(conf))
    for pid in MANGO_ORDER:
        if current == _effective_lines(profile_text(pid)):
            return pid
    return "custom"


def mangohud_status() -> dict:
    return {"installed": bool(shutil.which("mangohud")), "active": active_profile(),
            "has_backup": (mangohud_dir() / MANGO_BACKUP).is_file(), "profiles": list(MANGO_ORDER)}


def _write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def apply_profile(profile_id) -> dict:
    """Escribe los 4 perfiles en profiles/ (para MANGOHUD_CONFIGFILE) y deja el elegido como
    MangoHud.conf. Si el usuario tenía una config propia, se guarda UNA vez como respaldo (no se
    pisa un respaldo anterior: es la original). Devuelve el estado nuevo o {"error": ...}."""
    if profile_id not in MANGO_PROFILES:
        return {"error": "profile"}
    try:
        folder = mangohud_dir()
        for pid in MANGO_ORDER:
            _write_atomic(folder / "profiles" / f"{pid}.conf", profile_text(pid))
        conf, backup = folder / MANGO_CONF, folder / MANGO_BACKUP
        if conf.is_file() and active_profile() == "custom" and not backup.exists():
            shutil.copy2(conf, backup)
        _write_atomic(conf, profile_text(profile_id))
    except OSError:
        return {"error": "write"}
    return mangohud_status()


def restore_backup() -> dict:
    backup, conf = mangohud_dir() / MANGO_BACKUP, mangohud_dir() / MANGO_CONF
    try:
        _write_atomic(conf, backup.read_text(encoding="utf-8"))
    except OSError:
        return {"error": "restore"}
    return mangohud_status()


# ── Opciones de lanzamiento ────────────────────────────────────────────────
def launch_options(profile_id="standard") -> dict:
    """Las cadenas para pegar en Steam/Lutris. El perfil va por MANGOHUD_CONFIGFILE (así cada juego
    elige el suyo sin tocar el global). ${XDG_CONFIG_HOME:-$HOME/.config} lo expande el shell de Steam."""
    if profile_id not in MANGO_PROFILES:
        profile_id = "standard"
    cfg = f"${{XDG_CONFIG_HOME:-$HOME/.config}}/MangoHud/profiles/{profile_id}.conf"
    return {
        "gamemode": "gamemoderun %command%",
        "mangohud": "mangohud %command%",
        "both": "mangohud gamemoderun %command%",
        "profile": f"MANGOHUD_CONFIGFILE={cfg} mangohud gamemoderun %command%",
    }


def copy_to_clipboard(text: str) -> bool:
    exe = shutil.which("wl-copy")
    if not exe:
        return False
    try:
        subprocess.run([exe], input=text, text=True, timeout=5, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return False
    return True


# ── Proton y herramientas de compatibilidad ────────────────────────────────
def _natural_key(name: str):
    return [int(p) if p.isdigit() else p.lower() for p in re.split(r"(\d+)", name)]


def proton_tools() -> list:
    """Nombres de las herramientas de compatibilidad de Steam (GE-Proton...) y de los Proton oficiales
    que Steam descargó, los más nuevos primero. Solo lectura."""
    found = set()
    for folder in (_data_home() / "Steam" / "compatibilitytools.d", Path.home() / ".steam" / "root" / "compatibilitytools.d",
                   STEAM_SYSTEM_TOOLS):
        try:
            found.update(p.name for p in folder.iterdir() if p.is_dir())
        except OSError:
            pass
    try:
        found.update(p.name for p in (_data_home() / "Steam" / "steamapps" / "common").iterdir()
                     if p.is_dir() and p.name.startswith("Proton"))
    except OSError:
        pass
    return sorted(found, key=_natural_key, reverse=True)[:MAX_TOOLS]


# ── Gráficos y pantallas ───────────────────────────────────────────────────
_GPU_VENDORS = {"0x1002": "AMD", "0x8086": "Intel", "0x10de": "NVIDIA"}


def gpus() -> list:
    out = []
    try:
        cards = sorted(p for p in SYSFS_DRM.iterdir() if re.fullmatch(r"card\d+", p.name))
    except OSError:
        return out
    for card in cards:
        vendor = _GPU_VENDORS.get(_read(card / "device" / "vendor").lower())
        driver = next((ln.partition("=")[2] for ln in _read(card / "device" / "uevent").splitlines()
                       if ln.startswith("DRIVER=")), "")
        label = " · ".join(x for x in (vendor, driver) if x)
        if label and label not in out:
            out.append(label)
    return out


def parse_monitors(raw: str) -> list:
    """`hyprctl -j monitors` -> [{"name", "mode", "vrr"}]. Lo que falte se omite, nunca se inventa."""
    try:
        data = json.loads(raw)
    except ValueError:
        return []
    out = []
    for m in data if isinstance(data, list) else []:
        if not isinstance(m, dict) or not m.get("name"):
            continue
        mode = ""
        if isinstance(m.get("width"), int) and isinstance(m.get("height"), int):
            mode = f"{m['width']}×{m['height']}"
            if isinstance(m.get("refreshRate"), (int, float)):
                mode += f" @ {m['refreshRate']:.0f} Hz"
        vrr = m.get("vrr") if isinstance(m.get("vrr"), bool) else None
        out.append({"name": str(m["name"]), "mode": mode, "vrr": vrr})
    return out


def monitors() -> list:
    exe = shutil.which("hyprctl")
    if not exe or not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return []
    res = _run([exe, "-j", "monitors"], 4)
    return parse_monitors(res[1]) if res and res[0] == 0 else []


# ── Todo junto ─────────────────────────────────────────────────────────────
def snapshot() -> dict:
    return {
        "launchers": launchers_available(),
        "gamemode": gamemode_status(),
        "mango": mangohud_status(),
        "tools": proton_tools(),
        "system": {"gpus": gpus(), "monitors": monitors()},
    }


class GameAPI:
    window = None

    def snapshot(self):
        return snapshot()

    def open_launcher(self, launcher_id):
        argv = resolve_launcher(launcher_id) if isinstance(launcher_id, str) else None
        return bool(argv) and _spawn(argv)

    def open_store(self):
        return bool(shutil.which("avalos-store")) and _spawn(["avalos-store"])

    def gamemode_test(self):
        return gamemode_test()

    def mango_apply(self, profile_id):
        return apply_profile(profile_id) if isinstance(profile_id, str) else {"error": "profile"}

    def mango_restore(self):
        return restore_backup()

    def launch_options(self, profile_id="standard"):
        return launch_options(profile_id if isinstance(profile_id, str) else "standard")

    def copy_options(self, variant, profile_id="standard"):
        text = launch_options(profile_id if isinstance(profile_id, str) else "standard").get(variant) \
            if isinstance(variant, str) else None
        return {"ok": bool(text) and copy_to_clipboard(text), "text": text or ""}

    def close(self):
        if self.window:
            self.window.destroy()


