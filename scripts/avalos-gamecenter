const S = STRINGS_PLACEHOLDER;
const LAUNCHERS = LAUNCHERS_PLACEHOLDER;
const PROFILES = PROFILES_PLACEHOLDER;
const VARIANTS = VARIANTS_PLACEHOLDER;
const $ = (id) => document.getElementById(id);

let snap = null;
let optionsProfile = 'standard';
let optionTexts = {};

function mk(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}
function api() { return (window.pywebview && window.pywebview.api) || null; }
function fmt(s, vars) { let o = s; Object.keys(vars).forEach((k) => { o = o.split('{' + k + '}').join(vars[k]); }); return o; }

function toast(msg) {
  const t = $('toast');
  t.textContent = msg;
  t.classList.remove('hidden');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => t.classList.add('hidden'), 4500);
}

function setTitle(text) {
  const h = $('title');
  h.textContent = '';
  const i = text.indexOf('AvalOS');
  if (i < 0) { h.textContent = text; return; }
  h.appendChild(document.createTextNode(text.slice(0, i)));
  h.appendChild(mk('span', 'accent', 'AvalOS'));
  h.appendChild(document.createTextNode(text.slice(i + 'AvalOS'.length)));
}

function section(parent, key) { parent.appendChild(mk('h2', '', S[key])); }
function fact(k, v) {
  const f = mk('div', 'fact');
  f.appendChild(mk('div', 'k', k));
  f.appendChild(mk('div', 'v', v || '—'));
  return f;
}

async function call(name, ...args) {
  const a = api();
  if (!a) return null;
  try { return await a[name](...args); } catch (e) { return null; }
}

/* ── Lanzadores ─────────────────────────────────────────── */
function renderLaunchers(box) {
  section(box, 'h-launchers');
  const grid = mk('div', 'grid');
  LAUNCHERS.forEach(([id, name, icon]) => {
    const on = snap.launchers[id] === true;
    const b = mk('button', 'tile');
    b.type = 'button';
    b.disabled = !on;
    b.dataset.launcher = id;
    b.appendChild(mk('span', 'ic', icon));
    const info = mk('span', 'info');
    info.appendChild(mk('div', 't', name));
    info.appendChild(mk('div', 'd', on ? S['d-' + id] : S['l-missing']));
    b.appendChild(info);
    b.addEventListener('click', async () => {
      const ok = await call('open_launcher', id);
      if (!ok) toast(S['l-missing']);
    });
    grid.appendChild(b);
  });
  box.appendChild(grid);
  const store = mk('button', 'btn', S['l-store']);
  store.type = 'button';
  store.id = 'store-btn';
  store.style.marginTop = '8px';
  store.addEventListener('click', () => call('open_store'));
  box.appendChild(store);
}

/* ── GameMode ───────────────────────────────────────────── */
function renderGamemode(box) {
  section(box, 'h-gamemode');
  const g = snap.gamemode;
  const card = mk('div', 'card');
  const top = mk('div', 'row');
  const st = mk('div', 'status');
  st.appendChild(mk('span', 'dot ' + g.state));
  st.appendChild(document.createTextNode(S['gm-' + (g.state === 'missing' ? 'missing' : g.state === 'active' ? 'active' : g.state === 'idle' ? 'idle' : 'unknown')]));
  top.appendChild(st);
  if (g.installed) {
    const btn = mk('button', 'btn', S['gm-test']);
    btn.type = 'button';
    btn.id = 'gm-test-btn';
    btn.addEventListener('click', runGamemodeTest);
    top.appendChild(btn);
  }
  card.appendChild(top);
  if (g.installed) {
    const facts = mk('div', 'facts');
    facts.appendChild(fact(S['gm-governor'], g.governor));
    facts.appendChild(fact(S['gm-target'], g.target));
    facts.appendChild(fact(S['gm-driver'], g.driver));
    facts.appendChild(fact(S['gm-epp'], g.epp));
    if (g.whitelist.length) facts.appendChild(fact(S['gm-works'], g.whitelist.join(', ')));
    card.appendChild(facts);
    const grp = g.in_group === true ? ['gm-group-ok', 'ok'] : g.in_group === false ? ['gm-group-no', 'warn'] : ['gm-group-na', 'warn'];
    card.appendChild(mk('div', 'note ' + grp[1], S[grp[0]]));
    card.appendChild(mk('div', 'note', S['gm-test-note']));
    const res = mk('div', 'hidden');
    res.id = 'gm-test-res';
    card.appendChild(res);
  }
  box.appendChild(card);
}

async function runGamemodeTest() {
  const btn = $('gm-test-btn');
  const res = $('gm-test-res');
  btn.disabled = true;
  btn.textContent = S['gm-testing'];
  const r = (await call('gamemode_test')) || { state: 'error' };
  btn.disabled = false;
  btn.textContent = S['gm-test'];
  res.textContent = '';
  res.className = '';
  let cls = 'bad';
  let msg = S['gm-test-err'];
  if (r.state === 'done') {
    if (r.failed === 0) { cls = 'ok'; msg = fmt(S['gm-test-ok'], { n: r.passed }); }
    else { msg = fmt(S['gm-test-fail'], { n: r.failed }); }
  }
  res.appendChild(mk('div', 'note ' + cls, msg));
  if (r.output && cls === 'bad') res.appendChild(mk('pre', 'out', r.output));
}

/* ── MangoHud ───────────────────────────────────────────── */
function renderMango(box) {
  section(box, 'h-mango');
  const m = snap.mango;
  const card = mk('div', 'card');
  if (!m.installed) {
    card.appendChild(mk('div', 'dim', S['mg-missing']));
    box.appendChild(card);
    return;
  }
  card.appendChild(mk('div', 'dim', S['mg-desc']));
  const stateName = m.active === 'none' ? S['mg-none'] : m.active === 'custom' ? S['mg-custom'] : S['mp-' + m.active];
  const state = mk('div', 'note');
  state.id = 'mg-state';
  state.textContent = S['mg-state'] + ' ' + stateName;
  card.appendChild(state);
  const grid = mk('div', 'profiles');
  PROFILES.forEach((id) => {
    const p = mk('div', 'profile' + (m.active === id ? ' on' : ''));
    p.dataset.profile = id;
    p.appendChild(mk('div', 't', S['mp-' + id]));
    p.appendChild(mk('div', 'dim', S['mpd-' + id]));
    const b = mk('button', 'btn', m.active === id ? S['mg-current'] : S['mg-use']);
    b.type = 'button';
    b.disabled = m.active === id;
    b.addEventListener('click', () => applyProfile(id));
    p.appendChild(b);
    grid.appendChild(p);
  });
  card.appendChild(grid);
  if (m.has_backup) {
    const row = mk('div', 'row top');
    row.style.marginTop = '10px';
    row.appendChild(mk('div', 'note', S['mg-backup']));
    const rb = mk('button', 'btn', S['mg-restore']);
    rb.type = 'button';
    rb.id = 'mg-restore-btn';
    rb.addEventListener('click', restoreBackup);
    row.appendChild(rb);
    card.appendChild(row);
  }
  box.appendChild(card);
}

async function applyProfile(id) {
  const r = await call('mango_apply', id);
  if (!r || r.error) { toast(S['mg-err']); return; }
  snap.mango = r;
  toast(fmt(S['mg-applied'], { name: S['mp-' + id] }));
  if (optionsProfile !== id) { optionsProfile = id; await loadOptions(); }
  render();
}

async function restoreBackup() {
  const r = await call('mango_restore');
  if (!r || r.error) { toast(S['mg-err']); return; }
  snap.mango = r;
  toast(S['mg-restored']);
  render();
}

/* ── Opciones de lanzamiento ────────────────────────────── */
async function loadOptions() {
  optionTexts = (await call('launch_options', optionsProfile)) || {};
}

function renderOptions(box) {
  section(box, 'h-options');
  const card = mk('div', 'card');
  card.appendChild(mk('div', 'dim', S['lo-desc']));
  const pick = mk('div', 'opt');
  pick.style.marginTop = '10px';
  pick.appendChild(mk('span', 'lbl', S['lo-profile-label']));
  const sel = mk('select');
  sel.id = 'lo-profile';
  PROFILES.forEach((id) => {
    const o = mk('option', '', S['mp-' + id]);
    o.value = id;
    if (id === optionsProfile) o.selected = true;
    sel.appendChild(o);
  });
  sel.addEventListener('change', async () => { optionsProfile = sel.value; await loadOptions(); render(); });
  pick.appendChild(sel);
  card.appendChild(pick);
  const list = mk('div', 'opts');
  VARIANTS.forEach((v) => {
    const row = mk('div', 'opt');
    row.dataset.variant = v;
    row.appendChild(mk('span', 'lbl', S['lo-' + v]));
    row.appendChild(mk('code', '', optionTexts[v] || '—'));
    const b = mk('button', 'btn', S['lo-copy']);
    b.type = 'button';
    b.addEventListener('click', async () => {
      const r = await call('copy_options', v, optionsProfile);
      toast(r && r.ok ? S['lo-copied'] : S['lo-copy-failed']);
    });
    row.appendChild(b);
    list.appendChild(row);
  });
  card.appendChild(list);
  box.appendChild(card);
}

/* ── Proton ─────────────────────────────────────────────── */
function renderTools(box) {
  section(box, 'h-tools');
  const card = mk('div', 'card');
  if (!snap.tools.length) {
    card.appendChild(mk('div', 'dim', S['pt-none']));
  } else {
    card.appendChild(mk('div', 'dim', fmt(S['pt-count'], { n: snap.tools.length })));
    const chips = mk('div', 'chips');
    snap.tools.forEach((t) => chips.appendChild(mk('span', 'chip', t)));
    card.appendChild(chips);
  }
  card.appendChild(mk('div', 'note', S['pt-hint']));
  box.appendChild(card);
}

/* ── Gráficos y pantallas ───────────────────────────────── */
function renderSystem(box) {
  section(box, 'h-system');
  const card = mk('div', 'card');
  const facts = mk('div', 'facts');
  facts.appendChild(fact(S['sy-gpu'], snap.system.gpus.length ? snap.system.gpus.join(', ') : S['sy-none']));
  if (snap.system.monitors.length) {
    snap.system.monitors.forEach((m) => {
      const vrr = m.vrr === true ? ' · ' + S['sy-vrr-on'] : m.vrr === false ? ' · ' + S['sy-vrr-off'] : '';
      facts.appendChild(fact(m.name, (m.mode || '—') + vrr));
    });
  } else {
    facts.appendChild(fact(S['sy-displays'], S['sy-none']));
  }
  card.appendChild(facts);
  box.appendChild(card);
}

function render() {
  const box = $('content');
  box.textContent = '';
  renderLaunchers(box);
  renderGamemode(box);
  renderMango(box);
  renderOptions(box);
  renderTools(box);
  renderSystem(box);
  $('loading').classList.add('hidden');
  box.classList.remove('hidden');
}

function closeWin() { const a = api(); if (a) a.close(); }

setTitle(S.title);
$('subtitle').textContent = S.subtitle;
$('loading').textContent = S.loading;
$('note').textContent = S.note;
$('b-close').textContent = S['b-close'];
$('b-close').addEventListener('click', closeWin);
document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeWin(); });

async function ready() {
  const s = await call('snapshot');
  if (!s) return;
  snap = s;
  if (PROFILES.indexOf(snap.mango.active) !== -1) optionsProfile = snap.mango.active;
  await loadOptions();
  render();
}
window.addEventListener('pywebviewready', ready);
</script>
</body>
</html>"""


def _js(obj) -> str:
    # Va dentro de un <script>: que un "</" nunca cierre la etiqueta antes de tiempo.
    return json.dumps(obj, ensure_ascii=False).replace("</", "<\\/")


def _render_html(lang: str) -> str:
    return (_build_html()
            .replace("LANG_PLACEHOLDER", _HTML_LANG.get(lang, lang))
            .replace("STRINGS_PLACEHOLDER", _js(STRINGS[lang]))
            .replace("LAUNCHERS_PLACEHOLDER", _js([[lid, name, icon] for lid, name, _c, icon in LAUNCHERS]))
            .replace("PROFILES_PLACEHOLDER", _js(list(MANGO_ORDER)))
            .replace("VARIANTS_PLACEHOLDER", _js(list(LAUNCH_VARIANTS))))


def _gui():
    import webview  # solo la ventana lo necesita
    T = STRINGS[LANG]
    html = _render_html(LANG)

    # Mismo fix que las demás apps: sin esto GTK usa "python3" como app_id en Wayland y
    # la window rule (class = "avalos-gamecenter") nunca matchea.
    try:
        from gi.repository import GLib
        GLib.set_prgname("avalos-gamecenter")
    except Exception:
        pass

    api = GameAPI()
    win = webview.create_window(
        title            = T["title"],
        html             = html,
        js_api           = api,
        width            = 940,
        height           = 700,
        min_size         = (640, 480),
        resizable        = True,
        background_color = "#1a1b26",
    )
    api.window = win
    try:
        webview.start(debug=False)
    except Exception as e:  # noqa: BLE001
        print(f"ERROR al iniciar pywebview: {e}", file=sys.stderr)
        return 1
    return 0


def main(argv=None):
    global LANG
    ap = argparse.ArgumentParser(prog="avalos-gamecenter", description="AvalOS Game Center: launchers, GameMode, MangoHud and launch options in one window.")
    ap.add_argument("--json", action="store_true", help="print what the Game Center sees, then exit")
    ap.add_argument("--lang", choices=_SUPPORTED, help="language of the window")
    a = ap.parse_args(argv)
    if a.lang:
        LANG = a.lang
    if a.json:
        print(json.dumps(snapshot(), ensure_ascii=False, indent=2))
        return 0
    if not _has_display():
        print("avalos-gamecenter: no graphical session found (WAYLAND_DISPLAY/DISPLAY)", file=sys.stderr)
        return 1
    return _gui()


if __name__ == "__main__":
    sys.exit(main())
