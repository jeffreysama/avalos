<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">

<!--
  AvalOS — avalos-store
  ───────────────────────────────────────────────────────────────
  avalos-store (la GUI, corriendo SIN privilegios) instala/desinstala las apps de pacman del catálogo
  llamando a "pkexec /usr/local/bin/avalos-store-helper install|uninstall <id-de-app>".
  hyprpolkitagent ya corre en el sistema instalado (exec-once de hyprland.lua) — no hace falta instalar ni
  configurar nada más para que el diálogo gráfico de autenticación aparezca.

  QUÉ CAMBIÓ Y POR QUÉ. Antes estas dos acciones autorizaban "/usr/bin/pacman" con argv1=-S / -R. pkexec NO
  valida el resto de los argumentos (pkexec(1): "pkexec does no validation of the ARGUMENTS passed to
  PROGRAM"), así que mientras la autenticación seguía en caché (auth_admin_keep, como la de sudo) cualquier
  proceso del mismo usuario podía ejecutar, sin contraseña y como root, p. ej.
      pkexec pacman -S <opción que apunta a un pacman.conf del usuario> algo   (XferCommand = lo que sea)
  Ahora las acciones solo autorizan avalos-store-helper, y ese script solo acepta un ID del catálogo (que lee
  de un archivo de root) y corre pacman con una línea de comandos fija: nada de nombres de paquete ni opciones
  que vengan de afuera. Una acción por argv1 (install / uninstall) para conservar el texto de cada diálogo.

  Mezcla de versiones (los sistemas ya instalados reciben esta policy y la GUI por `sync-system-files`, pero
  el helper nuevo solo llega con una ISO nueva o copiándolo a mano, igual que avalos-update-helper):
    · GUI nueva + helper ausente → la GUI cae a "pkexec /usr/bin/pacman -S …", que ya no coincide con ninguna
      acción de AvalOS y usa la genérica de pkexec: funciona, pero pide contraseña cada vez (sin memoria).
    · helper presente + policy vieja → pkexec usa la acción genérica: también pide contraseña cada vez.

  allow_active=auth_admin_keep: pide contraseña de admin la primera vez y la recuerda un rato (como sudo),
  para no pedirla de nuevo entre instalar/desinstalar varias apps seguidas en la misma sesión de la Store.
  Con el helper, lo que esa memoria autoriza ya no es «pacman con cualquier argumento» sino «instalar o
  quitar apps del catálogo».
  allow_inactive/allow_any=no: nunca autoriza desde una sesión inactiva o remota — solo con sesión gráfica
  activa al frente.
-->
<policyconfig>
  <vendor>AvalOS</vendor>
  <vendor_url>https://github.com/jeffreysama/avalos</vendor_url>
  <icon_name>system-software-install</icon_name>

  <action id="com.avalos.store.install">
    <description>Instalar aplicaciones con AvalOS Store</description>
    <description xml:lang="en">Install applications with AvalOS Store</description>
    <description xml:lang="es">Instalar aplicaciones con AvalOS Store</description>
    <description xml:lang="zh">使用 AvalOS Store 安装应用程序</description>
    <description xml:lang="ja">AvalOS Store でアプリをインストール</description>

    <message>Se requiere autenticación para instalar una aplicación</message>
    <message xml:lang="en">Authentication is required to install an application</message>
    <message xml:lang="es">Se requiere autenticación para instalar una aplicación</message>
    <message xml:lang="zh">安装应用程序需要身份验证</message>
    <message xml:lang="ja">アプリをインストールするには認証が必要です</message>

    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/avalos-store-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <action id="com.avalos.store.uninstall">
    <description>Desinstalar aplicaciones con AvalOS Store</description>
    <description xml:lang="en">Uninstall applications with AvalOS Store</description>
    <description xml:lang="es">Desinstalar aplicaciones con AvalOS Store</description>
    <description xml:lang="zh">使用 AvalOS Store 卸载应用程序</description>
    <description xml:lang="ja">AvalOS Store でアプリをアンインストール</description>

    <message>Se requiere autenticación para desinstalar una aplicación</message>
    <message xml:lang="en">Authentication is required to uninstall an application</message>
    <message xml:lang="es">Se requiere autenticación para desinstalar una aplicación</message>
    <message xml:lang="zh">卸载应用程序需要身份验证</message>
    <message xml:lang="ja">アプリをアンインストールするには認証が必要です</message>

    <icon_name>edit-delete</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/avalos-store-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">uninstall</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
