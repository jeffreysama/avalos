font=JetBrainsMono Nerd Font 11
background-color=#24283bff
text-color=#c0caf5ff
border-color=#7aa2f7ff
border-size=1
border-radius=8
width=340
height=200
margin=10
padding=10,12
icons=1
max-icon-size=48
markup=1
actions=1
default-timeout=8000
sort=-time
max-visible=5
layer=overlay
anchor=top-right

[urgency=low]
background-color=#1a1b26ff
text-color=#565f89ff
border-color=#414868ff
default-timeout=5000

[urgency=normal]
background-color=#24283bff
text-color=#c0caf5ff
border-color=#7aa2f7ff
default-timeout=8000

[urgency=high]
background-color=#1a1b26ff
text-color=#f7768eff
border-color=#f7768eff
default-timeout=0
on-notify=exec paplay /usr/share/sounds/freedesktop/stereo/bell.oga 2>/dev/null || true
