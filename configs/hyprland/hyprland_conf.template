# ── AvalOS hyprland.conf ─────────────────────────────────────────
# Este archivo es un template — el instalador reemplaza los marcadores
# %%GPU_ENV%%, %%KEYMAP%% y %%USERNAME%% con los valores correctos
# según la GPU detectada y las preferencias elegidas por el usuario.

monitor = ,preferred,auto,1

# ── Variables de entorno base ─────────────────────────────────────
env = XCURSOR_SIZE,24
env = XCURSOR_THEME,capitaine-cursors-dark
# BUG-1 FIX: QT_QPA_PLATFORM usaba punto y coma como separador.
# El punto y coma es un metacaracter de shell; algunos entornos y
# herramientas que leen /etc/environment o las env de Hyprland lo
# interpretan incorrectamente y Qt apps fallan al iniciar.
# El separador correcto para esta variable es la coma.
env = QT_QPA_PLATFORM,wayland,xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = GDK_BACKEND,wayland,x11
env = MOZ_ENABLE_WAYLAND,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto
# BUG-2 FIX: __GLX_VENDOR_LIBRARY_NAME=mesa se movió ANTES de %%GPU_ENV%%.
# Si el instalador reemplaza %%GPU_ENV%% con variables AMD que sobreescriben
# __GLX_VENDOR_LIBRARY_NAME, el orden original causaba que la variable AMD
# quedara debajo de mesa y se ignorara (las env en Hyprland se aplican en
# orden, la última gana). Mesa como base, GPU_ENV la sobreescribe si AMD.
env = __GLX_VENDOR_LIBRARY_NAME,mesa
%%GPU_ENV%%
# Detección dinámica de GPU al inicio (avalos-gpu-detect.service la genera)
source = /etc/hypr/gpu-env.conf

# ── Autostart ────────────────────────────────────────────────────
# BUG-3 FIX: hyprpaper antes que waybar — si waybar arranca primero
# e intenta acceder al wallpaper, falla con error de socket no disponible.
exec-once = hyprpaper
exec-once = waybar
exec-once = mako
exec-once = hypridle
exec-once = nm-applet --indicator
exec-once = blueman-applet
exec-once = hyprpolkitagent
exec-once = wl-paste --type text  --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
exec-once = xdg-user-dirs-update
exec-once = udiskie -t

general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    col.active_border = rgba(7aa2f7ee) rgba(bb9af7ee) 45deg
    col.inactive_border = rgba(414868aa)
    layout = dwindle
    resize_on_border = true
    allow_tearing = false
}

decoration {
    rounding = 12
    active_opacity = 1.0
    inactive_opacity = 0.92
    blur {
        enabled = true
        size = 4
        passes = 1
    }
    shadow {
        enabled = true
        range = 12
        render_power = 2
        color = rgba(1a1b2660)
    }
}

animations {
    enabled = true
    bezier = myBezier, 0.08, 0.9, 0.1, 1.05
    animation = windows,    1, 6, myBezier
    animation = windowsOut, 1, 5, default, popin 75%
    animation = border,     1, 8, default
    animation = fade,       1, 6, default
    animation = workspaces, 1, 5, default, slide
}

dwindle {
    pseudotile = true
    preserve_split = true
}

input {
    # %%KEYMAP%% es reemplazado por el instalador con el layout elegido
    # (latam, us, cn, etc.). Si el instalador no lo reemplaza por algún
    # error, "us" es el fallback más seguro — todos los teclados lo soportan.
    kb_layout = %%KEYMAP%%
    # kb_options = grp:alt_shift_toggle  # habilitar si se añade segundo layout
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
        tap-to-click = true
    }
}

misc {
    force_default_wallpaper = 0
    vfr = true
    disable_hyprland_logo = true
    disable_splash_rendering = true
}

# ── Keybinds ──────────────────────────────────────────────────────
$mod = SUPER
bind = $mod, Return,       exec, kitty
bind = $mod, Space,        exec, rofi -show drun
bind = $mod, E,            exec, thunar
bind = $mod, B,            exec, firefox
bind = $mod SHIFT, B,      exec, chromium
bind = $mod SHIFT, S,      exec, grim -g "$(slurp)" - | wl-copy
bind = $mod, V,            exec, cliphist list | rofi -dmenu | cliphist decode | wl-copy
bind = $mod SHIFT, P,      exec, ~/.config/rofi/scripts/powermenu.sh
bind = $mod, Q,            killactive
bind = $mod, F,            fullscreen
bind = $mod, T,            togglefloating
# BUG-4 FIX: $mod SHIFT, E hacía "exit" (cierra Hyprland sin confirmación).
# Reemplazado por powermenu — exit sigue disponible dentro del powermenu.
# Si el script no existe, systemctl poweroff como último recurso.
bind = $mod SHIFT, E,      exec, ~/.config/rofi/scripts/powermenu.sh || systemctl poweroff
bind = $mod SHIFT, L,      exec, hyprlock
bind = , Print,             exec, grim ~/Pictures/screenshot_$(date +%Y%m%d_%H%M%S).png

# Foco con flechas y HJKL
bind = $mod, left,  movefocus, l
bind = $mod, right, movefocus, r
bind = $mod, up,    movefocus, u
bind = $mod, down,  movefocus, d
bind = $mod, H, movefocus, l
bind = $mod, L, movefocus, r
bind = $mod, K, movefocus, u
bind = $mod, J, movefocus, d

# Mover ventanas
bind = $mod SHIFT, left,  movewindow, l
bind = $mod SHIFT, right, movewindow, r
bind = $mod SHIFT, up,    movewindow, u
bind = $mod SHIFT, down,  movewindow, d

# BUG-5 FIX: resize con teclado ausente en el template.
# Sin esto no hay forma de redimensionar ventanas sin ratón.
binde = $mod CTRL, right, resizeactive,  30 0
binde = $mod CTRL, left,  resizeactive, -30 0
binde = $mod CTRL, up,    resizeactive,  0 -30
binde = $mod CTRL, down,  resizeactive,  0  30

# Workspaces
bind = $mod, 1, workspace, 1
bind = $mod, 2, workspace, 2
bind = $mod, 3, workspace, 3
bind = $mod, 4, workspace, 4
bind = $mod, 5, workspace, 5
bind = $mod, 6, workspace, 6
bind = $mod, 7, workspace, 7
bind = $mod, 8, workspace, 8
bind = $mod, 9, workspace, 9
bind = $mod SHIFT, 1, movetoworkspace, 1
bind = $mod SHIFT, 2, movetoworkspace, 2
bind = $mod SHIFT, 3, movetoworkspace, 3
bind = $mod SHIFT, 4, movetoworkspace, 4
bind = $mod SHIFT, 5, movetoworkspace, 5
bind = $mod SHIFT, 6, movetoworkspace, 6
bind = $mod SHIFT, 7, movetoworkspace, 7
bind = $mod SHIFT, 8, movetoworkspace, 8
bind = $mod SHIFT, 9, movetoworkspace, 9
bind = $mod, mouse_down, workspace, e+1
bind = $mod, mouse_up,   workspace, e-1
bind = $mod, Tab,       workspace, e+1
bind = $mod SHIFT, Tab, workspace, e-1

# Media y brillo
bindel = , XF86AudioRaiseVolume,  exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume,  exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl  = , XF86AudioMute,         exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl  = , XF86AudioPlay,         exec, playerctl play-pause
bindl  = , XF86AudioNext,         exec, playerctl next
bindl  = , XF86AudioPrev,         exec, playerctl previous
bindel = , XF86MonBrightnessUp,   exec, brightnessctl set +5%
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-

# ── Window rules ─────────────────────────────────────────────────
windowrulev2 = float,        class:(pavucontrol)
windowrulev2 = float,        class:(nm-connection-editor)
windowrulev2 = float,        class:(blueman-manager)
windowrulev2 = size 800 600, class:(pavucontrol)
# BUG-6 FIX: windowrule para thunar flotante al abrir desde keybind.
# Sin esto thunar entra en el layout dwindle y desplaza otras ventanas.
windowrulev2 = float,        class:(thunar)
windowrulev2 = size 900 600, class:(thunar)
# BUG-7 FIX: windowrule para el diálogo de autenticación de polkit.
# Sin float+center, el diálogo aparece en el layout y queda en una esquina.
windowrulev2 = float,  class:(hyprpolkitagent)
windowrulev2 = center, class:(hyprpolkitagent)
# BUG-8 FIX: windowrule para udiskie (montado automático de USB).
# udiskie --tray abre un diálogo de confirmación al insertar un USB;
# sin float aparece en el layout como ventana normal.
windowrulev2 = float,  class:(udiskie)
