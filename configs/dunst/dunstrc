[global]
    monitor = 0
    follow = none
    width = 340
    height = 120
    origin = top-right
    offset = 10x40
    notification_limit = 5
    progress_bar = true
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#414868"
    gap_size = 4
    sort = yes
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    corner_radius = 6
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1b26"
    foreground = "#565f89"
    timeout = 5

[urgency_normal]
    background = "#24283b"
    foreground = "#c0caf5"
    timeout = 8

[urgency_critical]
    background = "#1a0000"
    foreground = "#f7768e"
    timeout = 0
