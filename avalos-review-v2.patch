+def _cargar_manifest_hashes() -> dict[str, str] | None:
+    """Baja y parsea configs/MANIFEST.sha256 (formato de `sha256sum`: '<hash>  <ruta>'
+    por línea, generado por scripts/gen-sync-manifest.py). None si no se pudo bajar
+    o el formato no es el esperado — cmd_sync_system_files trata eso como fallo
+    CERRADO (no sincroniza nada), nunca como "confiar sin verificar"."""
+    try:
+        with urllib.request.urlopen(f"{REPO_RAW}/configs/MANIFEST.sha256", timeout=15) as resp:
+            if resp.status != 200:
+                return None
+            texto = resp.read().decode("utf-8")
+    except Exception:
+        return None
+    hashes: dict[str, str] = {}
+    for linea in texto.splitlines():
+        linea = linea.strip()
+        if not linea or linea.startswith("#"):
+            continue
+        partes = linea.split(None, 1)
+        if len(partes) != 2 or len(partes[0]) != 64:
+            return None  # línea con formato inesperado — manifiesto no confiable, fail closed
+        hashes[partes[1].strip()] = partes[0].lower()
+    return hashes or None
+
+
+def _verificar_contra_manifest(src_rel: str, contenido: bytes, hashes: dict[str, str]) -> str | None:
+    """None si `contenido` coincide con el hash de `src_rel` en el manifiesto; si no,
+    el motivo (para el log). Un archivo que el manifiesto no lista cuenta como NO
+    verificado — nunca se escribe."""
+    esperado = hashes.get(src_rel)
+    if esperado is None:
+        return f"{src_rel} no está listado en MANIFEST.sha256"
+    real = hashlib.sha256(contenido).hexdigest()
+    if real != esperado:
+        return f"{src_rel} no coincide con MANIFEST.sha256 (esperado {esperado[:12]}…, bajado {real[:12]}…)"
+    return None
+
